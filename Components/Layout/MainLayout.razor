@inherits LayoutComponentBase
@using ClothingStore.Application.Services
@inject MauiAdminGateway Gateway
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@inject ThemeService Theme
@inject StoreBrandStateService BrandState
@inject GoogleCloudSyncService CloudSync
@inject AppUpdateService UpdateService
@implements IDisposable

<div class="@Theme.CurrentThemeClass">
    <StoreDesignStyleInjector Design="@BrandState.EffectiveDesign" />
    @if (!Gateway.IsAuthenticated && !IsPublicCatalogRoute())
    {
        <div class="adm-login-wrapper">
            <div class="adm-login-container">
                <appmaui.blazor.Components.Pages.Login />
            </div>
        </div>
    }
    else if (IsPublicCatalogRoute())
    {
        <main class="adm-public-main">
            @Body
        </main>
    }
    else
    {
        <div class="adm-shell">
            <aside class="adm-sidebar">
                <div class="adm-brand">
                    <div class="adm-brand-top">
                        <img src="images/youlink-mark.svg" alt="YouLink" class="adm-brand-mark" />
                        <span class="adm-brand-wordmark">YouLink</span>
                    </div>
                    <div class="adm-brand-store-name">@_storeName.ToUpperInvariant()</div>
                    <div class="adm-brand-slug" title="/loja/@_storeSlug">/loja/@_storeSlug</div>
                </div>

                <NavMenu OnOpenProfile="OpenUserProfileModal" OnLogoutRequested="HandleLogout" />
            </aside>

            <div class="adm-main">
                <header class="adm-topbar">
                    <div class="adm-topbar-meta" style="display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap;">
                        <span class="pill-badge @(BrandState.IsSiteActive ? "pill-green" : "pill-red")">
                            @(BrandState.IsSiteActive ? "● Loja Aberta" : "● Loja Pausada")
                        </span>
                        <a href="/planos"
                           style="text-decoration: none;"
                           title="Ver planos e versões do site"
                           class="pill-badge @(BrandState.IsPremiumPlan ? "pill-gold" : BrandState.IsIntermediatePlan ? "pill-green" : "pill-slate")">
                            @(BrandState.IsPremiumPlan ? "✦ Premium" : BrandState.IsIntermediatePlan ? "◈ Meia Versão (3 Temas)" : BrandState.IsBasicPlan ? "● Plano Básico" : BrandState.IsPlanExpired ? "⚠ Plano Expirado" : "Sem Plano Ativo")
                        </a>
                        <strong class="adm-topbar-title adm-topbar-mobile-only">@_storeName</strong>
                    </div>

                    <div class="adm-topbar-actions" style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        @if (UpdateService.AvailableRelease?.IsUpdateAvailable == true)
                        {
                            <button type="button"
                                    class="adm-btn adm-btn-accent"
                                    style="padding: 0.42rem 0.78rem; min-height: 38px; font-size: 0.84rem;"
                                    title="Há uma atualização pronta para baixar e instalar pelo app"
                                    @onclick="UpdateService.OpenPopup">
                                ⬆️ Atualizar v@(UpdateService.AvailableRelease.LatestVersion)
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="adm-btn adm-btn-outline adm-topbar-hide-sm"
                                    style="padding: 0.38rem 0.65rem; min-height: 38px; font-size: 0.8rem; color: var(--adm-muted);"
                                    title="Verificar atualizações do aplicativo"
                                    disabled="@UpdateService.IsChecking"
                                    @onclick="CheckUpdatesManuallyFromTopbarAsync">
                                @(UpdateService.IsChecking ? "⏳" : "v" + UpdateService.CurrentVersion)
                            </button>
                        }

                        <!-- Botão Alternador Rápido de Tema Claro / Escuro (visível no mobile; no Windows também fica no menu lateral) -->
                        <button type="button"
                                class="adm-btn adm-btn-outline adm-topbar-mobile-only"
                                style="padding: 0.4rem 0.68rem; min-height: 38px; font-size: 0.84rem;"
                                title="@($"Tema atual: {Theme.ThemeDisplayName}. Toque para alternar.")"
                                @onclick="Theme.ToggleTheme">
                            @(Theme.IsDarkMode ? "☀️" : "🌙")<span class="adm-topbar-hide-xs"> @(Theme.IsDarkMode ? "Claro" : "Escuro")</span>
                        </button>

                        <a href="/loja/@_storeSlug"
                           class="adm-btn adm-btn-outline"
                           style="padding: 0.42rem 0.85rem; min-height: 38px; font-size: 0.86rem;">
                            🌐 <span class="adm-topbar-hide-xs">Ver </span>Loja
                        </a>

                        <!-- Botão de Perfil do Usuário & Segurança (2FA) -->
                        <button type="button"
                                class="adm-btn adm-btn-outline"
                                style="padding: 0.36rem 0.7rem; min-height: 38px; font-size: 0.84rem; display: flex; align-items: center; gap: 0.45rem;"
                                title="Minha Conta: E-mail, Senha, 2FA e Sair"
                                @onclick="() => _showUserProfileModal = true">
                            <span style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: var(--adm-primary); color: #fff; font-size: 0.74rem; font-weight: 800;">
                                @GetUserInitials(Gateway.CurrentEmployee?.FullName)
                            </span>
                            <span class="adm-topbar-hide-xs" style="max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @(Gateway.CurrentEmployee?.FullName ?? "Minha Conta")
                            </span>
                        </button>
                    </div>
                </header>

                @if (!string.IsNullOrWhiteSpace(Gateway.LatestRemoteConfig?.GlobalAnnouncementBanner) && !_dismissedRemoteBanner)
                {
                    var remoteKind = Gateway.LatestRemoteConfig!.GlobalAnnouncementKind;
                    var bgTint = remoteKind == "warning"
                        ? "rgba(217, 119, 6, 0.14)"
                        : remoteKind == "success"
                            ? "rgba(22, 163, 74, 0.14)"
                            : "color-mix(in srgb, var(--adm-primary) 10%, var(--adm-surface))";
                    <div class="adm-compat-banner" role="status" aria-live="polite" style="display: flex; align-items: center; justify-content: space-between; gap: 0.65rem; flex-wrap: wrap; padding: 0.55rem 1rem; background: @bgTint; border-bottom: 1px solid var(--adm-border); font-size: 0.82rem;">
                        <span>📢 @Gateway.LatestRemoteConfig.GlobalAnnouncementBanner</span>
                        <button type="button" class="adm-btn adm-btn-outline" style="padding: 0.25rem 0.55rem; font-size: 0.74rem;" @onclick="() => _dismissedRemoteBanner = true">
                            Fechar
                        </button>
                    </div>
                }

                @if ((UpdateService.AvailableRelease?.IsUpdateAvailable == true || _compatibilityStatus?.UpdateRecommended == true) && !_dismissedUpdateBanner)
                {
                    var latestVersionLabel = UpdateService.AvailableRelease?.IsUpdateAvailable == true
                        ? UpdateService.AvailableRelease.LatestVersion
                        : _compatibilityStatus?.LatestAppVersion ?? string.Empty;
                    <div class="adm-compat-banner" style="display: flex; align-items: center; justify-content: space-between; gap: 0.65rem; flex-wrap: wrap; padding: 0.6rem 1rem; background: color-mix(in srgb, var(--adm-accent) 12%, var(--adm-surface)); border-bottom: 1px solid var(--adm-border); font-size: 0.82rem;">
                        <span>
                            ✨ <strong>Atualização v@(latestVersionLabel) disponível</strong> — toque para baixar e atualizar diretamente pelo app.
                        </span>
                        <div style="display: flex; gap: 0.45rem; align-items: center;">
                            <button type="button" class="adm-btn adm-btn-accent" style="padding: 0.3rem 0.65rem; font-size: 0.78rem;" @onclick="UpdateService.OpenPopup">
                                🚀 Atualizar v@(latestVersionLabel)
                            </button>
                            <button type="button" class="adm-btn adm-btn-outline" style="padding: 0.3rem 0.55rem; font-size: 0.76rem;" @onclick="() => _dismissedUpdateBanner = true">
                                Dispensar
                            </button>
                        </div>
                    </div>
                }

                <main class="adm-content">
                    @Body
                </main>
            </div>
        </div>
    }

    <appmaui.blazor.Components.Pages.UserProfileModal @bind-IsOpen="_showUserProfileModal" OnLogoutRequested="HandleLogout" />
    <appmaui.blazor.Components.Shared.PlanStatusPopupModal />
    <appmaui.blazor.Components.Shared.AppUpdateModal />
</div>

@code {
    private string _storeName = "Minha Loja";
    private string _storeSlug = "minha-loja";
    private bool _showUserProfileModal;
    private ApiCompatibilityStatusDto? _compatibilityStatus;
    private bool _dismissedUpdateBanner;
    private bool _dismissedRemoteBanner;
    private CancellationTokenSource? _pendingPlanMonitorCts;
    private CancellationTokenSource? _cloudPlanMonitorCts;

    private static string GetUserInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "U";

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpperInvariant();

        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpperInvariant();
    }

    protected override async Task OnInitializedAsync()
    {
        Gateway.AuthStateChanged += OnAuthStateChanged;
        Gateway.PlanEntitlementActivated += OnPlanEntitlementActivated;
        Gateway.RemoteConfigChanged += OnRemoteConfigChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Theme.OnThemeChanged += OnThemeChanged;
        BrandState.OnBrandChanged += OnBrandChanged;
        CloudSync.OnSyncStatusChanged += OnSyncStatusChanged;
        UpdateService.StateChanged += OnUpdateStateChanged;

        UpdateService.StartBackgroundMonitor();
        await Gateway.TryRestoreSessionAsync();
        await RefreshStoreInfoAsync();
        _ = RunStartupBackgroundChecksAsync();
    }

    private async Task RefreshUpdatesInBackgroundAsync()
    {
        try
        {
            await UpdateService.CheckForUpdatesAsync();
            _compatibilityStatus = Gateway.LatestCompatibilityStatus;
        }
        catch
        {
        }
    }

    private async Task CheckUpdatesManuallyFromTopbarAsync()
    {
        await UpdateService.CheckForUpdatesAsync(manualTrigger: true);
        UpdateService.OpenPopup();
    }

    private async Task RunStartupBackgroundChecksAsync()
    {
        await TryDeliverPendingPlanQuietlyAsync();
        await RefreshCloudPlanStatusQuietlyAsync(forceRefresh: true);
        EnsurePendingPlanBackgroundMonitor();
        EnsureCloudPlanBackgroundMonitor();
        _ = Gateway.FetchRemoteFeatureConfigBestEffortAsync();
        await RefreshUpdatesInBackgroundAsync();

        try
        {
            await CloudSync.EnsureCloudMirrorPopulatedAsync();
        }
        catch
        {
        }
    }

    private async Task RefreshCloudPlanStatusQuietlyAsync(bool forceRefresh = false)
    {
        if (!Gateway.IsAuthenticated)
            return;

        try
        {
            var synced = await Gateway.RefreshPlanFromCentralCloudBestEffortAsync(forceRefresh: forceRefresh);
            if (synced is not null)
            {
                await RefreshStoreInfoAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
        }
    }

    private void EnsureCloudPlanBackgroundMonitor()
    {
        if (!Gateway.IsAuthenticated)
        {
            StopCloudPlanBackgroundMonitor();
            return;
        }

        if (_cloudPlanMonitorCts is not null)
            return;

        var cts = new CancellationTokenSource();
        _cloudPlanMonitorCts = cts;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(35));
            while (true)
            {
                try
                {
                    if (!await timer.WaitForNextTickAsync(cts.Token))
                        break;
                }
                catch (OperationCanceledException)
                {
                    break;
                }

                if (!Gateway.IsAuthenticated)
                {
                    StopCloudPlanBackgroundMonitor();
                    break;
                }

                await RefreshCloudPlanStatusQuietlyAsync(forceRefresh: false);
            }
        }, cts.Token);
    }

    private void EnsurePendingPlanBackgroundMonitor()
    {
        if (!Gateway.IsAuthenticated || Gateway.GetPendingPlanOrder() is null)
        {
            StopPendingPlanBackgroundMonitor();
            return;
        }

        if (_pendingPlanMonitorCts is not null)
            return;

        var cts = new CancellationTokenSource();
        _pendingPlanMonitorCts = cts;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (true)
            {
                try
                {
                    if (!await timer.WaitForNextTickAsync(cts.Token))
                        break;
                }
                catch (OperationCanceledException)
                {
                    break;
                }

                if (!Gateway.IsAuthenticated || Gateway.GetPendingPlanOrder() is null)
                {
                    StopPendingPlanBackgroundMonitor();
                    break;
                }

                try
                {
                    await TryDeliverPendingPlanQuietlyAsync();
                    if (Gateway.GetPendingPlanOrder() is null)
                    {
                        StopPendingPlanBackgroundMonitor();
                        break;
                    }
                }
                catch
                {
                }
            }
        }, cts.Token);
    }

    private static void StopMonitorCts(ref CancellationTokenSource? cts)
    {
        try
        {
            cts?.Cancel();
            cts?.Dispose();
        }
        catch
        {
        }
        finally
        {
            cts = null;
        }
    }

    private void StopPendingPlanBackgroundMonitor() => StopMonitorCts(ref _pendingPlanMonitorCts);
    private void StopCloudPlanBackgroundMonitor() => StopMonitorCts(ref _cloudPlanMonitorCts);

    private async Task TryDeliverPendingPlanQuietlyAsync()
    {
        if (!Gateway.IsAuthenticated)
            return;

        try
        {
            var status = await Gateway.TryAutoDeliverPendingPlanAsync();
            if (status?.IsApproved == true)
            {
                await RefreshStoreInfoAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
        }
    }

    private bool IsPublicCatalogRoute()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        return relative.StartsWith("site", StringComparison.OrdinalIgnoreCase) ||
               relative.StartsWith("loja/", StringComparison.OrdinalIgnoreCase);
    }

    private async Task RefreshStoreInfoAsync()
    {
        try
        {
            var store = await CatalogService.GetPublicStoreSettingsAsync();
            _storeName = store.StoreName;
            _storeSlug = store.StoreSlug;
            BrandState.ApplyFromPublicSettings(store);
        }
        catch
        {
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await TryDeliverPendingPlanQuietlyAsync();
        _ = RefreshCloudPlanStatusQuietlyAsync(forceRefresh: false);
        EnsurePendingPlanBackgroundMonitor();
        EnsureCloudPlanBackgroundMonitor();
        await RefreshStoreInfoAsync();
        _ = RefreshUpdatesInBackgroundAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthStateChanged()
    {
        try
        {
            if (!Gateway.IsAuthenticated)
            {
                StopPendingPlanBackgroundMonitor();
                StopCloudPlanBackgroundMonitor();
            }

            await InvokeAsync(StateHasChanged);
            await RefreshStoreInfoAsync();
            _ = RefreshUpdatesInBackgroundAsync();
            _ = TryDeliverPendingPlanQuietlyAsync();
            if (Gateway.IsAuthenticated)
            {
                _ = RefreshCloudPlanStatusQuietlyAsync(forceRefresh: false);
                EnsureCloudPlanBackgroundMonitor();
            }
            EnsurePendingPlanBackgroundMonitor();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private void OnPlanEntitlementActivated(AdminStoreSettingsDto updated)
    {
        _ = InvokeAsync(() =>
        {
            _storeName = updated.StoreName;
            _storeSlug = updated.StoreSlug;
            BrandState.ApplyFromAdminSettings(updated);
            Gateway.EnsurePlanPopupFromSettings(updated);
            StateHasChanged();
        });
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnRemoteConfigChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnBrandChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async void OnSyncStatusChanged()
    {
        await RefreshStoreInfoAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnUpdateStateChanged()
    {
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private void OpenUserProfileModal() => _showUserProfileModal = true;

    private void HandleLogout()
    {
        Gateway.Logout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        StopPendingPlanBackgroundMonitor();
        StopCloudPlanBackgroundMonitor();
        Gateway.AuthStateChanged -= OnAuthStateChanged;
        Gateway.PlanEntitlementActivated -= OnPlanEntitlementActivated;
        Gateway.RemoteConfigChanged -= OnRemoteConfigChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        Theme.OnThemeChanged -= OnThemeChanged;
        BrandState.OnBrandChanged -= OnBrandChanged;
        CloudSync.OnSyncStatusChanged -= OnSyncStatusChanged;
        UpdateService.StateChanged -= OnUpdateStateChanged;
    }
}
