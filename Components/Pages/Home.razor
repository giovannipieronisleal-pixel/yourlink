@page "/"
@using System.Globalization
@using ClothingStore.Shared.Helpers
@inject MauiAdminGateway Gateway
@inject NavigationManager Navigation
@inject ClothingStore.Application.Services.CatalogService CatalogService
@inject StoreBrandStateService BrandState
@implements IDisposable

<div class="yl-home-wrap">
    <!-- Saudação Calma & Direta -->
    <header class="yl-home-header">
        <div class="yl-home-greeting">
            <h1 class="yl-home-title">@GreetingText</h1>
            @if (_publicStore is not null)
            {
                <div class="yl-home-store-sub">@_publicStore.StoreName</div>
            }
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert-banner alert-error">@_error</div>
    }

    @if (_publicStore is not null)
    {
        <!-- Cartão Único e Limpo: Link da Sua Loja -->
        <section class="adm-card yl-share-card" aria-label="Compartilhar sua loja">
            <div class="yl-share-meta">
                <span class="yl-share-label">Link da sua loja</span>
                <div class="yl-share-url" title="@PublicStoreUrl">@DisplayStoreUrl</div>
            </div>

            <div class="yl-share-actions">
                <button type="button"
                        class="adm-btn adm-btn-primary yl-share-btn"
                        @onclick="CopyStoreLinkAsync">
                    @(_copiedLink ? "✓ Copiado!" : "Copiar link")
                </button>
                <button type="button"
                        class="adm-btn adm-btn-success yl-share-btn"
                        @onclick="ShareStoreOnWhatsAppAsync">
                    WhatsApp
                </button>
            </div>
        </section>
    }

    <!-- Botão Principal em Destaque (Largura Total, estilo Figma aprovado) -->
    @if (Gateway.CanManageProducts)
    {
        <a href="/produtos?novo=1" class="adm-btn adm-btn-primary yl-home-primary-cta">
            + Cadastrar novo produto
        </a>
    }
    else if (Gateway.CanManageStock)
    {
        <a href="/estoque" class="adm-btn adm-btn-primary yl-home-primary-cta">
            📦 Ajustar estoque
        </a>
    }

    @if (_summary is not null)
    {
        <!-- Grade 2x2 Limpa de Resumo (Sem texto repetitivo, Vendas Hoje em Verde) -->
        <section class="yl-summary-grid" aria-label="Resumo rápido da loja">
            <a href="/vendas" class="yl-summary-card">
                <span class="yl-summary-label">Vendas hoje</span>
                @if (_salesReport?.IsUnlocked == true)
                {
                    <strong class="yl-summary-value yl-summary-value-green">@_salesReport.TodayConfirmedRevenue.ToString("C", PtBr)</strong>
                }
                else
                {
                    <strong class="yl-summary-value yl-summary-value-muted">Ver vendas</strong>
                }
            </a>

            <a href="@(Gateway.IsAdmin ? "/pedidos" : "/estoque")" class="yl-summary-card">
                <span class="yl-summary-label">@(Gateway.IsAdmin ? "Pedidos novos" : "Estoque baixo")</span>
                <strong class="yl-summary-value @(PendingOrdersOrAlertsCount > 0 ? "yl-summary-value-amber" : string.Empty)">
                    @PendingOrdersOrAlertsCount
                </strong>
            </a>

            <a href="/produtos" class="yl-summary-card">
                <span class="yl-summary-label">Produtos ativos</span>
                <strong class="yl-summary-value">@_summary.TotalVisibleProducts</strong>
            </a>

            <a href="/estoque" class="yl-summary-card">
                <span class="yl-summary-label">Ajustar estoque</span>
                @if (_summary.StockAlerts.Count > 0)
                {
                    <strong class="yl-summary-value yl-summary-value-amber">@_summary.StockAlerts.Count @(_summary.StockAlerts.Count == 1 ? "alerta" : "alertas")</strong>
                }
                else
                {
                    <strong class="yl-summary-value yl-summary-value-ok">Tudo em dia</strong>
                }
            </a>
        </section>

        <!-- Cartão Único e Calmo: Últimas Vendas -->
        <section class="adm-card adm-sales-mini-card">
            <div class="adm-sales-mini-header">
                <h2 class="adm-sales-mini-title">Últimas Vendas</h2>
                <a href="@(_salesReport?.IsUnlocked == true ? "/vendas" : "/pedidos")" class="adm-sales-mini-link">
                    Ver todas
                </a>
            </div>

            @if (_recentSalesFeed.Count == 0)
            {
                <p class="adm-sales-mini-empty">Nenhuma venda registrada ainda. Compartilhe o link da sua loja acima para começar.</p>
            }
            else
            {
                <ul class="adm-sales-mini-list">
                    @foreach (var sale in _recentSalesFeed)
                    {
                        <li class="adm-sales-mini-item">
                            <span class="adm-sales-mini-what" title="@sale.WhatSold">@sale.WhatSold</span>
                            <span class="adm-sales-mini-who" title="@sale.Who">@sale.Who</span>
                        </li>
                    }
                </ul>
            }
        </section>

        <!-- Faixa Discreta de Reposição (só aparece se houver alerta e expande sob demanda) -->
        @if (_summary.StockAlerts.Count > 0)
        {
            <section class="adm-card yl-alerts-drawer">
                <button type="button"
                        class="yl-alerts-toggle"
                        aria-expanded="@_showStockAlerts"
                        @onclick="() => _showStockAlerts = !_showStockAlerts">
                    <span class="yl-alerts-toggle-text">
                        <span class="pill-badge pill-amber">⚠ @_summary.StockAlerts.Count</span>
                        <span>Produto(s) precisando de reposição no estoque</span>
                    </span>
                    <span class="yl-alerts-toggle-action">@(_showStockAlerts ? "Ocultar ▴" : "Ver lista ▾")</span>
                </button>

                @if (_showStockAlerts)
                {
                    <div class="adm-table-wrap" style="margin-top: 1rem;">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th>Saldo</th>
                                    <th>Status</th>
                                    <th>Ação</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in _summary.StockAlerts)
                                {
                                    <tr>
                                        <td data-label="Produto">
                                            <div style="font-weight: 700;">@alert.ProductName</div>
                                            <div style="font-size: 0.84rem; color: var(--adm-muted);">
                                                @alert.Color &bull; @alert.Size
                                            </div>
                                        </td>
                                        <td data-label="Saldo" style="font-weight: 800;">@alert.StockQuantity un.</td>
                                        <td data-label="Status">
                                            @if (alert.IsOutOfStock)
                                            {
                                                <span class="pill-badge pill-red">Sem estoque</span>
                                            }
                                            else
                                            {
                                                <span class="pill-badge pill-amber">Estoque baixo</span>
                                            }
                                        </td>
                                        <td data-label="Ação">
                                            <a href="/produtos/@alert.ProductId" class="adm-btn adm-btn-outline" style="min-height: 36px; padding: 0.35rem 0.75rem; font-size: 0.84rem;">
                                                Repor
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private static readonly CultureInfo PtBr = new("pt-BR");
    private DashboardSummaryDto? _summary;
    private PublicStoreSettingsDto? _publicStore;
    private SalesReportDto? _salesReport;
    private IReadOnlyList<DashboardCompactSaleItem> _recentSalesFeed = [];
    private int _pendingOrdersCount;
    private bool _showStockAlerts;
    private bool _copiedLink;
    private string? _error;

    private string GreetingText
    {
        get
        {
            var fullName = Gateway.CurrentEmployee?.FullName?.Trim();
            if (string.IsNullOrWhiteSpace(fullName) ||
                string.Equals(fullName, "Admin", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(fullName, "Administrador", StringComparison.OrdinalIgnoreCase))
            {
                return "Olá, Lojista!";
            }

            var firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];
            return $"Olá, {firstName}!";
        }
    }

    private string PublicStoreUrl
    {
        get
        {
            var slug = _publicStore?.StoreSlug ?? "minha-loja";
            var targetBase = !string.IsNullOrWhiteSpace(_publicStore?.OnlineBaseUrl)
                ? _publicStore.OnlineBaseUrl
                : Gateway.GetPublicPortalBaseUrl();
            return WhatsAppLinkBuilder.BuildStoreCatalogUrl(targetBase, slug);
        }
    }

    private string DisplayStoreUrl =>
        PublicStoreUrl
            .Replace("https://", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("http://", string.Empty, StringComparison.OrdinalIgnoreCase);

    private int PendingOrdersOrAlertsCount =>
        Gateway.IsAdmin
            ? _pendingOrdersCount
            : (_summary?.LowStockVariantsCount ?? 0) + (_summary?.OutOfStockVariantsCount ?? 0);

    protected override async Task OnInitializedAsync()
    {
        Gateway.AuthStateChanged += OnAuthStateChanged;
        Gateway.PlanEntitlementActivated += OnPlanEntitlementActivated;
        if (Gateway.IsAuthenticated)
        {
            await LoadDashboardAsync();
        }
    }

    private async void OnAuthStateChanged()
    {
        if (Gateway.IsAuthenticated)
        {
            await LoadDashboardAsync();
        }
        else
        {
            _summary = null;
            _publicStore = null;
            _salesReport = null;
            _recentSalesFeed = [];
            _pendingOrdersCount = 0;
            _showStockAlerts = false;
            _error = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OnPlanEntitlementActivated(AdminStoreSettingsDto updated)
    {
        BrandState.ApplyFromAdminSettings(updated);
        _ = InvokeAsync(async () =>
        {
            await LoadDashboardCoreAsync(refreshCloud: false);
            StateHasChanged();
        });
    }

    private Task LoadDashboardAsync() => LoadDashboardCoreAsync(refreshCloud: true);

    private async Task LoadDashboardCoreAsync(bool refreshCloud)
    {
        _error = null;
        try
        {
            if (refreshCloud && Gateway.IsAuthenticated)
            {
                await Gateway.RefreshPlanFromCentralCloudBestEffortAsync(forceRefresh: false);
            }

            _summary = await Gateway.GetDashboardSummaryAsync();
            _publicStore = await CatalogService.GetPublicStoreSettingsAsync();
            if (_publicStore is not null)
            {
                BrandState.ApplyFromPublicSettings(_publicStore);
            }

            _salesReport = await Gateway.GetSalesReportAsync("30d");
            _recentSalesFeed = DashboardRecentSalesHelper.BuildCompactSalesFeed(_summary, _salesReport, maxItems: 3);

            if (Gateway.IsAdmin)
            {
                try
                {
                    var orders = await Gateway.GetOrdersAsync();
                    _pendingOrdersCount = orders.Count(o =>
                        string.Equals(o.Status, BrazilShippingCalculator.OrderStatuses.AwaitingPix, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(o.Status, BrazilShippingCalculator.OrderStatuses.PaidPreparing, StringComparison.OrdinalIgnoreCase));
                }
                catch
                {
                    _pendingOrdersCount = 0;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CopyStoreLinkAsync()
    {
        try
        {
            await Clipboard.Default.SetTextAsync(PublicStoreUrl);
            _copiedLink = true;
            StateHasChanged();
            await Task.Delay(2600);
            _copiedLink = false;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async Task ShareStoreOnWhatsAppAsync()
    {
        var storeName = _publicStore?.StoreName ?? "nossa loja";
        var text = $"Olá! Confira os produtos da {storeName} no nosso catálogo online: {PublicStoreUrl}";
        var waUrl = $"https://wa.me/?text={Uri.EscapeDataString(text)}";
        await Gateway.OpenExternalUrlSafeAsync(waUrl);
    }

    public void Dispose()
    {
        Gateway.AuthStateChanged -= OnAuthStateChanged;
        Gateway.PlanEntitlementActivated -= OnPlanEntitlementActivated;
    }
}
