@page "/estoque"
@inject MauiAdminGateway Gateway

<div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
    <div>
        <h1 style="font-size: 1.65rem; font-weight: 800; margin: 0;">Controle de Estoque</h1>
        <p style="color: var(--adm-muted); font-size: 0.92rem; margin: 0.25rem 0 0;">
            Adicione, retire ou ajuste o saldo de qualquer produto em <strong>1 clique</strong> ou defina uma quantidade específica abaixo.
        </p>
    </div>

    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button type="button" class="adm-btn adm-btn-outline" @onclick="LoadAllDataAsync" disabled="@_isSubmitting">
            🔄 Atualizar
        </button>
        <a href="/produtos" class="adm-btn adm-btn-primary">
            🛍️ Ir para Produtos
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert-banner alert-error" style="margin-bottom: 1rem;">@_error</div>
}

@if (!string.IsNullOrWhiteSpace(_success))
{
    <div class="alert-banner alert-success" style="margin-bottom: 1rem;">@_success</div>
}

@if (Gateway.CanManageStock)
{
    var visibleRows = GetFilteredVariantRows().ToList();
    var allRowsCount = _products.Sum(p => p.Variants.Count(v => v.IsActive));
    var lowCount = _products.Sum(p => p.Variants.Count(v => v.IsActive && v.StockQuantity > 0 && v.StockQuantity <= v.LowStockThreshold));
    var zeroCount = _products.Sum(p => p.Variants.Count(v => v.IsActive && v.StockQuantity == 0));

    <!-- 1. MOVIMENTAÇÃO RÁPIDA EM 1 TOQUE -->
    <section class="adm-card" style="border-left: 4px solid var(--adm-success); margin-bottom: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.85rem;">
            <div>
                <h2 style="font-size: 1.12rem; font-weight: 800; margin: 0;">⚡ Movimentar em 1 Toque (@visibleRows.Count itens)</h2>
                <p style="font-size: 0.82rem; color: var(--adm-muted); margin: 0.2rem 0 0;">
                    Identifique o produto pela foto, nome, variação ou SKU e toque em <strong>−1 Retirar</strong> para dar baixa ou em <strong>+1 / +5 / +10</strong> para repor.
                </p>
            </div>
        </div>

        <div style="display: flex; gap: 0.55rem; flex-wrap: wrap; align-items: center; margin-bottom: 0.85rem;">
            <input type="text"
                   class="adm-input"
                   style="flex: 1 1 240px; min-width: 0;"
                   value="@_quickSearch"
                   @oninput='e => _quickSearch = e.Value?.ToString() ?? string.Empty'
                   placeholder="🔎 Pesquisar produto, cor, variação ou SKU..." />

            <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
                <button type="button"
                        class="adm-btn @(_quickFilter == "all" ? "adm-btn-primary" : "adm-btn-outline")"
                        style="padding: 0.4rem 0.75rem; font-size: 0.8rem;"
                        @onclick='() => SetQuickFilter("all")'>
                    Todos (@allRowsCount)
                </button>
                <button type="button"
                        class="adm-btn @(_quickFilter == "low" ? "adm-btn-accent" : "adm-btn-outline")"
                        style="padding: 0.4rem 0.75rem; font-size: 0.8rem;"
                        @onclick='() => SetQuickFilter("low")'>
                    ⚠️ Baixo (@lowCount)
                </button>
                <button type="button"
                        class="adm-btn @(_quickFilter == "zero" ? "adm-btn-danger" : "adm-btn-outline")"
                        style="padding: 0.4rem 0.75rem; font-size: 0.8rem;"
                        @onclick='() => SetQuickFilter("zero")'>
                    🚫 Zerados (@zeroCount)
                </button>
                @if (!string.IsNullOrWhiteSpace(_filterProductId) || !string.IsNullOrWhiteSpace(_quickSearch))
                {
                    <button type="button"
                            class="adm-btn adm-btn-outline"
                            style="padding: 0.4rem 0.7rem; font-size: 0.8rem;"
                            @onclick="ClearQuickFiltersAsync">
                        ✕ Limpar filtros
                    </button>
                }
            </div>
        </div>

        @if (_products.Count == 0)
        {
            <div style="padding: 1.25rem; text-align: center; color: var(--adm-muted); background: var(--adm-input-bg); border-radius: 10px;">
                Nenhum produto cadastrado ainda. <a href="/produtos" style="font-weight: 700;">Cadastre o primeiro produto aqui &rarr;</a>
            </div>
        }
        else if (visibleRows.Count == 0)
        {
            <div style="padding: 1.15rem; text-align: center; color: var(--adm-muted); background: var(--adm-input-bg); border-radius: 10px;">
                <span>Nenhum item encontrado para esse filtro.</span>
            </div>
        }
        else
        {
            <div class="stk-grid">
                @foreach (var item in visibleRows.Take(40))
                {
                    var isSelected = item.Variant.Id == _movementRequest.ProductVariantId;
                    var isZero = item.Variant.StockQuantity <= 0;
                    var isLow = item.Variant.IsLowStock && !isZero;
                    var coverUrl = ResolveProductCoverUrl(item.Product);

                    <div class="stk-item-card @(isSelected ? "selected" : null)">
                        <div class="stk-card-head">
                            <button type="button"
                                    class="stk-thumb-wrap"
                                    title="Selecionar este item para ajuste detalhado"
                                    @onclick="() => SelectVariantForDetailedForm(item.Product, item.Variant)">
                                @if (!string.IsNullOrWhiteSpace(coverUrl))
                                {
                                    <img src="@coverUrl" alt="@item.Product.Name" class="stk-thumb" loading="lazy" />
                                }
                                else
                                {
                                    <div class="stk-thumb-placeholder">Sem foto</div>
                                }
                            </button>

                            <div class="stk-card-info">
                                <div class="stk-card-title-row">
                                    <div class="stk-card-title">@item.Product.Name</div>
                                    <span class="pill-badge @(isZero ? "pill-red" : isLow ? "pill-amber" : "pill-green") stk-qty-pill">
                                        @item.Variant.StockQuantity un.
                                    </span>
                                </div>

                                <div class="stk-variant-meta">
                                    @if (!string.IsNullOrWhiteSpace(item.Variant.ColorHex))
                                    {
                                        <span class="stk-color-dot" style="background: @item.Variant.ColorHex;"></span>
                                    }
                                    <strong>@FormatVariantDisplay(item.Variant.Color, item.Variant.Size)</strong>
                                    <span class="stk-sku">(@item.Variant.Sku)</span>
                                </div>
                            </div>
                        </div>

                        <div class="stk-actions-row">
                            <button type="button"
                                    class="adm-btn adm-btn-danger stk-op-btn"
                                    disabled="@(_isSubmitting || isZero)"
                                    title="Retirar 1 unidade do estoque"
                                    @onclick='() => QuickMoveAsync(item.Product, item.Variant, "OUT", 1, "Saída rápida (-1 un.)")'>
                                <span class="stk-op-num">−1</span>
                                <span class="stk-op-sub">Retirar</span>
                            </button>
                            <button type="button"
                                    class="adm-btn adm-btn-success stk-op-btn"
                                    disabled="@_isSubmitting"
                                    title="Adicionar 1 unidade ao estoque"
                                    @onclick='() => QuickMoveAsync(item.Product, item.Variant, "IN", 1, "Entrada rápida (+1 un.)")'>
                                <span class="stk-op-num">+1</span>
                                <span class="stk-op-sub">Entrar</span>
                            </button>
                            <button type="button"
                                    class="adm-btn adm-btn-success stk-op-btn"
                                    disabled="@_isSubmitting"
                                    title="Adicionar 5 unidades"
                                    @onclick='() => QuickMoveAsync(item.Product, item.Variant, "IN", 5, "Reposição rápida (+5 un.)")'>
                                <span class="stk-op-num">+5</span>
                                <span class="stk-op-sub">Repor</span>
                            </button>
                            <button type="button"
                                    class="adm-btn adm-btn-outline stk-op-btn"
                                    disabled="@_isSubmitting"
                                    title="Adicionar 10 unidades"
                                    @onclick='() => QuickMoveAsync(item.Product, item.Variant, "IN", 10, "Reposição rápida (+10 un.)")'>
                                <span class="stk-op-num">+10</span>
                                <span class="stk-op-sub">Lote</span>
                            </button>
                            <button type="button"
                                    class="adm-btn @(isSelected ? "adm-btn-primary" : "adm-btn-outline") stk-op-btn"
                                    title="Retirar outra quantidade ou ajustar saldo"
                                    @onclick="() => SelectVariantForDetailedForm(item.Product, item.Variant)">
                                <span class="stk-op-num">✎</span>
                                <span class="stk-op-sub">Mais</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- 2. PAINEL DIRETO PARA OUTRA QUANTIDADE OU SALDO EXATO -->
    @if (_products.Count > 0)
    {
        var selectedProduct = GetSelectedProduct();
        var productVariants = GetVariantsOfSelectedProduct().ToList();
        var selectedVariant = GetSelectedVariant(selectedProduct) ?? productVariants.FirstOrDefault();
        var selectedCoverUrl = ResolveProductCoverUrl(selectedProduct);
        var currentQty = selectedVariant?.StockQuantity ?? 0;
        var projectedQty = GetProjectedStock(currentQty);

        <section class="adm-card" style="border-left: 4px solid var(--adm-primary); margin-bottom: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.85rem;">
                <div>
                    <h2 style="font-size: 1.08rem; font-weight: 800; margin: 0;">
                        📦 Entrada, Saída ou Ajuste de Estoque
                    </h2>
                    <p style="font-size: 0.82rem; color: var(--adm-muted); margin: 0.2rem 0 0;">
                        Escolha o produto, a operação e a quantidade. O novo saldo é calculado na hora.
                    </p>
                </div>
            </div>

            <div class="stk-selected-preview">
                <div class="stk-selected-preview-left">
                    <div class="stk-thumb-wrap">
                        @if (!string.IsNullOrWhiteSpace(selectedCoverUrl))
                        {
                            <img src="@selectedCoverUrl" alt="@(selectedProduct?.Name ?? "Produto")" class="stk-thumb" />
                        }
                        else
                        {
                            <div class="stk-thumb-placeholder">Sem foto</div>
                        }
                    </div>

                    <div class="stk-selected-preview-selects">
                        <div class="stk-selected-preview-field">
                            <label class="adm-label">Produto</label>
                            <select class="adm-select" @bind="_selectedProductIdString" @bind:after="OnProductSelectionChanged">
                                @foreach (var prod in _products)
                                {
                                    <option value="@prod.Id.ToString()">@prod.Name (@prod.TotalStockQuantity un.)</option>
                                }
                            </select>
                        </div>

                        @if (productVariants.Count > 1)
                        {
                            <div class="stk-selected-preview-field">
                                <label class="adm-label">Variação / Opção</label>
                                <select class="adm-select" @bind="_selectedVariantIdString" @bind:after="OnVariantSelectionChanged">
                                    @foreach (var v in productVariants)
                                    {
                                        <option value="@v.Id.ToString()">@FormatVariantDisplay(v.Color, v.Size) — @v.StockQuantity un.</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>

                <div class="stk-live-balance">
                    <div>
                        <span style="color: var(--adm-muted);">Saldo atual:</span>
                        <strong>@currentQty un.</strong>
                    </div>
                    <span style="color: var(--adm-muted); font-weight: 800;">&rarr;</span>
                    <div>
                        <span style="color: var(--adm-muted);">Após confirmar:</span>
                        <span class="pill-badge @(projectedQty <= 0 ? "pill-red" : "pill-green")" style="margin-left: 0.25rem;">
                            @projectedQty un.
                        </span>
                    </div>
                </div>
            </div>

            <div class="stk-form-grid">
                <div>
                    <label class="adm-label">1. O que deseja fazer?</label>
                    <div class="stk-mode-grid">
                        <button type="button"
                                class="adm-btn stk-mode-btn @(_movementRequest.MovementType == "IN" ? "adm-btn-success" : "adm-btn-outline")"
                                @onclick='() => SetMovementType("IN")'>
                            ➕ Entrada
                        </button>
                        <button type="button"
                                class="adm-btn stk-mode-btn @(_movementRequest.MovementType == "OUT" ? "adm-btn-danger" : "adm-btn-outline")"
                                @onclick='() => SetMovementType("OUT")'>
                            ➖ Saída
                        </button>
                        <button type="button"
                                class="adm-btn stk-mode-btn @(_movementRequest.MovementType == "ADJUSTMENT" ? "adm-btn-primary" : "adm-btn-outline")"
                                @onclick='() => SetMovementType("ADJUSTMENT")'>
                            ⚖️ Saldo Exato
                        </button>
                    </div>
                    <div style="font-size: 0.76rem; color: var(--adm-muted); margin-top: 0.4rem;">
                        @if (_movementRequest.MovementType == "IN")
                        {
                            <span>Soma unidades ao saldo atual do produto.</span>
                        }
                        else if (_movementRequest.MovementType == "OUT")
                        {
                            <span>Retira unidades do saldo atual (venda ou baixa).</span>
                        }
                        else
                        {
                            <span>Substitui o saldo atual pelo número digitado ao lado.</span>
                        }
                    </div>
                </div>

                <div>
                    <label class="adm-label">
                        @(_movementRequest.MovementType == "ADJUSTMENT" ? "2. Novo Saldo Total (un.)" : "2. Quantidade (un.)")
                    </label>
                    <input type="number"
                           min="0"
                           class="adm-input"
                           @bind="_movementRequest.Quantity"
                           @bind:event="oninput" />
                    <div class="stk-chip-row">
                        @foreach (var q in new[] { 1, 2, 5, 10, 20, 50 })
                        {
                            <button type="button"
                                    class="pill-badge @(_movementRequest.Quantity == q ? "pill-gold" : "pill-slate")"
                                    style="border: none; cursor: pointer;"
                                    @onclick="() => _movementRequest.Quantity = q">
                                @q
                            </button>
                        }
                    </div>
                </div>

                <div>
                    <label class="adm-label">3. Motivo / Observação (Opcional)</label>
                    <input type="text"
                           class="adm-input"
                           @bind="_movementRequest.Reason"
                           placeholder="Ex.: Reposição de estoque, Venda no balcão..." />
                    <div class="stk-chip-row">
                        @foreach (var reasonOption in QuickReasonOptions)
                        {
                            <button type="button"
                                    class="pill-badge @(_movementRequest.Reason == reasonOption ? "pill-blue" : "pill-slate")"
                                    style="border: none; cursor: pointer; font-size: 0.72rem;"
                                    @onclick="() => _movementRequest.Reason = reasonOption">
                                @reasonOption
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="stk-form-footer">
                <span style="font-size: 0.82rem; color: var(--adm-muted);">
                    Responsável: <strong>@(Gateway.CurrentEmployee?.FullName ?? "Lojista")</strong>
                </span>

                <button type="button"
                        class="adm-btn @GetSubmitButtonClass()"
                        style="min-width: 220px; font-weight: 800;"
                        disabled="@(_isSubmitting || selectedProduct is null)"
                        @onclick="SubmitMovementAsync">
                    @GetSubmitButtonLabel()
                </button>
            </div>
        </section>
    }
}

<!-- 3. HISTÓRICO AUDITÁVEL DE MOVIMENTAÇÕES -->
<section class="adm-card" style="overflow-x: auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
        <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0;">Histórico de Movimentações (@_movements.Count)</h2>

        <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; width: 100%; max-width: 100%;">
            <select class="adm-select" style="flex: 1 1 200px; min-width: 0; max-width: 100%;" @bind="_filterProductId" @bind:after="LoadMovementsAsync">
                <option value="">Todos os produtos</option>
                @foreach (var p in _products)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
            <button type="button" class="adm-btn adm-btn-outline" @onclick="LoadMovementsAsync">Atualizar</button>
        </div>
    </div>

    <table class="adm-table">
        <thead>
            <tr>
                <th>Data e Horário</th>
                <th>Produto</th>
                <th>Variante (Cor/Opção)</th>
                <th>Tipo</th>
                <th>Saldo Anterior</th>
                <th>Alteração</th>
                <th>Novo Saldo</th>
                <th>Motivo</th>
                <th>Responsável</th>
            </tr>
        </thead>
        <tbody>
            @if (_movements.Count == 0)
            {
                <tr>
                    <td colspan="9" style="text-align: center; padding: 1.5rem; color: var(--adm-muted);">
                        Nenhuma movimentação registrada ainda. Use os botões rápidos acima para movimentar qualquer item em 1 toque!
                    </td>
                </tr>
            }
            @foreach (var m in _movements)
            {
                var histCoverUrl = TryResolveProductCoverUrl(m.ProductId);
                <tr>
                    <td data-label="Data/Hora" style="font-size: 0.84rem;">
                        @m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </td>
                    <td data-label="Produto" style="font-weight: 700;">
                        <div class="stk-hist-prod">
                            @if (!string.IsNullOrWhiteSpace(histCoverUrl))
                            {
                                <img src="@histCoverUrl" alt="@m.ProductName" class="stk-hist-thumb" loading="lazy" />
                            }
                            else
                            {
                                <div class="stk-hist-thumb-placeholder">Sem</div>
                            }
                            <span>@m.ProductName</span>
                        </div>
                    </td>
                    <td data-label="Variante">
                        <div>
                            <span>@m.Color / <strong>@m.Size</strong></span>
                            <div style="font-size: 0.76rem; color: var(--adm-muted);">@m.VariantSku</div>
                        </div>
                    </td>
                    <td data-label="Tipo">
                        @if (m.MovementType == "IN")
                        {
                            <span class="pill-badge pill-green">Entrada</span>
                        }
                        else if (m.MovementType == "OUT")
                        {
                            <span class="pill-badge pill-red">Saída</span>
                        }
                        else
                        {
                            <span class="pill-badge pill-amber">Ajuste</span>
                        }
                    </td>
                    <td data-label="Saldo Anterior">@m.PreviousQuantity un.</td>
                    <td data-label="Alteração" style="font-weight: 800;">
                        @(m.MovementType == "OUT" ? $"-{m.QuantityChanged}" : m.QuantityChanged > 0 ? $"+{m.QuantityChanged}" : m.QuantityChanged.ToString())
                    </td>
                    <td data-label="Novo Saldo" style="font-weight: 800;">@m.NewQuantity un.</td>
                    <td data-label="Motivo" style="font-size: 0.85rem; color: var(--adm-muted);">@m.Reason</td>
                    <td data-label="Responsável" style="font-size: 0.85rem; font-weight: 600;">@m.EmployeeName</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    private sealed record VariantQuickRow(ProductDetailDto Product, ProductVariantDto Variant);

    private static readonly string[] QuickReasonOptions =
    [
        "Reposição de estoque",
        "Venda WhatsApp / Balcão",
        "Troca / Devolução",
        "Conferência de inventário"
    ];

    [SupplyParameterFromQuery(Name = "productId")]
    public Guid? ProductIdQuery { get; set; }

    private IReadOnlyList<ProductDetailDto> _products = [];
    private IReadOnlyList<StockMovementDto> _movements = [];

    private Guid _selectedProductId;
    private string _selectedProductIdString = string.Empty;
    private string _selectedVariantIdString = string.Empty;
    private string? _filterProductId;
    private string _quickSearch = string.Empty;
    private string _quickFilter = "all";
    private bool _isSubmitting;

    private CreateStockMovementRequest _movementRequest = new()
    {
        MovementType = "IN",
        Quantity = 1,
        Reason = "Reposição de estoque"
    };

    private string? _error;
    private string? _success;

    protected override async Task OnInitializedAsync()
    {
        if (ProductIdQuery.HasValue && ProductIdQuery.Value != Guid.Empty)
        {
            _selectedProductId = ProductIdQuery.Value;
            _selectedProductIdString = ProductIdQuery.Value.ToString();
            _filterProductId = ProductIdQuery.Value.ToString();
        }

        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        _error = null;
        try
        {
            _products = await Gateway.GetProductsAsync();
            if (Gateway.CanManageProducts && _products.Any(p => p.Variants.Count == 0))
            {
                foreach (var prodWithoutVariant in _products.Where(p => p.Variants.Count == 0).ToList())
                {
                    await Gateway.AddVariantAsync(prodWithoutVariant.Id, new SaveProductVariantRequest
                    {
                        Color = "Padrão",
                        Size = "Único",
                        ColorHex = "#18181B",
                        InitialStockQuantity = 0,
                        LowStockThreshold = 3,
                        IsActive = true
                    });
                }

                _products = await Gateway.GetProductsAsync();
            }

            if (_selectedProductId == Guid.Empty && _products.Count > 0)
            {
                _selectedProductId = _products[0].Id;
                _selectedProductIdString = _selectedProductId.ToString();
            }

            if (_selectedProductId != Guid.Empty)
            {
                OnProductSelectionChanged();
            }

            await LoadMovementsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private IEnumerable<VariantQuickRow> GetFilteredVariantRows()
    {
        var query = _quickSearch.Trim();
        Guid? productFilterGuid = Guid.TryParse(_filterProductId, out var pg) ? pg : null;

        foreach (var prod in _products)
        {
            if (productFilterGuid.HasValue && prod.Id != productFilterGuid.Value)
                continue;

            foreach (var v in prod.Variants.Where(v => v.IsActive))
            {
                if (_quickFilter == "zero" && v.StockQuantity != 0)
                    continue;

                if (_quickFilter == "low" && !(v.StockQuantity > 0 && v.StockQuantity <= v.LowStockThreshold))
                    continue;

                if (!string.IsNullOrWhiteSpace(query))
                {
                    var haystack = $"{prod.Name} {prod.CategoryName} {v.Color} {v.Size} {v.Sku}";
                    if (!haystack.Contains(query, StringComparison.OrdinalIgnoreCase))
                        continue;
                }

                yield return new VariantQuickRow(prod, v);
            }
        }
    }

    private void SetQuickFilter(string mode) => _quickFilter = mode;

    private async Task ClearQuickFiltersAsync()
    {
        _quickSearch = string.Empty;
        _quickFilter = "all";
        _filterProductId = string.Empty;
        await LoadMovementsAsync();
    }

    private void SelectVariantForDetailedForm(ProductDetailDto prod, ProductVariantDto variant)
    {
        _selectedProductId = prod.Id;
        _selectedProductIdString = prod.Id.ToString();
        _movementRequest.ProductVariantId = variant.Id;
        _selectedVariantIdString = variant.Id.ToString();
        _success = $"Item '{prod.Name}' selecionado no painel abaixo.";
    }

    private void SetMovementType(string movementType)
    {
        _movementRequest.MovementType = movementType;
        if (string.IsNullOrWhiteSpace(_movementRequest.Reason) || QuickReasonOptions.Contains(_movementRequest.Reason))
        {
            _movementRequest.Reason = movementType switch
            {
                "OUT" => "Venda WhatsApp / Balcão",
                "ADJUSTMENT" => "Conferência de inventário",
                _ => "Reposição de estoque"
            };
        }
    }

    private int GetProjectedStock(int currentQty)
    {
        var qty = Math.Max(0, _movementRequest.Quantity);
        return _movementRequest.MovementType switch
        {
            "OUT" => Math.Max(0, currentQty - qty),
            "ADJUSTMENT" => qty,
            _ => currentQty + qty
        };
    }

    private string GetSubmitButtonClass() => _movementRequest.MovementType switch
    {
        "OUT" => "adm-btn-danger",
        "ADJUSTMENT" => "adm-btn-primary",
        _ => "adm-btn-success"
    };

    private string GetSubmitButtonLabel()
    {
        if (_isSubmitting)
            return "Registrando...";

        var qty = Math.Max(0, _movementRequest.Quantity);
        return _movementRequest.MovementType switch
        {
            "OUT" => $"➖ Confirmar Saída (-{qty} un.)",
            "ADJUSTMENT" => $"⚖️ Salvar Saldo Exato ({qty} un.)",
            _ => $"➕ Confirmar Entrada (+{qty} un.)"
        };
    }

    private static string FormatVariantDisplay(string? color, string? size)
    {
        var c = (color ?? string.Empty).Trim();
        var s = (size ?? string.Empty).Trim();
        var isDefaultColor = string.IsNullOrWhiteSpace(c) ||
                             string.Equals(c, "Padrão", StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(c, "Único", StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(c, "Única", StringComparison.OrdinalIgnoreCase);
        var isDefaultSize = string.IsNullOrWhiteSpace(s) ||
                            string.Equals(s, "Único", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(s, "Única", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(s, "Padrão", StringComparison.OrdinalIgnoreCase);

        if (isDefaultColor && isDefaultSize)
            return "Padrão (Item único)";
        if (isDefaultSize)
            return c;
        if (isDefaultColor)
            return s;
        return $"{c} • {s}";
    }

    private async Task QuickMoveAsync(
        ProductDetailDto product,
        ProductVariantDto variant,
        string movementType,
        int quantity,
        string reason)
    {
        if (_isSubmitting)
            return;

        _isSubmitting = true;
        _error = null;
        _success = null;
        try
        {
            var mov = await Gateway.RegisterStockMovementAsync(new CreateStockMovementRequest
            {
                ProductVariantId = variant.Id,
                MovementType = movementType,
                Quantity = quantity,
                Reason = reason
            });

            _products = await Gateway.GetProductsAsync();
            await LoadMovementsAsync();
            var opLabel = movementType == "OUT" ? $"-{quantity}" : $"+{quantity}";
            _success = $"✓ {product.Name} atualizado ({opLabel}): {mov.PreviousQuantity} → {mov.NewQuantity} un.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OnProductSelectionChanged()
    {
        if (Guid.TryParse(_selectedProductIdString, out var prodGuid))
        {
            _selectedProductId = prodGuid;
        }

        var variants = GetVariantsOfSelectedProduct().ToList();
        var current = variants.FirstOrDefault(v => v.Id == _movementRequest.ProductVariantId) ?? variants.FirstOrDefault();
        if (current is not null)
        {
            _movementRequest.ProductVariantId = current.Id;
            _selectedVariantIdString = current.Id.ToString();
        }
        else
        {
            _movementRequest.ProductVariantId = Guid.Empty;
            _selectedVariantIdString = string.Empty;
        }
    }

    private void OnVariantSelectionChanged()
    {
        if (Guid.TryParse(_selectedVariantIdString, out var varGuid))
        {
            _movementRequest.ProductVariantId = varGuid;
        }
    }

    private ProductDetailDto? GetSelectedProduct()
        => _products.FirstOrDefault(p => p.Id == _selectedProductId);

    private ProductVariantDto? GetSelectedVariant(ProductDetailDto? product)
        => product?.Variants.FirstOrDefault(v => v.Id == _movementRequest.ProductVariantId);

    private IEnumerable<ProductVariantDto> GetVariantsOfSelectedProduct()
        => GetSelectedProduct()?.Variants ?? [];

    private static string? ResolveProductCoverUrl(ProductDetailDto? product)
    {
        if (product?.Images is null || product.Images.Count == 0)
            return null;

        return product.Images.FirstOrDefault(i => i.IsPrimary && !string.IsNullOrWhiteSpace(i.PublicUrl))?.PublicUrl
            ?? product.Images.FirstOrDefault(i => !string.IsNullOrWhiteSpace(i.PublicUrl))?.PublicUrl;
    }

    private string? TryResolveProductCoverUrl(Guid productId)
        => ResolveProductCoverUrl(_products.FirstOrDefault(p => p.Id == productId));

    private async Task LoadMovementsAsync()
    {
        try
        {
            Guid? prodFilter = Guid.TryParse(_filterProductId, out var g) ? g : null;
            _movements = await Gateway.GetStockMovementsAsync(productId: prodFilter, limit: 150);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SubmitMovementAsync()
    {
        if (_isSubmitting)
            return;

        _isSubmitting = true;
        _error = null;
        _success = null;
        try
        {
            if (_movementRequest.ProductVariantId == Guid.Empty)
            {
                var selectedProd = GetSelectedProduct();
                if (selectedProd is not null)
                {
                    var existingVar = selectedProd.Variants.FirstOrDefault();
                    if (existingVar is not null)
                    {
                        _movementRequest.ProductVariantId = existingVar.Id;
                    }
                    else if (Gateway.CanManageProducts)
                    {
                        var createdVar = await Gateway.AddVariantAsync(selectedProd.Id, new SaveProductVariantRequest
                        {
                            Color = "Padrão",
                            Size = "Único",
                            ColorHex = "#18181B",
                            InitialStockQuantity = 0,
                            LowStockThreshold = 3,
                            IsActive = true
                        });
                        _movementRequest.ProductVariantId = createdVar.Id;
                        _selectedVariantIdString = createdVar.Id.ToString();
                    }
                }
            }

            if (string.IsNullOrWhiteSpace(_movementRequest.Reason))
            {
                _movementRequest.Reason = _movementRequest.MovementType switch
                {
                    "OUT" => "Venda WhatsApp / Balcão",
                    "ADJUSTMENT" => "Conferência de inventário",
                    _ => "Reposição de estoque"
                };
            }

            var mov = await Gateway.RegisterStockMovementAsync(_movementRequest);
            _products = await Gateway.GetProductsAsync();
            OnProductSelectionChanged();
            await LoadMovementsAsync();
            _success = $"✓ Estoque atualizado de {mov.PreviousQuantity} para {mov.NewQuantity} un.!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
