@page "/produtos/{ProductId:guid}"
@inject MauiAdminGateway Gateway
@inject NavigationManager Navigation

<div class="yl-product-form-stack" style="max-width: 740px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 0.65rem; min-width: 0;">
            <a href="/produtos"
               class="adm-btn adm-btn-outline"
               style="min-height: 42px; padding: 0.35rem 0.85rem; border-radius: 12px; text-decoration: none;">
                ← Produtos
            </a>
            <h1 style="margin: 0; font-size: 1.3rem; font-weight: 800; color: var(--adm-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                @(_product?.Name ?? "Editar Produto")
            </h1>
        </div>

        @if (_product is not null)
        {
            <span class="pill-badge @(_product.IsVisibleOnSite ? "pill-green" : "pill-slate")">
                @(_product.IsVisibleOnSite ? "● No site" : "Oculto")
            </span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert-banner alert-error" style="margin-bottom: 0;">@_error</div>
    }

    @if (!string.IsNullOrWhiteSpace(_success))
    {
        <div class="alert-banner alert-success" style="margin-bottom: 0;">@_success</div>
    }

    @if (_product is not null)
    {
        <!-- 1. FOTOS DO PRODUTO (NO TOPO — IDÊNTICO AO FIGMA APROVADO) -->
        <section class="adm-card" style="margin-bottom: 0; display: flex; flex-direction: column; gap: 0.8rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                <h2 style="font-size: 0.98rem; font-weight: 800; margin: 0; color: var(--adm-text);">Fotos do produto</h2>
                <span style="font-size: 0.82rem; color: var(--adm-muted);">@_product.Images.Count @(_product.Images.Count == 1 ? "foto" : "fotos")</span>
            </div>

            <div class="yl-photo-strip">
                @if (Gateway.CanManageProducts)
                {
                    <button type="button"
                            class="yl-photo-add-tile"
                            @onclick="PickAndUploadDevicePhotoAsync">
                        <span class="yl-photo-add-plus">+</span>
                        <span>Adicionar foto</span>
                    </button>
                }

                @foreach (var img in _product.Images)
                {
                    <div class="yl-photo-thumb">
                        <img src="@WhatsAppLinkBuilder.SanitizeMediaUrl(img.PublicUrl)"
                             alt="@img.AltText"
                             referrerpolicy="no-referrer" />
                        @if (img.IsPrimary)
                        {
                            <span class="yl-photo-cover-badge">Capa</span>
                        }
                        else if (Gateway.CanManageProducts)
                        {
                            <button type="button"
                                    class="yl-photo-cover-btn"
                                    title="Definir como capa"
                                    @onclick="() => SetPrimaryImageAsync(img.Id)">
                                Usar capa
                            </button>
                        }
                        @if (Gateway.CanManageProducts)
                        {
                            <button type="button"
                                    class="yl-photo-remove-btn"
                                    title="Excluir foto"
                                    aria-label="Excluir foto"
                                    @onclick="() => DeleteImageAsync(img.Id)">
                                ✕
                            </button>
                        }
                    </div>
                }
            </div>

            @if (Gateway.CanManageProducts)
            {
                <details style="font-size: 0.85rem;">
                    <summary style="cursor: pointer; color: var(--adm-muted); font-weight: 700; user-select: none;">
                        Ou adicionar foto por link (opcional)
                    </summary>
                    <div style="display: flex; gap: 0.5rem; margin-top: 0.6rem; flex-wrap: wrap;">
                        <input type="url"
                               class="adm-input"
                               style="flex: 1 1 200px; min-height: 44px;"
                               @bind="_newImageUrl"
                               @bind:event="oninput"
                               @onkeydown="HandleImageUrlKeyDown"
                               placeholder="Cole o link da imagem (https://...)" />
                        <button type="button"
                                class="adm-btn adm-btn-outline"
                                style="min-height: 44px;"
                                disabled="@_addingUrlImage"
                                @onclick="AddPhotoByUrlAsync">
                            @(_addingUrlImage ? "Salvando..." : "Adicionar")
                        </button>
                    </div>
                </details>
            }
        </section>

        <!-- 2. INFORMAÇÕES BÁSICAS -->
        <section class="adm-card" style="margin-bottom: 0; display: flex; flex-direction: column; gap: 0.9rem;">
            <h2 style="font-size: 0.98rem; font-weight: 800; margin: 0; color: var(--adm-text);">Informações básicas</h2>

            <div>
                <label class="adm-label">Nome do produto</label>
                <input type="text"
                       class="adm-input"
                       style="min-height: 48px; font-size: 1rem;"
                       @bind="_editProduct.Name"
                       disabled="@(!Gateway.CanManageProducts)" />
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 0.85rem;">
                <div>
                    <label class="adm-label">Preço (R$)</label>
                    <input type="number"
                           step="0.01"
                           class="adm-input"
                           style="min-height: 48px; font-size: 1rem;"
                           @bind="_editProduct.BasePrice"
                           disabled="@(!Gateway.CanManageProducts)" />
                </div>

                <div>
                    <label class="adm-label">Categoria</label>
                    <select class="adm-select"
                            style="min-height: 48px; font-size: 1rem;"
                            @bind="_editCategorySelection"
                            disabled="@(!Gateway.CanManageProducts)">
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Id.ToString()">@cat.Name</option>
                        }
                        <option value="__NEW__">+ Digitar nova categoria...</option>
                    </select>
                    @if ((_editCategorySelection == "__NEW__" || _categories.Count == 0) && Gateway.CanManageProducts)
                    {
                        <input type="text"
                               class="adm-input"
                               style="margin-top: 0.5rem; min-height: 46px;"
                               @bind="_editProduct.CategoryName"
                               placeholder="Nome da nova categoria..." />
                    }
                </div>
            </div>

            <div>
                <label class="adm-label">Descrição do produto (opcional)</label>
                <textarea class="adm-textarea" rows="2" @bind="_editProduct.Description" disabled="@(!Gateway.CanManageProducts)" placeholder="Detalhes, medidas ou observações..."></textarea>
            </div>

            @if (Gateway.CanManageProducts)
            {
                <label style="display: flex; align-items: center; gap: 0.55rem; font-size: 0.94rem; font-weight: 600; color: var(--adm-text); cursor: pointer;">
                    <input type="checkbox" @bind="_editProduct.IsVisibleOnSite" />
                    <span>Exibir este produto na loja online</span>
                </label>

                <button type="button"
                        class="adm-btn adm-btn-success"
                        style="width: 100%; min-height: 50px; font-size: 0.98rem; font-weight: 800; justify-content: center; border-radius: 14px;"
                        @onclick="SaveProductDetailsAsync">
                    Salvar alterações
                </button>
            }
        </section>

        <!-- 3. CORES, TAMANHOS E ESTOQUE (CARTÕES LIMPOS + STEPPER -/+, SEM TABELA ANTIGA) -->
        <section class="adm-card" style="margin-bottom: 0; display: flex; flex-direction: column; gap: 0.85rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                <div>
                    <h2 style="font-size: 0.98rem; font-weight: 800; margin: 0; color: var(--adm-text);">Cores, tamanhos e estoque</h2>
                    <div style="font-size: 0.82rem; color: var(--adm-muted); margin-top: 0.12rem;">
                        Estoque total: <strong>@_product.TotalStockQuantity un.</strong>
                    </div>
                </div>
            </div>

            @if (_product.Variants.Count > 0)
            {
                <div style="display: flex; flex-direction: column; gap: 0.65rem;">
                    @foreach (var v in _product.Variants)
                    {
                        var hasColor = !ClothingStore.Domain.Entities.ProductVariant.IsDefaultPlaceholderColor(v.Color);
                        var hasSize = !ClothingStore.Domain.Entities.ProductVariant.IsDefaultPlaceholderSize(v.Size);
                        var label = hasColor && hasSize
                            ? $"{v.Color} • {v.Size}"
                            : hasColor
                                ? v.Color
                                : hasSize
                                    ? v.Size
                                    : "Padrão";

                        <div class="yl-editor-variant-card">
                            <div class="yl-editor-variant-head">
                                <div class="yl-editor-variant-title">
                                    @if (hasColor)
                                    {
                                        <span style="width: 16px; height: 16px; border-radius: 50%; background: @v.ColorHex; border: 1.5px solid var(--adm-border); display: inline-block; flex-shrink: 0;"></span>
                                    }
                                    <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@label</span>
                                </div>

                                @if (v.IsOutOfStock)
                                {
                                    <span class="pill-badge pill-red">Sem estoque</span>
                                }
                                else if (v.IsLowStock)
                                {
                                    <span class="pill-badge pill-amber">Baixo (@v.StockQuantity un.)</span>
                                }
                                else
                                {
                                    <span class="pill-badge pill-green">@v.StockQuantity un.</span>
                                }
                            </div>

                            <div class="yl-editor-variant-foot">
                                @if (Gateway.CanManageStock)
                                {
                                    <div class="yl-stepper" aria-label="Ajustar quantidade">
                                        <button type="button"
                                                class="yl-stepper-btn"
                                                aria-label="Retirar 1 unidade"
                                                disabled="@(v.StockQuantity <= 0)"
                                                @onclick="() => QuickMovementAsync(v, false)">
                                            −
                                        </button>
                                        <span style="min-width: 38px; text-align: center; font-weight: 800; font-size: 1rem; color: var(--adm-text);">
                                            @v.StockQuantity
                                        </span>
                                        <button type="button"
                                                class="yl-stepper-btn"
                                                aria-label="Adicionar 1 unidade"
                                                @onclick="() => QuickMovementAsync(v, true)">
                                            +
                                        </button>
                                    </div>
                                }

                                @if (Gateway.CanManageProducts)
                                {
                                    <div style="display: flex; align-items: center; gap: 0.45rem; margin-left: auto;">
                                        <button type="button"
                                                class="adm-btn adm-btn-outline"
                                                style="min-height: 42px; padding: 0.35rem 0.85rem; font-size: 0.86rem; font-weight: 700;"
                                                @onclick="() => StartEditVariant(v)">
                                            Editar
                                        </button>
                                        <button type="button"
                                                class="yl-icon-danger-btn"
                                                title="Remover opção"
                                                aria-label="Remover opção"
                                                @onclick="() => DeleteVariantAsync(v)">
                                            🗑️
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Gateway.CanManageProducts)
            {
                <div class="yl-variant-subcard" style="background: var(--adm-input-bg);">
                    <div style="font-weight: 800; font-size: 0.9rem; color: var(--adm-text);">
                        @(_editingVariantId.HasValue ? "Editando opção selecionada" : "+ Adicionar outra cor ou tamanho")
                    </div>

                    <div class="yl-variant-row-top">
                        <input type="text"
                               class="adm-input"
                               style="flex: 1 1 0; min-width: 0; min-height: 46px;"
                               @bind="_variantForm.Color"
                               @bind:event="oninput"
                               @bind:after="OnVariantColorChanged"
                               placeholder="Cor ou modelo (ex.: Preta)" />
                        <input type="color"
                               class="yl-color-dot-picker"
                               title="Escolher cor"
                               aria-label="Cor visual"
                               @bind="_variantForm.ColorHex" />
                    </div>

                    <div class="yl-variant-row-bottom">
                        <input type="text"
                               class="adm-input"
                               style="width: 100%; min-width: 0; min-height: 46px;"
                               @bind="_variantForm.Size"
                               @bind:event="oninput"
                               placeholder="Tamanho (ex.: M)" />
                        <input type="number"
                               min="0"
                               class="adm-input"
                               style="width: 112px; min-height: 46px; text-align: center; font-weight: 700;"
                               placeholder="Qtd."
                               @bind="_variantStockInput" />
                    </div>

                    <details style="font-size: 0.82rem;">
                        <summary style="cursor: pointer; color: var(--adm-muted); font-weight: 600; user-select: none;">
                            Opções avançadas (código e alerta de estoque)
                        </summary>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.6rem; margin-top: 0.55rem;">
                            <div>
                                <label class="adm-label">Código interno (opcional)</label>
                                <input type="text" class="adm-input" @bind="_variantForm.CustomSku" placeholder="Automático" />
                            </div>
                            <div>
                                <label class="adm-label">Avisar quando restar</label>
                                <input type="number" min="0" class="adm-input" @bind="_variantForm.LowStockThreshold" />
                            </div>
                        </div>
                    </details>

                    <div style="display: flex; gap: 0.5rem;">
                        <button type="button"
                                class="yl-add-variant-btn"
                                style="flex: 1;"
                                @onclick="SaveVariantAsync">
                            @(_editingVariantId.HasValue ? "✓ Salvar opção" : "+ Adicionar cor ou tamanho")
                        </button>
                        @if (_editingVariantId.HasValue)
                        {
                            <button type="button"
                                    class="adm-btn adm-btn-outline"
                                    style="min-height: 48px;"
                                    @onclick="CancelEditVariant">
                                Cancelar
                            </button>
                        }
                    </div>
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter]
    public Guid ProductId { get; set; }

    private ProductDetailDto? _product;
    private IReadOnlyList<CategoryDto> _categories = [];
    private SaveProductRequest _editProduct = new();
    private string _editCategorySelection = string.Empty;

    private Guid? _editingVariantId;
    private int? _variantStockInput;
    private SaveProductVariantRequest _variantForm = new()
    {
        ColorHex = "#18181B",
        InitialStockQuantity = 0,
        LowStockThreshold = 3,
        IsActive = true
    };

    private string _newImageUrl = string.Empty;
    private bool _addingUrlImage;
    private string? _error;
    private string? _success;

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductAsync();
    }

    private async Task LoadProductAsync()
    {
        _error = null;
        try
        {
            _categories = await Gateway.GetCategoriesAsync();
            _product = await Gateway.GetProductByIdAsync(ProductId);
            _editCategorySelection = _product.CategoryId.ToString();
            _editProduct = new SaveProductRequest
            {
                CategoryId = _product.CategoryId,
                Name = _product.Name,
                Description = _product.Description,
                BasePrice = _product.BasePrice,
                IsVisibleOnSite = _product.IsVisibleOnSite
            };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SaveProductDetailsAsync()
    {
        _error = null;
        _success = null;
        try
        {
            if (_editCategorySelection == "__NEW__" || _categories.Count == 0)
            {
                _editProduct.CategoryId = Guid.Empty;
                if (string.IsNullOrWhiteSpace(_editProduct.CategoryName))
                {
                    _error = "Digite o nome da nova categoria ou selecione uma categoria existente.";
                    return;
                }
            }
            else if (Guid.TryParse(_editCategorySelection, out var selectedCatId))
            {
                _editProduct.CategoryId = selectedCatId;
                _editProduct.CategoryName = null;
            }

            _product = await Gateway.UpdateProductAsync(ProductId, _editProduct);
            _categories = await Gateway.GetCategoriesAsync();
            _editCategorySelection = _product.CategoryId.ToString();
            _success = "Dados do produto atualizados e sincronizados com o catálogo!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void StartEditVariant(ProductVariantDto variant)
    {
        _editingVariantId = variant.Id;
        _variantStockInput = variant.StockQuantity;
        _variantForm = new SaveProductVariantRequest
        {
            Color = variant.Color,
            ColorHex = variant.ColorHex,
            Size = variant.Size,
            CustomSku = variant.Sku,
            InitialStockQuantity = variant.StockQuantity,
            UpdateStockQuantity = true,
            LowStockThreshold = variant.LowStockThreshold,
            IsActive = variant.IsActive
        };
    }

    private void CancelEditVariant()
    {
        _editingVariantId = null;
        _variantStockInput = null;
        _variantForm = new SaveProductVariantRequest
        {
            ColorHex = "#18181B",
            InitialStockQuantity = 0,
            LowStockThreshold = 3,
            IsActive = true
        };
    }

    private void OnVariantColorChanged()
    {
        if (!string.IsNullOrWhiteSpace(_variantForm.Color))
        {
            _variantForm.ColorHex = ClothingStore.Domain.Entities.ProductVariant.ResolveDefaultColorHex(_variantForm.Color);
        }
    }

    private async Task SaveVariantAsync()
    {
        _error = null;
        _success = null;
        try
        {
            _variantForm.InitialStockQuantity = Math.Max(0, _variantStockInput ?? 0);
            if (_editingVariantId.HasValue)
            {
                await Gateway.UpdateVariantAsync(_editingVariantId.Value, _variantForm);
                _success = "Variante atualizada com sucesso!";
            }
            else
            {
                await Gateway.AddVariantAsync(ProductId, _variantForm);
                _success = "Nova variante adicionada ao produto!";
            }

            CancelEditVariant();
            await LoadProductAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteVariantAsync(ProductVariantDto variant)
    {
        _error = null;
        _success = null;
        try
        {
            await Gateway.DeleteVariantAsync(variant.Id);
            await LoadProductAsync();
            _success = $"Variante {variant.Color}/{variant.Size} removida.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task QuickMovementAsync(ProductVariantDto variant, bool isEntry)
    {
        _error = null;
        _success = null;
        try
        {
            await Gateway.RegisterStockMovementAsync(new CreateStockMovementRequest
            {
                ProductVariantId = variant.Id,
                MovementType = isEntry ? "IN" : "OUT",
                Quantity = 1,
                Reason = isEntry ? "Entrada rápida na tela do produto" : "Saída rápida na tela do produto"
            });
            await LoadProductAsync();
            _success = $"Estoque da variante {variant.Color}/{variant.Size} atualizado!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PickAndUploadDevicePhotoAsync()
    {
        _error = null;
        _success = null;
        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Selecione uma fotografia do produto",
                FileTypes = FilePickerFileType.Images
            });

            if (result is null)
                return;

            await using var rawStream = await result.OpenReadAsync();
            await using var optimized = await appmaui.blazor.Services.DeviceImageCompressor.OptimizeForUploadAsync(
                rawStream,
                result.FileName,
                result.ContentType,
                maxDimension: 1200,
                preservePngFormat: false);

            await Gateway.UploadProductImageFileAsync(
                ProductId,
                optimized.FileName,
                optimized.Stream,
                optimized.ContentType,
                _product?.Name,
                _product?.Images.Count == 0);

            await LoadProductAsync();
            _success = optimized.FinalBytes < optimized.OriginalBytes
                ? $"Fotografia otimizada ({optimized.OriginalBytes / 1024} KB → {optimized.FinalBytes / 1024} KB) e enviada com sucesso!"
                : "Fotografia enviada e vinculada ao produto com sucesso!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task HandleImageUrlKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddPhotoByUrlAsync();
        }
    }

    private async Task AddPhotoByUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_newImageUrl) || _addingUrlImage)
            return;

        _error = null;
        _success = null;
        _addingUrlImage = true;
        try
        {
            await Gateway.AddProductImageByUrlAsync(ProductId, new AddProductImageByUrlRequest
            {
                ImageUrl = _newImageUrl,
                AltText = _product?.Name,
                IsPrimary = _product?.Images.Count == 0
            });
            _newImageUrl = string.Empty;
            await LoadProductAsync();
            _success = "Fotografia adicionada à galeria do produto!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _addingUrlImage = false;
        }
    }

    private async Task SetPrimaryImageAsync(Guid imageId)
    {
        _error = null;
        _success = null;
        try
        {
            await Gateway.SetPrimaryProductImageAsync(ProductId, imageId);
            await LoadProductAsync();
            _success = "Fotografia principal (capa) atualizada!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteImageAsync(Guid imageId)
    {
        _error = null;
        _success = null;
        try
        {
            await Gateway.DeleteProductImageAsync(ProductId, imageId);
            await LoadProductAsync();
            _success = "Fotografia removida do produto.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}

