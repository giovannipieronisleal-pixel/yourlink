@using ClothingStore.Application.Services
@using ClothingStore.Domain.Common
@inject MauiAdminGateway Gateway
@inject NavigationManager Navigation

@if (IsOpen)
{
    <div class="adm-modal-overlay" style="z-index: 9999;">
        <div class="adm-card adm-modal-card" style="max-width: 620px; box-shadow: 0 25px 60px rgba(0,0,0,0.5); border: 2px solid var(--adm-border);">
            <!-- Header do Modal -->
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; margin-bottom: 1.25rem;">
                <div style="display: flex; align-items: center; gap: 0.85rem; min-width: 0; flex: 1;">
                    <div style="width: 48px; height: 48px; flex-shrink: 0; border-radius: 50%; background: var(--adm-accent); color: #fff; font-size: 1.25rem; font-weight: 800; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.25);">
                        @GetInitials(Gateway.CurrentEmployee?.FullName)
                    </div>
                    <div style="min-width: 0;">
                        <h2 style="font-size: 1.2rem; font-weight: 800; margin: 0; color: var(--adm-text); overflow-wrap: anywhere;">
                            @(Gateway.CurrentEmployee?.FullName ?? "Meu Perfil")
                        </h2>
                        <div style="display: flex; align-items: center; gap: 0.45rem; margin-top: 0.2rem; font-size: 0.8rem; color: var(--adm-muted); flex-wrap: wrap; overflow-wrap: anywhere;">
                            <span>Usuário: <strong>@(Gateway.CurrentEmployee?.EffectiveUsername)</strong></span>
                            <span>&bull;</span>
                            <span>Gmail: <strong>@(Gateway.CurrentEmployee?.Email)</strong></span>
                            <span>&bull;</span>
                            <span class="pill-badge @(Gateway.IsAdmin ? "pill-green" : "pill-slate")" style="font-size: 0.72rem; padding: 0.1rem 0.4rem;">
                                @(Gateway.IsAdmin ? "Administrador" : "Lojista")
                            </span>
                        </div>
                    </div>
                </div>

                <button type="button"
                        aria-label="Fechar perfil"
                        style="flex-shrink: 0; min-width: 36px; min-height: 36px; border-radius: 8px; background: var(--adm-surface-subtle); border: 1px solid var(--adm-border); font-size: 1.15rem; line-height: 1; cursor: pointer; color: var(--adm-text); display: inline-flex; align-items: center; justify-content: center;"
                        @onclick="Close">
                    ✕
                </button>
            </div>

            <!-- Abas de Navegação -->
            <div style="display: flex; gap: 0.35rem; background: var(--adm-input-bg); border-radius: 10px; padding: 4px; margin-bottom: 1.25rem; border: 1px solid var(--adm-border); flex-wrap: wrap;">
                <button type="button"
                        class="adm-btn @(_currentTab == "profile" ? "adm-btn-primary" : "adm-btn-outline")"
                        style="flex: 1 1 auto; border: none; padding: 0.52rem 0.65rem; font-size: 0.82rem; font-weight: 700; white-space: nowrap;"
                        @onclick='() => SetTab("profile")'>
                    👤 Meus Dados
                </button>
                <button type="button"
                        class="adm-btn @(_currentTab == "password" ? "adm-btn-primary" : "adm-btn-outline")"
                        style="flex: 1 1 auto; border: none; padding: 0.52rem 0.65rem; font-size: 0.82rem; font-weight: 700; white-space: nowrap;"
                        @onclick='() => SetTab("password")'>
                    🔑 Senha
                </button>
                <button type="button"
                        class="adm-btn @(_currentTab == "2fa" ? "adm-btn-primary" : "adm-btn-outline")"
                        style="flex: 1 1 auto; border: none; padding: 0.52rem 0.65rem; font-size: 0.82rem; font-weight: 700; white-space: nowrap;"
                        @onclick='() => SetTab("2fa")'>
                    🛡️ 2FA (Dois Fatores)
                </button>
            </div>

            <!-- Alertas -->
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert-banner alert-error" style="margin-bottom: 1rem;">@_error</div>
            }

            @if (!string.IsNullOrWhiteSpace(_success))
            {
                <div class="alert-banner alert-success" style="margin-bottom: 1rem;">@_success</div>
            }

            @* ========================================== *@
            @* ABA 1: MEUS DADOS                          *@
            @* ========================================== *@
            @if (_currentTab == "profile")
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div>
                        <label class="adm-label">Nome Completo *</label>
                        <input type="text" class="adm-input" @bind="_profileFullName" />
                    </div>

                    <div>
                        <label class="adm-label">Usuário de Acesso *</label>
                        <input type="text" class="adm-input" @bind="_profileUsername" placeholder="Ex.: seu.usuario" />
                    </div>

                    <div>
                        <label class="adm-label">Gmail / E-mail (usado para alterar sua senha) *</label>
                        <input type="email" class="adm-input" @bind="_profileEmail" placeholder="Ex.: seu.nome@gmail.com" />
                    </div>

                    <div>
                        @{
                            var profileWaCheck = WhatsAppLinkBuilder.ValidateBrazilianWhatsAppNumber(_profilePhone);
                            var hasProfilePhone = !string.IsNullOrWhiteSpace(_profilePhone);
                            var isProfileWaVerified = profileWaCheck.IsValid &&
                                                      !string.IsNullOrWhiteSpace(_verifiedProfileWhatsapp) &&
                                                      string.Equals(profileWaCheck.NormalizedNumber, _verifiedProfileWhatsapp, StringComparison.Ordinal);
                        }
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.35rem;">
                            <label class="adm-label" style="margin: 0;">Telefone / WhatsApp</label>
                            @if (hasProfilePhone)
                            {
                                <span class="pill-badge @(isProfileWaVerified ? "pill-green" : "pill-amber")">
                                    @(isProfileWaVerified ? $"✓ WhatsApp Autenticado ({profileWaCheck.FormattedDisplay})" : "⚠️ Não autenticado")
                                </span>
                            }
                        </div>
                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                            <input type="text"
                                   class="adm-input"
                                   style="flex: 1 1 190px; min-width: 0;"
                                   @bind="_profilePhone"
                                   @bind:event="oninput"
                                   @bind:after="OnProfilePhoneChanged"
                                   placeholder="Ex.: 11999990000" />
                            <button type="button"
                                    class="adm-btn @(isProfileWaVerified ? "adm-btn-outline" : "adm-btn-success")"
                                    style="white-space: nowrap;"
                                    disabled="@_isBusy"
                                    @onclick="SendProfileWhatsappVerificationCodeAsync">
                                @(isProfileWaVerified ? "🔄 Reconfirmar por E-mail" : "📧 Confirmar por E-mail")
                            </button>
                        </div>
                        <span style="font-size: 0.78rem; color: var(--adm-muted); display: block; margin-top: 0.3rem;">
                            Para salvar um número de WhatsApp no perfil, confirme o código de 6 dígitos enviado para o seu e-mail.
                        </span>

                        @if (!string.IsNullOrWhiteSpace(_profileWaFeedback))
                        {
                            <div style="margin-top: 0.45rem; font-size: 0.82rem; font-weight: 600; color: @(_profileWaFeedbackOk ? "var(--adm-success)" : "var(--adm-danger)");">
                                @_profileWaFeedback
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_pendingProfileWaEmail))
                        {
                            <div style="margin-top: 0.65rem; padding: 0.85rem; border-radius: 10px; border: 1.5px solid var(--adm-success); background: rgba(22, 163, 74, 0.08); display: flex; flex-direction: column; gap: 0.6rem;">
                                <div style="font-size: 0.84rem; color: var(--adm-text); line-height: 1.45;">
                                    📧 <strong>Digite o código de 6 dígitos enviado para o seu e-mail</strong> para confirmar o número <strong>@(profileWaCheck.IsValid ? profileWaCheck.FormattedDisplay : _profilePhone)</strong>:
                                </div>
                                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                                    <input type="text"
                                           maxlength="6"
                                           class="adm-input"
                                           style="max-width: 160px; font-family: monospace; font-weight: 800; font-size: 1.05rem; letter-spacing: 0.18em; text-align: center;"
                                           @bind="_profileWaCodeInput"
                                           @bind:event="oninput"
                                           placeholder="000000" />
                                    <button type="button"
                                            class="adm-btn adm-btn-success"
                                            style="font-weight: 700;"
                                            disabled="@_isBusy"
                                            @onclick="ConfirmProfileWhatsappVerificationCodeAsync">
                                        ✓ Confirmar Código
                                    </button>
                                    <button type="button"
                                            class="adm-btn adm-btn-outline"
                                            disabled="@_isBusy"
                                            @onclick="SendProfileWhatsappVerificationCodeAsync">
                                        Reenviar E-mail
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <button type="button"
                            class="adm-btn adm-btn-primary"
                            style="padding: 0.8rem; font-weight: 700; margin-top: 0.25rem;"
                            disabled="@_isBusy"
                            @onclick="SaveProfileAsync">
                        @(_isBusy ? "Salvando..." : "💾 Salvar Alterações de Perfil")
                    </button>
                </div>
            }
            else if (_currentTab == "password")
            {
                @* ========================================== *@
                @* ABA 2: ALTERAR SENHA APENAS POR E-MAIL     *@
                @* ========================================== *@
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div style="padding: 0.85rem; background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; font-size: 0.84rem; color: var(--adm-muted); line-height: 1.45;">
                        🔒 <strong>Alteração Exclusiva via E-mail:</strong> Apenas você pode alterar a sua senha através do código de verificação enviado para o seu Gmail cadastrado:
                        <strong style="color: var(--adm-text); display: block; margin-top: 0.25rem;">@(_profileEmail)</strong>
                    </div>

                    <button type="button"
                            class="adm-btn adm-btn-outline"
                            style="padding: 0.75rem; font-weight: 700; border-color: var(--adm-accent);"
                            disabled="@_isBusy"
                            @onclick="RequestPasswordResetCodeToEmailAsync">
                        @(_isBusy ? "Enviando código..." : "📧 Enviar Código de Alteração para Meu Gmail")
                    </button>

                    @if (_passwordResetCodeSent)
                    {
                        <div style="font-size: 0.8rem; color: var(--adm-success);">
                            ✓ Código enviado! Verifique seu Gmail (ou a caixa local em ambiente de desenvolvimento) e informe abaixo:
                        </div>
                    }

                    <div>
                        <label class="adm-label">Código Recebido no Gmail (6 dígitos) *</label>
                        <input type="text" class="adm-input" @bind="_pwdEmailCode" placeholder="Ex.: 123456" maxlength="10" />
                    </div>

                    <div>
                        <label class="adm-label">Nova Senha (mínimo 4 caracteres) *</label>
                        <input type="password" class="adm-input" @bind="_pwdNew" placeholder="Digite a nova senha" />
                    </div>

                    <div>
                        <label class="adm-label">Confirmar Nova Senha *</label>
                        <input type="password" class="adm-input" @bind="_pwdConfirm" placeholder="Repita a nova senha" />
                    </div>

                    <button type="button"
                            class="adm-btn adm-btn-primary"
                            style="padding: 0.8rem; font-weight: 700; margin-top: 0.25rem;"
                            disabled="@_isBusy"
                            @onclick="ChangePasswordViaEmailAsync">
                        @(_isBusy ? "Atualizando..." : "🔑 Confirmar Código e Alterar Senha")
                    </button>
                </div>
            }
            else if (_currentTab == "2fa")
            {
                @* ========================================== *@
                @* ABA 3: AUTENTICAÇÃO EM 2 FATORES (2FA)     *@
                @* ========================================== *@
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <!-- Card de Status do 2FA -->
                    <div style="background: var(--adm-input-bg); border: 1.5px solid var(--adm-border); border-radius: 10px; padding: 1rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                            <strong style="font-size: 1rem; color: var(--adm-text);">Verificação em Duas Etapas (2FA)</strong>
                            <span class="pill-badge @(Gateway.CurrentEmployee?.HasTwoFactorEnabled == true ? "pill-green" : "pill-slate")">
                                @(Gateway.CurrentEmployee?.HasTwoFactorEnabled == true ? "🟢 Ativado (Protegido)" : "⚪ Desativado")
                            </span>
                        </div>
                        <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0; line-height: 1.45;">
                            Compatível com <strong>Google Authenticator</strong>, <strong>Microsoft Authenticator</strong> e <strong>Authy</strong>.
                            Ao ativar, você precisará de um código dinâmico a cada login, impedindo invasões mesmo que descubram sua senha.
                        </p>
                    </div>

                    @if (Gateway.CurrentEmployee?.HasTwoFactorEnabled == true)
                    {
                        <!-- CONTA JÁ PROTEGIDA -->
                        <div style="padding: 1.25rem; background: rgba(34, 197, 94, 0.08); border: 1px solid var(--adm-success); border-radius: 10px; text-align: center;">
                            <div style="font-size: 2.2rem; margin-bottom: 0.35rem;">🛡️</div>
                            <strong style="color: var(--adm-success); font-size: 1rem; display: block;">Sua conta está 100% protegida com 2FA!</strong>
                            <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0.35rem 0 0;">
                                O login no sistema exige senha + código temporário de 6 dígitos.
                            </p>
                        </div>

                        <!-- Opção para desativar -->
                        <div style="border-top: 1px solid var(--adm-border); padding-top: 1rem; margin-top: 0.5rem;">
                            <label class="adm-label">Para desativar o 2FA, digite sua senha atual:</label>
                            <input type="password" class="adm-input" @bind="_disableTwoFactorPassword" placeholder="Sua senha atual" />
                            <button type="button"
                                    class="adm-btn adm-btn-danger"
                                    style="margin-top: 0.75rem; width: 100%; padding: 0.75rem; font-weight: 700;"
                                    disabled="@_isBusy"
                                    @onclick="DisableTwoFactorAsync">
                                @(_isBusy ? "Desativando..." : "Desativar Autenticação em 2 Etapas")
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- PROCESSO DE ATIVAÇÃO DO 2FA -->
                        @if (_twoFactorSetup is null)
                        {
                            <button type="button"
                                    class="adm-btn adm-btn-primary"
                                    style="padding: 0.85rem; font-size: 0.95rem; font-weight: 700;"
                                    disabled="@_isBusy"
                                    @onclick="StartTwoFactorSetupAsync">
                                @(_isBusy ? "Gerando chaves..." : "⚡ Iniciar Configuração do 2FA Agora")
                            </button>
                        }
                        else
                        {
                            <!-- Passo 1: Chave Secreta & QR Code -->
                            <div style="display: flex; flex-direction: column; gap: 0.75rem; background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 1rem;">
                                <strong style="color: var(--adm-text); font-size: 0.92rem;">
                                    1. Adicione a chave no seu aplicativo autenticador
                                </strong>
                                <p style="font-size: 0.8rem; color: var(--adm-muted); margin: 0;">
                                    Abra o Google Authenticator ou Microsoft Authenticator no celular, escolha "Inserir chave de configuração" e cole a chave abaixo:
                                </p>

                                <div style="display: flex; gap: 0.5rem; align-items: center;">
                                    <input type="text"
                                           class="adm-input"
                                           readonly
                                           value="@_twoFactorSetup.SecretKey"
                                           style="font-family: monospace; font-size: 1.1rem; font-weight: 800; letter-spacing: 0.15em; text-align: center; color: var(--adm-accent);" />
                                    <button type="button" class="adm-btn adm-btn-outline" @onclick="CopySecretKeyAsync">
                                        @(_copiedSecret ? "✓ Copiado" : "Copiar")
                                    </button>
                                </div>
                            </div>

                            <!-- Passo 2: Códigos de Emergência / Backup -->
                            <div style="background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 1rem;">
                                <strong style="color: var(--adm-text); font-size: 0.92rem; display: block; margin-bottom: 0.35rem;">
                                    2. Códigos de Recuperação de Emergência
                                </strong>
                                <p style="font-size: 0.78rem; color: var(--adm-muted); margin: 0 0 0.5rem;">
                                    Guarde estes 4 códigos em um lugar seguro. Eles permitem entrar se você perder o celular:
                                </p>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem;">
                                    @foreach (var backupCode in _twoFactorSetup.BackupCodes)
                                    {
                                        <div style="background: var(--adm-surface); border: 1px solid var(--adm-border); padding: 0.45rem; border-radius: 6px; font-family: monospace; font-size: 0.88rem; font-weight: 700; text-align: center; color: var(--adm-text);">
                                            @backupCode
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Passo 3: Confirmar com Código de 6 Dígitos -->
                            <div>
                                <label class="adm-label">3. Digite o código de 6 dígitos gerado no app para confirmar:</label>
                                <input type="text"
                                       class="adm-input"
                                       maxlength="6"
                                       style="font-size: 1.4rem; text-align: center; letter-spacing: 0.3em; font-family: monospace; font-weight: 800;"
                                       @bind="_twoFactorVerifyCode"
                                       placeholder="000000" />
                            </div>

                            <button type="button"
                                    class="adm-btn adm-btn-success"
                                    style="padding: 0.85rem; font-size: 0.95rem; font-weight: 800;"
                                    disabled="@_isBusy"
                                    @onclick="ConfirmAndEnableTwoFactorAsync">
                                @(_isBusy ? "Ativando..." : "🛡️ Confirmar e Ativar 2FA na Minha Conta")
                            </button>
                        }
                    }
                </div>
            }

            <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--adm-border); display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                <button type="button"
                        class="adm-btn adm-btn-danger"
                        style="min-height: 42px; font-weight: 700;"
                        @onclick="LogoutAndSwitchAccountAsync">
                    🚪 Sair / Trocar de Conta
                </button>
                <button type="button"
                        class="adm-btn adm-btn-outline"
                        style="min-height: 42px;"
                        @onclick="Close">
                    Fechar
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnLogoutRequested { get; set; }

    private string _currentTab = "profile";
    private bool _isBusy;
    private string? _error;
    private string? _success;

    // Perfil
    private string _profileFullName = string.Empty;
    private string _profileUsername = string.Empty;
    private string _profileEmail = string.Empty;
    private string _profilePhone = string.Empty;
    private string? _verifiedProfileWhatsapp;
    private string? _pendingProfileWaEmail;
    private string? _pendingProfileWaTarget;
    private string _profileWaCodeInput = string.Empty;
    private string? _profileWaFeedback;
    private bool _profileWaFeedbackOk;

    // Senha (exclusivo via código no e-mail)
    private bool _passwordResetCodeSent;
    private string _pwdEmailCode = string.Empty;
    private string _pwdNew = string.Empty;
    private string _pwdConfirm = string.Empty;

    // 2FA
    private TwoFactorSetupDto? _twoFactorSetup;
    private string _twoFactorVerifyCode = string.Empty;
    private bool _copiedSecret;
    private string _disableTwoFactorPassword = string.Empty;
    private bool _wasOpen;

    private string GetVerifiedWhatsappPreferenceKey() =>
        $"youlink_verified_whatsapp_v1_{Gateway.CurrentWorkspaceId}";

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _error = null;
            _success = null;
            _profileFullName = Gateway.CurrentEmployee?.FullName ?? "";
            _profileUsername = Gateway.CurrentEmployee?.EffectiveUsername ?? "";
            _profileEmail = Gateway.CurrentEmployee?.Email ?? "";
            _profilePhone = Gateway.CurrentEmployee?.Phone ?? "";
            _pendingProfileWaEmail = null;
            _pendingProfileWaTarget = null;
            _profileWaCodeInput = string.Empty;
            _profileWaFeedback = null;
            try
            {
                _verifiedProfileWhatsapp = Preferences.Default.Get(GetVerifiedWhatsappPreferenceKey(), string.Empty);
            }
            catch
            {
                _verifiedProfileWhatsapp = null;
            }
        }

        _wasOpen = IsOpen;
    }

    private void OnProfilePhoneChanged()
    {
        _profileWaFeedback = null;
        var currentNormalized = WhatsAppLinkBuilder.ValidateBrazilianWhatsAppNumber(_profilePhone).NormalizedNumber;
        if (!string.Equals(currentNormalized, _pendingProfileWaTarget, StringComparison.Ordinal))
        {
            _pendingProfileWaEmail = null;
            _profileWaCodeInput = string.Empty;
        }
    }

    private async Task SendProfileWhatsappVerificationCodeAsync()
    {
        _error = null;
        _success = null;
        _profileWaFeedback = null;

        var check = WhatsAppLinkBuilder.ValidateBrazilianWhatsAppNumber(_profilePhone);
        if (!check.IsValid)
        {
            _profileWaFeedbackOk = false;
            _profileWaFeedback = "⚠️ " + check.Message;
            return;
        }

        var recipientEmail = !string.IsNullOrWhiteSpace(Gateway.CurrentEmployee?.Email)
            ? Gateway.CurrentEmployee!.Email.Trim()
            : _profileEmail.Trim();

        if (string.IsNullOrWhiteSpace(recipientEmail))
        {
            _profileWaFeedbackOk = false;
            _profileWaFeedback = "⚠️ Informe um Gmail / E-mail válido no seu perfil para receber o código de verificação.";
            return;
        }

        _profilePhone = check.NormalizedNumber;
        _pendingProfileWaTarget = check.NormalizedNumber;
        _profileWaCodeInput = string.Empty;
        _isBusy = true;

        try
        {
            var resp = await Gateway.SendEmailVerificationCodeAsync(
                recipientEmail,
                purpose: "profile_whatsapp_verification",
                contextLabel: $"confirmação do WhatsApp do perfil ({check.FormattedDisplay})");

            if (resp.Sent)
            {
                _pendingProfileWaEmail = recipientEmail;
                _profileWaFeedbackOk = true;
                _profileWaFeedback = "📧 " + resp.Message;
            }
            else
            {
                _pendingProfileWaEmail = null;
                _profileWaFeedbackOk = false;
                _profileWaFeedback = "⚠️ " + resp.Message;
            }
        }
        catch (Exception ex)
        {
            _pendingProfileWaEmail = null;
            _profileWaFeedbackOk = false;
            _profileWaFeedback = "⚠️ " + ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ConfirmProfileWhatsappVerificationCodeAsync()
    {
        _error = null;
        _success = null;

        var typed = WhatsAppLinkBuilder.SanitizePhoneNumber(_profileWaCodeInput);
        var recipientEmail = !string.IsNullOrWhiteSpace(_pendingProfileWaEmail)
            ? _pendingProfileWaEmail
            : !string.IsNullOrWhiteSpace(Gateway.CurrentEmployee?.Email)
                ? Gateway.CurrentEmployee!.Email.Trim()
                : _profileEmail.Trim();

        if (string.IsNullOrWhiteSpace(recipientEmail) || typed.Length != 6)
        {
            _profileWaFeedbackOk = false;
            _profileWaFeedback = "❌ Digite os 6 dígitos do código enviado para o seu e-mail.";
            return;
        }

        var check = WhatsAppLinkBuilder.ValidateBrazilianWhatsAppNumber(_profilePhone);
        if (!check.IsValid)
        {
            _profileWaFeedbackOk = false;
            _profileWaFeedback = "⚠️ " + check.Message;
            return;
        }

        _isBusy = true;
        try
        {
            var verify = await Gateway.VerifyEmailVerificationCodeAsync(
                recipientEmail,
                typed,
                purpose: "profile_whatsapp_verification");

            if (!verify.Verified)
            {
                _profileWaFeedbackOk = false;
                _profileWaFeedback = "❌ " + verify.Message;
                return;
            }

            _verifiedProfileWhatsapp = check.NormalizedNumber;
            _profilePhone = check.NormalizedNumber;
            _pendingProfileWaEmail = null;
            _profileWaCodeInput = string.Empty;
            try
            {
                Preferences.Default.Set(GetVerifiedWhatsappPreferenceKey(), check.NormalizedNumber);
            }
            catch
            {
            }

            _profileWaFeedbackOk = true;
            _profileWaFeedback = $"✅ WhatsApp {check.FormattedDisplay} confirmado por e-mail!";
        }
        catch (Exception ex)
        {
            _profileWaFeedbackOk = false;
            _profileWaFeedback = "❌ " + ex.Message;
            return;
        }
        finally
        {
            _isBusy = false;
        }

        await SaveProfileAsync();
    }

    private void SetTab(string tab)
    {
        _currentTab = tab;
        _error = null;
        _success = null;
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task LogoutAndSwitchAccountAsync()
    {
        await Close();
        if (OnLogoutRequested.HasDelegate)
        {
            await OnLogoutRequested.InvokeAsync();
        }
        else
        {
            Gateway.Logout();
            Navigation.NavigateTo("/");
        }
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "U";

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpperInvariant();

        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpperInvariant();
    }

    private async Task SaveProfileAsync()
    {
        _error = null;
        _success = null;

        if (!string.IsNullOrWhiteSpace(_profilePhone))
        {
            var waCheck = WhatsAppLinkBuilder.ValidateBrazilianWhatsAppNumber(_profilePhone);
            if (!waCheck.IsValid)
            {
                _error = waCheck.Message;
                _profileWaFeedbackOk = false;
                _profileWaFeedback = "⚠️ " + waCheck.Message;
                return;
            }

            var isVerified = !string.IsNullOrWhiteSpace(_verifiedProfileWhatsapp) &&
                             string.Equals(waCheck.NormalizedNumber, _verifiedProfileWhatsapp, StringComparison.Ordinal);

            if (!isVerified)
            {
                _error = "Não é possível salvar este Telefone / WhatsApp sem antes confirmá-lo pelo código de 6 dígitos enviado para o seu e-mail. Toque em '📧 Confirmar por E-mail'.";
                _profileWaFeedbackOk = false;
                _profileWaFeedback = "⚠️ Confirme este número pelo código enviado ao seu e-mail antes de salvar.";
                return;
            }

            _profilePhone = waCheck.NormalizedNumber;
        }

        _isBusy = true;
        try
        {
            await Gateway.UpdateUserProfileAsync(new UpdateUserProfileRequest(_profileFullName, _profileEmail, _profilePhone, _profileUsername));
            _success = "✓ Dados de perfil atualizados com sucesso!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RequestPasswordResetCodeToEmailAsync()
    {
        _error = null;
        _success = null;
        _isBusy = true;
        try
        {
            var loginOrEmail = !string.IsNullOrWhiteSpace(Gateway.CurrentEmployee?.Email)
                ? Gateway.CurrentEmployee!.Email
                : _profileEmail;

            var resp = await Gateway.ForgotPasswordAsync(new ForgotPasswordRequest(loginOrEmail));
            _passwordResetCodeSent = true;
            _success = "📧 " + resp.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ChangePasswordViaEmailAsync()
    {
        _error = null;
        _success = null;

        if (string.IsNullOrWhiteSpace(_pwdEmailCode))
        {
            _error = "Informe o código de 6 dígitos enviado para o seu Gmail.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_pwdNew) || _pwdNew.Length < 4)
        {
            _error = "A nova senha deve ter no mínimo 4 caracteres.";
            return;
        }

        if (_pwdNew != _pwdConfirm)
        {
            _error = "A confirmação da nova senha não confere.";
            return;
        }

        _isBusy = true;
        try
        {
            var loginOrEmail = !string.IsNullOrWhiteSpace(Gateway.CurrentEmployee?.Email)
                ? Gateway.CurrentEmployee!.Email
                : _profileEmail;

            await Gateway.ResetPasswordAsync(new ResetPasswordRequest(loginOrEmail, _pwdEmailCode.Trim(), _pwdNew));
            _pwdEmailCode = string.Empty;
            _pwdNew = string.Empty;
            _pwdConfirm = string.Empty;
            _passwordResetCodeSent = false;
            _success = "✓ Senha alterada com sucesso via código de e-mail!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

