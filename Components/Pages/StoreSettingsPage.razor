    private void OnWhatsappInputChanged()
    {
        _whatsappAuthFeedback = null;
        var check = WhatsAppLinkBuilder.ValidateBrazilianWhatsAppNumber(_form.WhatsappNumber);
        if (!check.IsValid || !string.Equals(check.NormalizedNumber, _pendingWhatsappNormalizedTarget, StringComparison.Ordinal))
        {
            _pendingWhatsappVerificationCode = null;
            _whatsappVerificationCodeInput = string.Empty;
        }
    }

    private async Task SendWhatsappVerificationCodeAsync()
    {
        _whatsappAuthFeedback = null;
        _error = null;

        var check = WhatsAppLinkBuilder.ValidateBrazilianWhatsAppNumber(_form.WhatsappNumber);
        if (!check.IsValid)
        {
            _whatsappAuthFeedbackOk = false;
            _whatsappAuthFeedback = "⚠️ " + check.Message;
            return;
        }

        _form.WhatsappNumber = check.NormalizedNumber;
        _pendingWhatsappNormalizedTarget = check.NormalizedNumber;
        _pendingWhatsappVerificationCode = WhatsAppLinkBuilder.GenerateSupportWhatsAppVerificationCode(check.NormalizedNumber);
        _whatsappVerificationCodeInput = string.Empty;

        var catalog = await Gateway.TryLoadPublicPlatformCatalogAsync();
        var supportUrl = WhatsAppLinkBuilder.BuildSupportVerificationRequestLink(
            catalog?.SupportWhatsappNumber,
            check.NormalizedNumber,
            _form.StoreName);

        if (!string.IsNullOrWhiteSpace(supportUrl))
        {
            await Gateway.OpenExternalUrlSafeAsync(supportUrl);
            _whatsappAuthFeedbackOk = true;
            _whatsappAuthFeedback = $"📲 Abrimos o WhatsApp oficial de Suporte! Envie a mensagem pronta pelo número {check.FormattedDisplay} para receber seu código de 4 dígitos e digite-o abaixo.";
        }
        else
        {
            _whatsappAuthFeedbackOk = false;
            _whatsappAuthFeedback = "⚠️ O número oficial de WhatsApp do Suporte ainda não foi configurado no servidor. Peça ao suporte o código de 4 dígitos para o seu número e digite abaixo.";
        }
    }

    private async Task ConfirmWhatsappVerificationCodeAsync()
    {
        _error = null;
        var typed = WhatsAppLinkBuilder.SanitizePhoneNumber(_whatsappVerificationCodeInput);
        if (string.IsNullOrWhiteSpace(_pendingWhatsappVerificationCode) ||
            !string.Equals(typed, _pendingWhatsappVerificationCode, StringComparison.Ordinal))
        {
            _whatsappAuthFeedbackOk = false;
            _whatsappAuthFeedback = "❌ Código incorreto. Confira os 4 dígitos na mensagem que abriu no seu WhatsApp.";
            return;
        }

        var check = WhatsAppLinkBuilder.ValidateBrazilianWhatsAppNumber(_form.WhatsappNumber);
        if (!check.IsValid)
        {
            _whatsappAuthFeedbackOk = false;
            _whatsappAuthFeedback = "⚠️ " + check.Message;
            return;
        }

        _verifiedWhatsappNumber = check.NormalizedNumber;
        _pendingWhatsappVerificationCode = null;
        _whatsappVerificationCodeInput = string.Empty;
        try
        {
            Preferences.Default.Set(GetVerifiedWhatsappPreferenceKey(), check.NormalizedNumber);
        }
        catch
        {
        }

        _whatsappAuthFeedbackOk = true;
        _whatsappAuthFeedback = $"✅ WhatsApp {check.FormattedDisplay} autenticado e salvo com sucesso!";
        await SaveSettingsAsync();
    }

