        _defaultPackageWeightGrams = s.DefaultPackageWeightGrams >= 100 ? s.DefaultPackageWeightGrams : 450;
    }

    private async Task ConnectMercadoPagoOneClickAsync()
    {
        _mpFeedback = null;
        _mpFeedbackOk = false;
        _mpBusy = true;
        try
        {
            var centralUrl = GoogleCloudSyncService.NormalizePublicServerUrl(_centralCatalogServerUrlInput);
            if (!string.IsNullOrWhiteSpace(centralUrl))
            {
                await CloudSync.SyncCentralServerUrlFromCatalogAsync(centralUrl);
            }

            var (browserOpened, start) = await Gateway.ConnectMercadoPagoViaBrowserAsync();
            if (!start.IsConfigured || string.IsNullOrWhiteSpace(start.AuthorizationUrl))
            {
                _mpFeedbackOk = false;
                _mpFeedback = start.Message;
                return;
            }

            _mpFeedbackOk = true;
            _mpFeedback = browserOpened
                ? "Autorize na tela do Mercado Pago no navegador. Aguardando confirmação automática..."
                : $"Abra este link no navegador para autorizar: {start.AuthorizationUrl}";

            _mpPollCts?.Cancel();
            _mpPollCts?.Dispose();
            _mpPollCts = new CancellationTokenSource();
            _ = PollMercadoPagoStatusLoopAsync(_mpPollCts.Token);
        }
        catch (Exception ex)
        {
            _mpFeedbackOk = false;
            _mpFeedback = ex.Message;
        }
        finally
        {
            _mpBusy = false;
        }
    }

    private async Task PollMercadoPagoStatusLoopAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            for (var i = 0; i < 30 && await timer.WaitForNextTickAsync(ct); i++)
            {
                var status = await Gateway.GetMercadoPagoStatusAsync(ct);
                if (status.IsStoreConnected)
                {
                    _hasMercadoPagoConnected = true;
                    _mpAccountLabel = status.AccountLabel;
                    _pixGatewayMode = "MercadoPago";
                    _pixEnabled = true;
                    _mpFeedbackOk = true;
                    _mpFeedback = $"✓ Mercado Pago conectado! Recebimento Pix automático ativo{(string.IsNullOrWhiteSpace(status.AccountLabel) ? string.Empty : $" ({status.AccountLabel})")}.";

                    var refreshed = await Gateway.GetStoreSettingsAsync();
                    SyncUpdatedSettingsToState(refreshed);
                    await InvokeAsync(StateHasChanged);
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
        }
    }

    private async Task RefreshMercadoPagoStatusAsync()
    {
        _mpFeedback = null;
        _mpBusy = true;
        try
        {
            var status = await Gateway.GetMercadoPagoStatusAsync();
            _hasMercadoPagoConnected = status.IsStoreConnected;
            _mpAccountLabel = status.AccountLabel;
            if (status.IsStoreConnected)
            {
                _pixGatewayMode = "MercadoPago";
                _pixEnabled = true;
                _mpFeedbackOk = true;
                _mpFeedback = status.Message;
                var refreshed = await Gateway.GetStoreSettingsAsync();
                SyncUpdatedSettingsToState(refreshed);
            }
            else
            {
                _mpFeedbackOk = false;
                _mpFeedback = status.Message;
            }
        }
        catch (Exception ex)
        {
            _mpFeedbackOk = false;
            _mpFeedback = ex.Message;
        }
        finally
        {
            _mpBusy = false;
        }
    }

    private async Task DisconnectMercadoPagoAsync()
    {
        _mpFeedback = null;
        _mpBusy = true;
        try
        {
            _mpPollCts?.Cancel();
            var (ok, msg) = await Gateway.DisconnectMercadoPagoAsync();
            _mpFeedbackOk = ok;
            _mpFeedback = msg;
            if (ok)
            {
                _hasMercadoPagoConnected = false;
                _mpAccountLabel = null;
                _pixGatewayMode = "DirectPix";
                var refreshed = await Gateway.GetStoreSettingsAsync();
                SyncUpdatedSettingsToState(refreshed);
