    private void ApplyHostingAndGoogleFields(AdminStoreSettingsDto s)
    {
        _serverHostingMode = string.IsNullOrWhiteSpace(s.ServerHostingMode) ? "PlatformShared" : s.ServerHostingMode;

        var resolvedCentral = !IsPlaceholderOrLocalUrl(s.CentralCatalogBaseUrl)
            ? s.CentralCatalogBaseUrl
            : (!IsPlaceholderOrLocalUrl(Gateway.LatestAdminCentralServerUrl)
                ? Gateway.LatestAdminCentralServerUrl
                : GoogleCloudSyncService.GetCachedCentralCatalogUrl());
        if (!IsPlaceholderOrLocalUrl(resolvedCentral))
        {
            _centralCatalogServerUrlInput = resolvedCentral!;
        }
        else if (string.Equals(_serverHostingMode, "PlatformShared", StringComparison.OrdinalIgnoreCase) &&
                 !IsPlaceholderOrLocalUrl(s.OnlineBaseUrl))
        {
            _centralCatalogServerUrlInput = s.OnlineBaseUrl!;
        }
        else
        {
            _centralCatalogServerUrlInput = ClothingStore.Shared.Helpers.AppUpdateCatalog.DefaultCentralPlatformServerUrl;
        }

        _form.ServerHostingMode = _serverHostingMode;
        _form.CentralCatalogBaseUrl = GoogleCloudSyncService.NormalizePublicServerUrl(_centralCatalogServerUrlInput);
    }

    private static bool IsPlaceholderOrLocalUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return true;

        var trimmed = url.Trim().TrimEnd('/');
        return trimmed.Contains("://lojas.", StringComparison.OrdinalIgnoreCase)
               || trimmed.Contains("minhaloja.com", StringComparison.OrdinalIgnoreCase)
               || trimmed.Contains("localhost", StringComparison.OrdinalIgnoreCase)
               || trimmed.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase);
    }

    private void SyncUpdatedSettingsToState(AdminStoreSettingsDto updated)
    {
        _form.StoreName = updated.StoreName;
        _form.StoreSlug = updated.StoreSlug;
        _form.WhatsappNumber = updated.WhatsappNumber;
        _form.StoreDescription = updated.StoreDescription;
        _form.LogoPublicUrl = updated.LogoPublicUrl;
        _form.DefaultLowStockThreshold = updated.DefaultLowStockThreshold;
        _form.OnlineBaseUrl = updated.OnlineBaseUrl;
        _form.AutoSyncOnlineOnSave = updated.AutoSyncOnlineOnSave;
        _form.LastOnlineSyncAt = updated.LastOnlineSyncAt;
        _form.IsSiteActive = updated.IsSiteActive;
        _form.DeactivationReason = updated.DeactivationReason;
        _form.LastActivityAt = updated.LastActivityAt;
        _form.PublishedStoreName = updated.PublishedStoreName;
        _planTier = updated.PlanTier;
        _planActivatedAt = updated.PlanActivatedAt;
        _planExpiresAt = updated.PlanExpiresAt;
        _activeGiftCardCode = updated.ActiveGiftCardCode;
        _basicPlanPrice = updated.BasicPlanMonthlyPrice;
        _intermediaryPlanPrice = updated.IntermediaryPlanMonthlyPrice;
        _premiumPlanPrice = updated.PremiumPlanMonthlyPrice;
        _designDraft = (updated.Design ?? StoreDesignDto.CreateMinimalistaLuxo()).Clone();

        ApplyHostingAndGoogleFields(updated);
        BrandState.ApplyFromAdminSettings(updated);
    }

    private async Task PublishCentralOneClickAsync()
    {
        _error = null;
        _success = null;
        _publishWizardMessage = null;
        _publishWizardSuccess = false;

        if (string.IsNullOrWhiteSpace(_form.StoreName))
        {
            _publishWizardMessage = "Preencha o Nome da Loja no card Identidade da Loja & WhatsApp antes de publicar.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.WhatsappNumber))
        {
            _publishWizardMessage = "Preencha o WhatsApp de Atendimento da loja antes de publicar.";
            return;
        }

        _publishingOneClick = true;
        _publishWizardMessage = "🚀 Publicando sua loja online em 1 clique...";
        StateHasChanged();

        var progressReporter = new Progress<string>(msg =>
        {
            _publishWizardMessage = msg;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            if (_autoSyncSlugWithName || string.IsNullOrWhiteSpace(_form.StoreSlug))
            {
                _form.StoreSlug = WhatsAppLinkBuilder.GenerateStoreSlug(_form.StoreName);
            }

            if (string.IsNullOrWhiteSpace(_form.StoreDescription))
            {
                _form.StoreDescription = $"Catálogo digital oficial de {_form.StoreName.Trim()}.";
            }

            if (IsPlaceholderOrLocalUrl(_centralCatalogServerUrlInput))
            {
                _centralCatalogServerUrlInput = ClothingStore.Shared.Helpers.AppUpdateCatalog.DefaultCentralPlatformServerUrl;
            }

            var normalizedCentral = GoogleCloudSyncService.NormalizePublicServerUrl(_centralCatalogServerUrlInput);
            if (!string.IsNullOrWhiteSpace(normalizedCentral))
            {
                _form.OnlineBaseUrl = normalizedCentral;
                _form.CentralCatalogBaseUrl = normalizedCentral;
            }

            _form.ServerHostingMode = "PlatformShared";
            _form.AutoSyncOnlineOnSave = true;
            _form.IsSiteActive = true;
            _form.PixGatewayMode = _pixGatewayMode;

            if (BrandState.IsPremiumPlan)
            {
                _form.Design = _designDraft.Clone();
            }
            else if (BrandState.IsIntermediatePlan)
            {
                _form.Design = StoreDesignPresets.ResolveByPresetKeyForPlan(StoreDesignPresets.PlanIntermediate, _designDraft.PresetKey);
            }

            await Gateway.UpdateStoreSettingsAsync(_form, suppressAutoSync: true);

            var (ok, publicUrl, message) = await Gateway.PublishToCentralServerAsync(
                normalizedCentral,
                progress: progressReporter);

            var refreshed = await Gateway.GetStoreSettingsAsync();
            SyncUpdatedSettingsToState(refreshed);
            ApplyPixAndShippingFields(refreshed);

            if (ok)
            {
                var finalUrl = !string.IsNullOrWhiteSpace(publicUrl)
                    ? publicUrl
                    : WhatsAppLinkBuilder.BuildStoreCatalogUrl(refreshed.OnlineBaseUrl, refreshed.StoreSlug);
                _publishWizardSuccess = true;
                _publishWizardMessage = $"✓ {message} Link da vitrine pronto: {finalUrl}";
                _success = _publishWizardMessage;
            }
            else
            {
                _publishWizardSuccess = false;
                _publishWizardMessage = message;
                _error = message;
            }
        }
        catch (Exception ex)
        {
            _publishWizardSuccess = false;
            _publishWizardMessage = $"Não foi possível publicar sua loja agora: {ex.Message}";
            _error = _publishWizardMessage;
        }
        finally
        {
            _publishingOneClick = false;
        }
    }

    private async Task CheckUpdatesManuallyAsync()
    {
        await UpdateService.CheckForUpdatesAsync(manualTrigger: true);
        UpdateService.OpenPopup();
    }

    public void Dispose()
    {
        _mpPollCts?.Cancel();
        _mpPollCts?.Dispose();
        Theme.OnThemeChanged -= StateHasChanged;
        CloudSync.OnSyncStatusChanged -= StateHasChanged;
        Gateway.PlanEntitlementActivated -= OnPlanEntitlementActivated;
        Gateway.AuthStateChanged -= OnGatewayAuthStateChanged;
    }
