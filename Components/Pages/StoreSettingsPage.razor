@page "/configuracoes-loja"
@page "/configuracoes"
@using ClothingStore.Application.Services
@inject MauiAdminGateway Gateway
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@inject ThemeService Theme
@inject StoreBrandStateService BrandState
@inject GoogleCloudSyncService CloudSync
@inject AppUpdateService UpdateService

@{
    var effectiveSlug = string.IsNullOrWhiteSpace(_form.StoreSlug)
        ? WhatsAppLinkBuilder.GenerateStoreSlug(_form.StoreName)
        : WhatsAppLinkBuilder.GenerateStoreSlug(_form.StoreSlug);

    var baseSiteUrl = !string.IsNullOrWhiteSpace(_form.OnlineBaseUrl)
        ? _form.OnlineBaseUrl.TrimEnd('/')
        : WhatsAppLinkBuilder.GenerateDefaultStoreUrl(_form.StoreName);

    var isPlaceholderOrLocal = IsPlaceholderOrLocalUrl(baseSiteUrl);

    var storeCatalogUrl = WhatsAppLinkBuilder.BuildStoreCatalogUrl(baseSiteUrl, effectiveSlug);
    var qrCodeSvgUri = WhatsAppLinkBuilder.GenerateQrCodeSvgDataUri(storeCatalogUrl);
}

<div style="margin-bottom: 1.15rem;">
    <h1 style="font-size: 1.65rem; font-weight: 800; margin: 0; color: var(--adm-text);">Configurações da Loja &amp; Catálogo</h1>
    <p style="color: var(--adm-muted); font-size: 0.92rem; margin: 0.25rem 0 0;">
        Escolha uma aba abaixo para configurar sua loja sem excesso de informação na tela.
    </p>
</div>

<!-- Barra de Abas Limpa para Separar Configurações da Loja, Visual, Pix/Entrega e Plano -->
<nav aria-label="Seções das configurações da loja"
     style="display: grid; grid-template-columns: repeat(auto-fit, minmax(175px, 1fr)); gap: 0.55rem; margin-bottom: 1.35rem; background: var(--adm-surface); padding: 0.45rem; border-radius: 14px; border: 1px solid var(--adm-border);">
    <button type="button"
            class="adm-btn @(_activeSettingsTab == "loja" ? "adm-btn-primary" : "adm-btn-outline")"
            style="min-height: 46px; font-weight: 700; justify-content: center; border-radius: 10px;"
            @onclick='() => _activeSettingsTab = "loja"'>
        🏪 Dados &amp; Link da Loja
    </button>
    <button type="button"
            class="adm-btn @(_activeSettingsTab == "visual" ? "adm-btn-primary" : "adm-btn-outline")"
            style="min-height: 46px; font-weight: 700; justify-content: center; border-radius: 10px;"
            @onclick='() => _activeSettingsTab = "visual"'>
        🎨 Visual &amp; Temas
    </button>
    <button type="button"
            class="adm-btn @(_activeSettingsTab == "vendas" ? "adm-btn-primary" : "adm-btn-outline")"
            style="min-height: 46px; font-weight: 700; justify-content: center; border-radius: 10px;"
            @onclick='() => _activeSettingsTab = "vendas"'>
        💰 Pix, Vendas &amp; Frete
    </button>
    <button type="button"
            class="adm-btn @(_activeSettingsTab == "plano" ? "adm-btn-primary" : "adm-btn-outline")"
            style="min-height: 46px; font-weight: 700; justify-content: center; border-radius: 10px;"
            @onclick='() => _activeSettingsTab = "plano"'>
        🎁 Plano &amp; Gift Card
    </button>
</nav>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert-banner alert-error">@_error</div>
}

@if (!string.IsNullOrWhiteSpace(_success))
{
    <div class="alert-banner alert-success">@_success</div>
}

<!-- ====================================================================== -->
<!-- ABA 1: DADOS & LINK DA LOJA (Essencial + Opcionais Recolhidos)          -->
<!-- ====================================================================== -->
<div style="@(_activeSettingsTab == "loja" ? string.Empty : "display: none;")">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1.25rem; align-items: start;">
        <!-- Coluna Esquerda: Identidade Essencial da Loja -->
        <div style="display: flex; flex-direction: column; gap: 1.15rem;">
            <section class="adm-card">
                <h2 style="font-size: 1.1rem; font-weight: 700; margin-top: 0; margin-bottom: 1rem; color: var(--adm-text);">
                    🏪 Identidade da Loja &amp; WhatsApp
                </h2>

                <div style="display: flex; flex-direction: column; gap: 1.05rem;">
                    <div>
                        <label class="adm-label">Nome da Loja *</label>
                        <input type="text"
                               class="adm-input"
                               @bind="_form.StoreName"
                               @bind:event="oninput"
                               @bind:after="SyncSlugFromStoreNameIfUnlocked"
                               placeholder="Ex.: Minha Loja" />
                    </div>

                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem; gap: 0.5rem; flex-wrap: wrap;">
                            <label class="adm-label" style="margin: 0;">Endereço do Link da Loja (Final da URL) *</label>
                            <label style="font-size: 0.76rem; color: var(--adm-muted); display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
                                <input type="checkbox" @bind="_autoSyncSlugWithName" />
                                <span>Sincronizar com o nome</span>
                            </label>
                        </div>
                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                            <input type="text"
                                   class="adm-input"
                                   style="flex: 1 1 200px; min-width: 0;"
                                   @bind="_form.StoreSlug"
                                   @bind:after="ClearRenderCheckResult"
                                   placeholder="minha-loja" />
                            <button type="button"
                                    class="adm-btn adm-btn-outline"
                                    style="white-space: nowrap;"
                                    disabled="@_isCheckingRenderLink"
                                    @onclick="CheckRenderStoreLinkAsync">
                                @(_isCheckingRenderLink ? "⏳ Verificando..." : "🔍 Verificar no Render")
                            </button>
                        </div>
                        <span style="font-size: 0.78rem; color: var(--adm-muted); display: block; margin-top: 0.3rem;">
                            Link oficial do catálogo: <strong style="color: var(--adm-accent);">@storeCatalogUrl</strong>
                        </span>

                        @if (_renderLinkCheck is not null)
                        {
                            var checkBg = !_renderLinkCheck.ServerOnline
                                ? "rgba(245,158,11,0.12)"
                                : _renderLinkCheck.IsAvailable
                                    ? "rgba(22,163,74,0.12)"
                                    : "rgba(220,38,38,0.12)";
                            var checkBorder = !_renderLinkCheck.ServerOnline
                                ? "var(--adm-warning)"
                                : _renderLinkCheck.IsAvailable
                                    ? "var(--adm-success)"
                                    : "var(--adm-danger)";
                            var checkColor = !_renderLinkCheck.ServerOnline
                                ? "var(--adm-warning)"
                                : _renderLinkCheck.IsAvailable
                                    ? "var(--adm-success)"
                                    : "var(--adm-danger)";
                            <div style="margin-top: 0.5rem; padding: 0.65rem 0.85rem; border-radius: 10px; font-size: 0.84rem; background: @checkBg; border: 1px solid @checkBorder; color: @checkColor;">
                                <div style="font-weight: 700;">
                                    @(!_renderLinkCheck.ServerOnline ? "🟡 " : _renderLinkCheck.IsAvailable ? "🟢 " : "🔴 ")@_renderLinkCheck.Message
                                </div>
                                @if (_renderLinkCheck.IsAvailable)
                                {
                                    <div style="font-size: 0.78rem; margin-top: 0.2rem; color: var(--adm-text);">
                                        Endereço confirmado: <strong>@_renderLinkCheck.StoreUrl</strong>
                                    </div>
                                }
                                else if (_renderLinkCheck.Suggestions.Count > 0)
                                {
                                    <div style="font-size: 0.78rem; margin-top: 0.35rem; color: var(--adm-text);">Opções disponíveis no Render (toque para escolher):</div>
                                    <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.35rem;">
                                        @foreach (var sug in _renderLinkCheck.Suggestions)
                                        {
                                            <button type="button"
                                                    class="pill-badge pill-green"
                                                    style="border: none; cursor: pointer; padding: 0.26rem 0.65rem; font-size: 0.78rem;"
                                                    @onclick="() => ApplyRenderSlugSuggestionAsync(sug)">
                                                ✓ /loja/@sug
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div>
                        @{
                            var waCheck = WhatsAppLinkBuilder.ValidateBrazilianWhatsAppNumber(_form.WhatsappNumber);
                            var isWaVerified = waCheck.IsValid &&
                                               !string.IsNullOrWhiteSpace(_verifiedWhatsappNumber) &&
                                               string.Equals(waCheck.NormalizedNumber, _verifiedWhatsappNumber, StringComparison.Ordinal);
                        }
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.35rem;">
                            <label class="adm-label" style="margin: 0;">Número do WhatsApp (DDD + Celular) *</label>
                            <span class="pill-badge @(isWaVerified ? "pill-green" : "pill-amber")">
                                @(isWaVerified ? $"✓ WhatsApp Autenticado ({waCheck.FormattedDisplay})" : "⚠️ Não autenticado")
                            </span>
                        </div>
                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                            <input type="text"
                                   class="adm-input"
                                   style="flex: 1 1 200px; min-width: 0;"
                                   @bind="_form.WhatsappNumber"
                                   @bind:event="oninput"
                                   @bind:after="OnWhatsappInputChanged"
                                   placeholder="Ex.: 11999990000" />
                            <button type="button"
                                    class="adm-btn @(isWaVerified ? "adm-btn-outline" : "adm-btn-success")"
                                    style="white-space: nowrap;"
                                    @onclick="SendWhatsappVerificationCodeAsync">
                                @(isWaVerified ? "🔄 Reautenticar Zap" : "📲 Autenticar Meu WhatsApp")
                            </button>
                        </div>
                        <span style="font-size: 0.78rem; color: var(--adm-muted); display: block; margin-top: 0.3rem;">
                            Pode digitar apenas o DDD + número (ex.: <strong>11999990000</strong>). O código do Brasil (+55) é inserido automaticamente!
                        </span>

                        @if (!string.IsNullOrWhiteSpace(_whatsappAuthFeedback))
                        {
                            <div style="margin-top: 0.45rem; font-size: 0.82rem; font-weight: 600; color: @(_whatsappAuthFeedbackOk ? "var(--adm-success)" : "var(--adm-danger)");">
                                @_whatsappAuthFeedback
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_pendingWhatsappVerificationCode))
                        {
                            <div style="margin-top: 0.65rem; padding: 0.85rem; border-radius: 10px; border: 1.5px solid var(--adm-success); background: rgba(22, 163, 74, 0.08); display: flex; flex-direction: column; gap: 0.6rem;">
                                <div style="font-size: 0.84rem; color: var(--adm-text); line-height: 1.45;">
                                    🔐 <strong>Digite o código de 4 dígitos enviado pelo Suporte YouLink</strong> para confirmar o número <strong>@(waCheck.IsValid ? waCheck.FormattedDisplay : _form.WhatsappNumber)</strong>:
                                </div>
                                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                                    <input type="text"
                                           maxlength="4"
                                           class="adm-input"
                                           style="max-width: 140px; font-family: monospace; font-weight: 800; font-size: 1.05rem; letter-spacing: 0.18em; text-align: center;"
                                           @bind="_whatsappVerificationCodeInput"
                                           @bind:event="oninput"
                                           placeholder="0000" />
                                    <button type="button"
                                            class="adm-btn adm-btn-success"
                                            style="font-weight: 700;"
                                            @onclick="ConfirmWhatsappVerificationCodeAsync">
                                        ✓ Confirmar Código
                                    </button>
                                    <button type="button"
                                            class="adm-btn adm-btn-outline"
                                            @onclick="SendWhatsappVerificationCodeAsync">
                                        Reabrir no Zap
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div>
                        <label class="adm-label">Descrição e Bio da Loja *</label>
                        <textarea class="adm-textarea" rows="3" @bind="_form.StoreDescription" placeholder="Apresentação exibida para os clientes no catálogo online..."></textarea>
                    </div>

                    <!-- Opcionais recolhidos: Logotipo & Alerta de Estoque Baixo -->
                    <details style="background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.85rem 1rem;">
                        <summary style="cursor: pointer; font-weight: 700; font-size: 0.88rem; color: var(--adm-text); user-select: none;">
                            🖼️ Logotipo da Loja &amp; Alerta de Estoque (Opcional)
                        </summary>
                        <div style="margin-top: 0.9rem; display: flex; flex-direction: column; gap: 0.9rem;">
                            <div>
                                <label class="adm-label">Logotipo da Loja (Opcional)</label>
                                @if (!string.IsNullOrWhiteSpace(_form.LogoPublicUrl))
                                {
                                    <div style="padding: 0.75rem; background: var(--adm-surface); border: 1px solid var(--adm-border); border-radius: 8px; display: flex; align-items: center; gap: 0.85rem; margin-bottom: 0.65rem;">
                                        <img src="@_form.LogoPublicUrl" alt="Logotipo" style="height: 46px; max-width: 140px; object-fit: contain;" />
                                        <span style="font-weight: 700; font-size: 0.95rem; color: var(--adm-text);">@_form.StoreName</span>
                                    </div>
                                }
                                else
                                {
                                    <div style="padding: 0.75rem; background: var(--adm-surface); border: 1px dashed var(--adm-border); border-radius: 8px; color: var(--adm-muted); font-size: 0.82rem; margin-bottom: 0.65rem;">
                                        Nenhum logotipo configurado (o catálogo exibirá o nome <strong>@_form.StoreName</strong> em destaque).
                                    </div>
                                }
                                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    <button type="button" class="adm-btn adm-btn-outline" @onclick="PickAndUploadLogoAsync">
                                        📷 Enviar Logotipo
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(_form.LogoPublicUrl))
                                    {
                                        <button type="button" class="adm-btn adm-btn-danger" @onclick="RemoveLogoAsync">
                                            Remover Logotipo
                                        </button>
                                    }
                                </div>
                            </div>

                            <div>
                                <label class="adm-label">Alerta de Estoque Baixo (avisa quando restar menos de quantas unidades)</label>
                                <input type="number" min="0" class="adm-input" @bind="_form.DefaultLowStockThreshold" />
                            </div>
                        </div>
                    </details>

                    <button type="button" class="adm-btn adm-btn-success" style="padding: 0.85rem; font-size: 0.95rem; font-weight: 700;" @onclick="SaveSettingsAsync">
                        💾 Salvar Configurações da Loja
                    </button>
                </div>
            </section>
        </div>

        <!-- Coluna Direita: Publicação 1 Clique, Link Oficial, QR Code e Sincronização -->
        <div style="display: flex; flex-direction: column; gap: 1.15rem;">
            @if (!_form.IsSiteActive)
            {
                <section class="adm-card" style="border-left: 4px solid var(--adm-danger);">
                    <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--adm-danger); border-radius: 8px; padding: 0.85rem; margin-bottom: 0.85rem; color: var(--adm-text);">
                        <div style="font-weight: 800; color: var(--adm-danger); margin-bottom: 0.25rem;">
                            ⚠️ Site Pausado / Oculto para Clientes:
                        </div>
                        <div style="font-size: 0.84rem; line-height: 1.45;">
                            @(_form.DeactivationReason ?? "O site foi pausado temporariamente.")
                        </div>
                    </div>
                    <button type="button"
                            class="adm-btn adm-btn-primary"
                            style="width: 100%; padding: 0.75rem; font-weight: 800; font-size: 0.95rem;"
                            @onclick="ActivateSiteNowAsync">
                        🚀 Reativar e Publicar Meu Site Agora
                    </button>
                </section>
            }

            <CloudPublishWizard CentralServerUrl="@_centralCatalogServerUrlInput"
                                CentralServerUrlChanged="v => _centralCatalogServerUrlInput = v"
                                IsCentralHostingMode="true"
                                IsOnlineConfigured="@(!isPlaceholderOrLocal)"
                                IsSiteActive="@_form.IsSiteActive"
                                IsPublishing="@_publishingOneClick"
                                IsLastActionSuccess="@_publishWizardSuccess"
                                StatusMessage="@_publishWizardMessage"
                                LastSyncedAt="@_form.LastOnlineSyncAt"
                                OfficialCatalogUrl="@storeCatalogUrl"
                                StoreNameHint="@_form.StoreName"
                                OnCentralPublishRequested="PublishCentralOneClickAsync"
                                OnCopyCatalogUrl="() => CopyStoreUrlAsync(storeCatalogUrl)"
                                OnShareWhatsApp="() => ShareOnWhatsAppAsync(storeCatalogUrl)"
                                OnOpenCatalogUrl="() => OpenBrowserAsync(storeCatalogUrl)" />

            <!-- Opcionais recolhidos: QR Code para Balcão, Prévia Interna e Sincronização -->
            <details style="background: var(--adm-surface); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.85rem 1rem;">
                <summary style="cursor: pointer; font-weight: 700; font-size: 0.85rem; color: var(--adm-muted); user-select: none;">
                    📱 QR Code para Balcão, Visibilidade &amp; Sincronização (Opcional)
                </summary>
                <div style="margin-top: 0.9rem; display: flex; flex-direction: column; gap: 0.9rem; font-size: 0.85rem;">
                    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
                        <img src="@qrCodeSvgUri" alt="QR Code da Loja" style="width: 96px; height: 96px; border-radius: 8px; background: #FFFFFF; padding: 4px; border: 1px solid var(--adm-border);" />
                        <div style="flex: 1; min-width: 160px;">
                            <div style="font-weight: 800; font-size: 0.9rem; color: var(--adm-text);">QR Code do Balcão &amp; Sacolas</div>
                            <div style="font-size: 0.78rem; color: var(--adm-muted); margin-top: 0.2rem; line-height: 1.4;">
                                Imprima para que seus clientes apontem a câmera do celular e abram o catálogo na hora.
                            </div>
                            <div style="margin-top: 0.5rem;">
                                <a href="/loja/@effectiveSlug" class="adm-btn adm-btn-outline" style="font-size: 0.78rem; padding: 0.35rem 0.75rem;">
                                    👁️ Ver Prévia Interna no App
                                </a>
                            </div>
                        </div>
                    </div>

                    <div style="border-top: 1px solid var(--adm-border); padding-top: 0.75rem; display: flex; flex-direction: column; gap: 0.65rem;">
                        <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer;">
                            <input type="checkbox" @bind="_form.AutoSyncOnlineOnSave" />
                            <span>Sincronizar dados automaticamente ao salvar produtos ou categorias</span>
                        </label>

                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                            <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
                                <button type="button"
                                        class="adm-btn adm-btn-outline"
                                        style="font-size: 0.78rem; padding: 0.38rem 0.75rem;"
                                        disabled="@CloudSync.IsSyncing"
                                        @onclick="SyncToCloudNowAsync">
                                    @(CloudSync.IsSyncing ? "⏳ Sincronizando..." : "⬆️ Enviar Loja para Nuvem")
                                </button>
                                <button type="button"
                                        class="adm-btn adm-btn-outline"
                                        style="font-size: 0.78rem; padding: 0.38rem 0.75rem;"
                                        disabled="@CloudSync.IsSyncing"
                                        @onclick="PullStoreFromCloudNowAsync">
                                    ⬇️ Baixar Loja da Nuvem (Outro Aparelho)
                                </button>
                            </div>

                            @if (_form.IsSiteActive)
                            {
                                <button type="button"
                                        class="adm-btn adm-btn-outline"
                                        style="padding: 0.35rem 0.7rem; font-size: 0.76rem;"
                                        @onclick="DeactivateSiteNowAsync">
                                    Ocultar / Pausar Site Temporariamente
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </details>
        </div>
    </div>
</div>

<!-- ====================================================================== -->
<!-- ABA 2: VISUAL & TEMAS (Temas da Vitrine Online + Tema Claro/Escuro App) -->
<!-- ====================================================================== -->
<div style="@(_activeSettingsTab == "visual" ? string.Empty : "display: none;")">
    <section class="adm-card" style="border-left: 4px solid var(--adm-accent); margin-bottom: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
            <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: var(--adm-text);">
                🎨 Tema do Aplicativo (Modo Claro &amp; Escuro)
            </h2>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span class="pill-badge pill-slate">v@(UpdateService.CurrentVersion)</span>
                <button type="button"
                        class="adm-btn adm-btn-outline"
                        style="padding: 0.3rem 0.65rem; font-size: 0.78rem;"
                        disabled="@UpdateService.IsChecking"
                        @onclick="CheckUpdatesManuallyAsync">
                    @(UpdateService.IsChecking ? "⏳ Verificando..." : "🔄 Procurar Atualizações")
                </button>
            </div>
        </div>
        <p style="font-size: 0.85rem; color: var(--adm-muted); margin-top: 0; margin-bottom: 0.75rem;">
            Escolha a aparência do seu painel administrativo no computador ou celular:
        </p>

        <div class="theme-selector-grid">
            <div class="theme-card-option @(Theme.ThemePreference == "system" ? "active" : "")"
                 @onclick='() => ChangeTheme("system")'>
                <div style="font-size: 1.3rem; margin-bottom: 0.2rem;">🌓</div>
                <div>Automático</div>
                <div style="font-size: 0.72rem; color: var(--adm-muted); font-weight: 500;">Segue o sistema</div>
            </div>

            <div class="theme-card-option @(Theme.ThemePreference == "light" ? "active" : "")"
                 @onclick='() => ChangeTheme("light")'>
                <div style="font-size: 1.3rem; margin-bottom: 0.2rem;">☀️</div>
                <div>Modo Claro</div>
                <div style="font-size: 0.72rem; color: var(--adm-muted); font-weight: 500;">Fundo Branco</div>
            </div>

            <div class="theme-card-option @(Theme.ThemePreference == "dark" ? "active" : "")"
                 @onclick='() => ChangeTheme("dark")'>
                <div style="font-size: 1.3rem; margin-bottom: 0.2rem;">🌙</div>
                <div>Modo Escuro</div>
                <div style="font-size: 0.72rem; color: var(--adm-muted); font-weight: 500;">OLED / Alto Contraste</div>
            </div>
        </div>
    </section>

    <DesignStudioPanel PlanTier="@_planTier"
                       PlanActivatedAt="@_planActivatedAt"
                       PlanExpiresAt="@_planExpiresAt"
                       ActiveGiftCardCode="@_activeGiftCardCode"
                       BasicPrice="@_basicPlanPrice"
                       IntermediaryPrice="@_intermediaryPlanPrice"
                       PremiumPrice="@_premiumPlanPrice"
                       Design="@_designDraft"
                       StoreName="@_form.StoreName"
                       StoreDescription="@_form.StoreDescription"
                       IsSaving="@_savingDesign"
                       OnDesignChanged="HandleDesignDraftChanged"
                       OnSaveDesignRequested="SaveDesignSettingsAsync" />
</div>

<!-- ====================================================================== -->
<!-- ABA 3: PIX, VENDAS & FRETE (Essencial visível + Frete/CEP em Opcional) -->
<!-- ====================================================================== -->
<div style="@(_activeSettingsTab == "vendas" ? string.Empty : "display: none;")">

<!-- Card: Vendas por Pix no App, Raio de Distância e Calculadora Correios -->
<section class="adm-card" style="margin-top: 1.25rem; border-left: 4px solid #16A34A;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
        <div>
            <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: #16A34A;">
                Exclusivo Meia Versão &amp; Premium
            </div>
            <h2 style="font-size: 1.15rem; font-weight: 800; margin: 0.2rem 0 0; color: var(--adm-text);">
                💰 Formas de Venda no App (Vendas sem Pix &amp; Pix Opcional)
            </h2>
            <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0.25rem 0 0; line-height: 1.45;">
                Você decide como quer vender: ative ou desative <strong>vendas sem Pix</strong> (Dinheiro, Cartão, WhatsApp, Balcão) e, se quiser, habilite também <strong>Pix direto no catálogo</strong> com envio pelos Correios. O controle de estoque normal em <strong>Estoque</strong> continua sempre liberado.
            </p>
        </div>
        <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
            @if (!BrandState.IsIntermediatePlan && !BrandState.IsPremiumPlan)
            {
                <span class="pill-badge pill-slate">🔒 Recursos Avançados na Meia Versão / Premium</span>
            }
            else
            {
                <span class="pill-badge @(_manualSalesEnabled ? "pill-green" : "pill-slate")">
                    @(_manualSalesEnabled ? "🟢 Vendas s/ Pix Ativas" : "⚪ Vendas s/ Pix Pausadas")
                </span>
                @if (_pixEnabled && string.Equals(_pixGatewayMode, "MercadoPago", StringComparison.OrdinalIgnoreCase) && _hasMercadoPagoConnected)
                {
                    <span class="pill-badge pill-green">⚡ Pix Automático Ativo</span>
                }
                else if (_pixEnabled && ClothingStore.Shared.Helpers.PixPayloadBuilder.IsValidPixKey(_storePixKey) && ClothingStore.Shared.Helpers.BrazilShippingCalculator.TrySanitizeCep(_originCep, out _))
                {
                    <span class="pill-badge pill-green">🟢 Pix Direto Ativo</span>
                }
                else
                {
                    <span class="pill-badge pill-slate">ℹ️ Pix Opcional</span>
                }
            }
        </div>
    </div>

    @if (!BrandState.IsIntermediatePlan && !BrandState.IsPremiumPlan)
    {
        <div style="background: var(--adm-input-bg); border: 1px dashed var(--adm-border); border-radius: 10px; padding: 1rem;">
            <div style="font-weight: 700; margin-bottom: 0.35rem; color: var(--adm-text);">
                Recurso liberado a partir da Meia Versão (Intermediário) até a Premium
            </div>
            <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0 0 0.85rem; line-height: 1.45;">
                No Plano Básico você movimenta seu <strong>Estoque</strong> normalmente e atende pelo WhatsApp. Na <strong>Meia Versão</strong> e <strong>Premium</strong>, você registra vendas sem Pix (Dinheiro, Cartão, Transferência), e também pode ativar vendas diretas por Pix se desejar — sem obrigação!
            </p>
            <a href="/planos" class="adm-btn adm-btn-accent">💎 Conhecer Meia Versão / Premium &rarr;</a>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 0.9rem;">
            <label style="display: flex; align-items: center; gap: 0.65rem; background: var(--adm-input-bg); border: 1.5px solid @(_manualSalesEnabled ? "#16A34A" : "var(--adm-border)"); border-radius: 10px; padding: 0.85rem 1rem; cursor: pointer;">
                <input type="checkbox" @bind="_manualSalesEnabled" style="width: 18px; height: 18px;" />
                <div>
                    <div style="font-weight: 800; color: var(--adm-text);">
                        @(_manualSalesEnabled ? "✅ Movimentação de vendas sem Pix ATIVADA (Dinheiro, Cartão, Transferência, WhatsApp)" : "⚪ Movimentação de vendas sem Pix DESATIVADA")
                    </div>
                    <div style="font-size: 0.78rem; color: var(--adm-muted);">
                        Permite registrar vendas normais fora do Pix com baixa automática no estoque e cálculo do faturamento. Mesmo se desativar aqui, você continua movimentando o estoque normalmente na aba <strong>Estoque</strong>.
                    </div>
                </div>
            </label>

            <label style="display: flex; align-items: center; gap: 0.65rem; background: var(--adm-input-bg); border: 1.5px solid @(_pixEnabled ? "#16A34A" : "var(--adm-border)"); border-radius: 10px; padding: 0.85rem 1rem; cursor: pointer;">
                <input type="checkbox" @bind="_pixEnabled" style="width: 18px; height: 18px;" />
                <div>
                    <div style="font-weight: 800; color: var(--adm-text);">
                        @(_pixEnabled ? "✅ Vendas diretas pelo catálogo via Pix ATIVADAS (Opcional)" : "Ativar também compras diretas pelo catálogo via Pix (Opcional)")
                    </div>
                    <div style="font-size: 0.78rem; color: var(--adm-muted);">
                        Opcional: gera Pix Copia e Cola e QR Code no catálogo público com cálculo de distância e Correios — você nunca é obrigado a ativar se preferir vender sem Pix.
                    </div>
                </div>
            </label>

            <!-- Modo de Recebimento Pix na Vitrine (Pix Direto 0% vs Mercado Pago Automático) -->
            <div style="background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.95rem; display: flex; flex-direction: column; gap: 0.7rem;">
                <div style="font-weight: 800; font-size: 0.9rem; color: var(--adm-text);">
                    ⚡ Como deseja confirmar os pagamentos Pix das vendas na vitrine?
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0.65rem;">
                    <label style="display: flex; align-items: flex-start; gap: 0.55rem; padding: 0.75rem; border-radius: 8px; border: 1.5px solid @(_pixGatewayMode == "DirectPix" ? "var(--adm-accent)" : "var(--adm-border)"); background: var(--adm-surface-subtle); cursor: pointer;">
                        <input type="radio" name="pixGatewayMode" value="DirectPix"
                               checked="@(_pixGatewayMode == "DirectPix")"
                               @onchange="@(() => _pixGatewayMode = "DirectPix")" />
                        <div>
                            <div style="font-weight: 700; font-size: 0.86rem; color: var(--adm-text);">🆓 Pix Direto (Taxa 0%)</div>
                            <div style="font-size: 0.76rem; color: var(--adm-muted); line-height: 1.4;">
                                Dinheiro cai direto na sua chave Pix sem intermediários. Você confere no banco e clica em confirmar no app.
                            </div>
                        </div>
                    </label>
                    <label style="display: flex; align-items: flex-start; gap: 0.55rem; padding: 0.75rem; border-radius: 8px; border: 1.5px solid @(_pixGatewayMode == "MercadoPago" ? "#16A34A" : "var(--adm-border)"); background: var(--adm-surface-subtle); cursor: pointer;">
                        <input type="radio" name="pixGatewayMode" value="MercadoPago"
                               checked="@(_pixGatewayMode == "MercadoPago")"
                               @onchange="@(() => _pixGatewayMode = "MercadoPago")" />
                        <div>
                            <div style="font-weight: 700; font-size: 0.86rem; color: var(--adm-text);">⚡ Pix Automático — Mercado Pago</div>
                            <div style="font-size: 0.76rem; color: var(--adm-muted); line-height: 1.4;">
                                Confirmação na hora (~0,99% por venda aprovada no Pix do Mercado Pago), sem precisar atualizar ou conferir comprovante!
                            </div>
                        </div>
                    </label>
                </div>

                @if (_pixGatewayMode == "MercadoPago" || _hasMercadoPagoConnected)
                {
                    <div style="padding: 0.78rem 0.9rem; border-radius: 8px; border: 1px dashed @(_hasMercadoPagoConnected ? "#16A34A" : "var(--adm-accent)"); background: var(--adm-bg); display: flex; flex-direction: column; gap: 0.55rem;">
                        @if (_hasMercadoPagoConnected)
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                <span style="font-weight: 700; font-size: 0.84rem; color: var(--adm-success);">
                                    ✓ Conta Mercado Pago conectada@(!string.IsNullOrWhiteSpace(_mpAccountLabel) ? $": {_mpAccountLabel}" : string.Empty)
                                </span>
                                <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
                                    <button type="button" class="adm-btn adm-btn-outline" disabled="@_mpBusy" @onclick="RefreshMercadoPagoStatusAsync">
                                        @(_mpBusy ? "..." : "🔄 Atualizar Status")
                                    </button>
                                    <button type="button" class="adm-btn adm-btn-outline" disabled="@_mpBusy" @onclick="DisconnectMercadoPagoAsync">
                                        ✕ Desconectar
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div style="font-size: 0.8rem; color: var(--adm-muted); line-height: 1.42;">
                                Sem criar chave de API nem configurar nada: clique abaixo, entre na sua conta Mercado Pago e autorize o recebimento em segundos.
                            </div>
                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                                <button type="button" class="adm-btn adm-btn-success" disabled="@_mpBusy" @onclick="ConnectMercadoPagoOneClickAsync">
                                    @(_mpBusy ? "⏳ Abrindo Mercado Pago..." : "🔗 Conectar Mercado Pago (1 Clique)")
                                </button>
                                <button type="button" class="adm-btn adm-btn-outline" disabled="@_mpBusy" @onclick="RefreshMercadoPagoStatusAsync">
                                    🔄 Já autorizei no navegador
                                </button>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_mpFeedback))
                        {
                            <div style="font-size: 0.78rem; font-weight: 600; color: @(_mpFeedbackOk ? "var(--adm-success)" : "var(--adm-danger)");">
                                @_mpFeedback
                            </div>
                        }
                    </div>
                }
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem;">
                <div>
                    <label class="adm-label">
                        @(_pixGatewayMode == "MercadoPago" && _hasMercadoPagoConnected
                            ? "Chave Pix Reserva da Loja (Opcional com Mercado Pago)"
                            : "Sua Chave Pix para Receber Vendas *")
                    </label>
                    <input type="text" class="adm-input" @bind="_storePixKey" @bind:event="oninput"
                           placeholder="CPF, E-mail, +55 Celular ou Chave Aleatória" />
                    <span style="font-size: 0.74rem; color: @(ClothingStore.Shared.Helpers.PixPayloadBuilder.IsValidPixKey(_storePixKey) ? "var(--adm-success)" : "var(--adm-muted)");">
                        Tipo detectado: <strong>@ClothingStore.Shared.Helpers.PixPayloadBuilder.DetectKeyTypeLabel(_storePixKey)</strong>
                    </span>
                </div>

                <div>
                    <label class="adm-label">Nome do Recebedor no Pix (Opcional)</label>
                    <input type="text" class="adm-input" @bind="_storePixReceiverName"
                           placeholder="Ex.: Seu Nome ou Nome da Loja" />
                </div>
            </div>

            <!-- Opcionais recolhidos: CEP de Origem, Limite de Distância e Simulador Correios -->
            <details style="background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.85rem 1rem;">
                <summary style="cursor: pointer; font-weight: 700; font-size: 0.88rem; color: var(--adm-text); user-select: none;">
                    📍 CEP de Origem, Limite de Distância &amp; Frete Correios (Opcional)
                </summary>
                <div style="margin-top: 0.9rem; display: flex; flex-direction: column; gap: 0.85rem;">
                    <!-- CEP de Origem do Vendedor -->
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.75rem; align-items: end;">
                        <div>
                            <label class="adm-label">Seu CEP de Origem (Ponto de Partida) *</label>
                            <div style="display: flex; gap: 0.4rem;">
                                <input type="text" class="adm-input" @bind="_originCep" placeholder="01310-100" />
                                <button type="button" class="adm-btn adm-btn-outline" style="white-space: nowrap;" disabled="@_lookingUpCep" @onclick="LookupOriginCepAsync">
                                    @(_lookingUpCep ? "..." : "🔍 Buscar")
                                </button>
                            </div>
                        </div>
                        <div>
                            <label class="adm-label">Sua Cidade</label>
                            <input type="text" class="adm-input" @bind="_originCity" placeholder="São Paulo" />
                        </div>
                        <div>
                            <label class="adm-label">Seu Estado (UF)</label>
                            <input type="text" maxlength="2" class="adm-input" style="text-transform: uppercase;" @bind="_originState" placeholder="SP" />
                        </div>
                    </div>

                    <!-- Escolha de Distância / Alcance do Vendedor -->
                    <div style="background: var(--adm-surface); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.9rem;">
                        <div style="font-weight: 800; font-size: 0.9rem; margin-bottom: 0.6rem; color: var(--adm-text);">
                            📍 Até onde você aceita mandar os itens da sua distância?
                        </div>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(195px, 1fr)); gap: 0.75rem;">
                            <div>
                                <label class="adm-label">Área de Entrega</label>
                                <select class="adm-select" @bind="_deliveryScopeMode">
                                    <option value="@ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.AllBrazil">Todo o Brasil</option>
                                    <option value="@ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.SameState">Apenas no Mesmo Estado (UF)</option>
                                    <option value="@ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.SameCity">Apenas na Mesma Cidade</option>
                                    <option value="@ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.RadiusKm">Limitar por Distância Exata (km)</option>
                                </select>
                            </div>
                            <div>
                                <label class="adm-label">Distância Máxima em KM (0 = sem limite)</label>
                                <input type="number" min="0" max="5000" class="adm-input" @bind="_maxDeliveryDistanceKm" />
                                <div style="display: flex; gap: 0.3rem; flex-wrap: wrap; margin-top: 0.35rem;">
                                    @foreach (var kmPreset in new[] { 15, 30, 50, 150, 500, 0 })
                                    {
                                        <button type="button" class="pill-badge pill-slate" style="border: none; cursor: pointer;"
                                                @onclick="() => SetDistancePreset(kmPreset)">
                                            @(kmPreset == 0 ? "Sem limite km" : $"{kmPreset} km")
                                        </button>
                                    }
                                </div>
                            </div>
                            <div>
                                <label class="adm-label">Peso Médio por Produto (g)</label>
                                <input type="number" min="100" max="30000" class="adm-input" @bind="_defaultPackageWeightGrams" />
                                <span style="font-size: 0.72rem; color: var(--adm-muted);">Usado na estimativa dos Correios (padrão 450 g).</span>
                            </div>
                        </div>
                    </div>

                    <div style="border-top: 1px solid var(--adm-border); padding-top: 0.7rem; display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap; font-size: 0.82rem; color: var(--adm-muted);">
                        <span>📦 Precisa simular o frete PAC/SEDEX de um pedido para um cliente? Use o simulador direto na tela de <strong>Pedidos</strong>.</span>
                        <a href="/pedidos" class="adm-btn adm-btn-outline" style="font-size: 0.78rem; padding: 0.35rem 0.75rem;">
                            📦 Abrir Pedidos &amp; Simulador Correios
                        </a>
                    </div>
                </div>
            </details>

            <div style="display: flex; gap: 0.65rem; flex-wrap: wrap; align-items: center;">
                <button type="button" class="adm-btn adm-btn-success" style="font-weight: 800; padding: 0.7rem 1.2rem;" disabled="@_savingPixShipping" @onclick="SavePixAndShippingSettingsAsync">
                    @(_savingPixShipping ? "Salvando..." : "💾 Salvar Formas de Venda, Pix & Entrega")
                </button>
                <a href="/vendas" class="adm-btn adm-btn-outline">💰 Ir para Vendas</a>
                <a href="/estoque" class="adm-btn adm-btn-outline">📦 Movimentar Estoque</a>
            </div>
        </div>
    }
</section>
</div>

<!-- ====================================================================== -->
<!-- ABA 4: PLANO & GIFT CARD (Status do Plano, Resgate e Verificação VIP)  -->
<!-- ====================================================================== -->
<div style="@(_activeSettingsTab == "plano" ? string.Empty : "display: none;")">
<section class="adm-card" style="border-left: 4px solid var(--brand-accent, #B69158);">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
        <div>
            <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--brand-accent, #B69158);">
                Licença &amp; Gift Card
            </div>
            <h2 style="font-size: 1.2rem; font-weight: 700; margin: 0.25rem 0 0; color: var(--adm-text);">
                🎁 Resgatar Código Gift Card do Plano
            </h2>
            <p style="font-size: 0.85rem; color: var(--adm-muted); margin: 0.25rem 0 0;">
                Digite o código Gift Card recebido para ativar ou renovar seu plano <strong>Básico</strong>, <strong>Intermediário (3 Temas)</strong> ou <strong>Premium (10 Temas + Estúdio Visual)</strong>.
            </p>
        </div>

        @{
            var activePlanTier = PlanCheckoutGuardHelper.ResolveActivePlanTier(
                _planTier,
                _planActivatedAt,
                _planExpiresAt,
                _activeGiftCardCode);
            var hasBasicActive = string.Equals(activePlanTier, StoreDesignPresets.PlanBasic, StringComparison.OrdinalIgnoreCase);
            var isPlanExpired = PlanCheckoutGuardHelper.IsPlanExpired(_planExpiresAt);
        }
        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem;">
            <span class="pill-badge @(BrandState.IsPremiumPlan ? "pill-gold" : BrandState.IsIntermediatePlan ? "pill-green" : "pill-slate")">
                @(BrandState.IsPremiumPlan ? "✦ Plano Premium Ativo" : BrandState.IsIntermediatePlan ? "◈ Meia Versão (3 Temas)" : hasBasicActive ? "● Plano Básico Minimalista" : isPlanExpired ? "⚠ Plano Expirado" : "Sem Plano Ativo")
            </span>
            <span style="font-size: 0.78rem; color: var(--adm-muted);">
                @if (activePlanTier is null && !_planExpiresAt.HasValue)
                {
                    <span>Status: <strong>Nenhum plano contratado</strong></span>
                }
                else if (!_planExpiresAt.HasValue)
                {
                    <span>Validade: <strong>Vitalício / Contínuo</strong></span>
                }
                else if (!isPlanExpired)
                {
                    <span>Válido até: <strong>@_planExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></span>
                }
                else
                {
                    <span style="color: var(--adm-danger);">Licença expirada em @_planExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                }
            </span>
            @if (!string.IsNullOrWhiteSpace(_activeGiftCardCode))
            {
                <span style="font-size: 0.74rem; color: var(--adm-muted); font-family: monospace;">
                    Último Gift Card: @_activeGiftCardCode
                </span>
            }
        </div>
    </div>

    <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1rem;">
        <input type="text"
               class="adm-input"
               style="flex: 1; min-width: 220px; text-transform: uppercase; font-family: monospace; letter-spacing: 0.08em; font-weight: 700;"
               @bind="_giftCardCodeInput"
               placeholder="Ex.: LUXO-INTR-30D-A7K2B9C4 ou LUXO-PREM-..." />
        <button type="button"
                class="adm-btn adm-btn-accent"
                style="white-space: nowrap; font-weight: 700;"
                disabled="@(_isRedeemingGiftCard || _isCheckingCloudVip)"
                @onclick="RedeemGiftCardAsync">
            @(_isRedeemingGiftCard ? "Ativando..." : "🎁 Ativar Código Gift Card")
        </button>
        <button type="button"
                class="adm-btn"
                style="white-space: nowrap; font-weight: 700;"
                disabled="@(_isRedeemingGiftCard || _isCheckingCloudVip)"
                @onclick="VerifyCloudVipNowAsync">
            @(_isCheckingCloudVip ? "Verificando..." : "🔄 Verificar VIP Agora")
        </button>
        <a href="/planos" class="adm-btn adm-btn-outline" style="white-space: nowrap;">
            💎 Ver Todos os Planos &rarr;
        </a>
    </div>
</section>
</div>

@code {
    private string _activeSettingsTab = "loja";
    private string _planTier = StoreDesignPresets.PlanBasic;
    private DateTimeOffset? _planActivatedAt;
    private DateTimeOffset? _planExpiresAt;
    private string? _activeGiftCardCode;
    private string _giftCardCodeInput = string.Empty;
    private bool _isRedeemingGiftCard;
    private bool _isCheckingCloudVip;
    private decimal _basicPlanPrice = 49.90m;
    private decimal _intermediaryPlanPrice = 89.90m;
    private decimal _premiumPlanPrice = 129.90m;
    private StoreDesignDto _designDraft = StoreDesignDto.CreateMinimalistaLuxo();
    private bool _savingDesign;

    private UpdateStoreSettingsRequest _form = new()
    {
        StoreName = "Minha Loja",
        StoreSlug = "minha-loja",
        WhatsappNumber = "5511900000000",
        StoreDescription = "Catálogo digital oficial da loja.",
        DefaultLowStockThreshold = 3,
        AutoSyncOnlineOnSave = true
    };

    private bool _autoSyncSlugWithName = true;
    private bool _isCheckingRenderLink;
    private RenderStoreLinkAvailabilityDto? _renderLinkCheck;
    private string? _verifiedWhatsappNumber;
    private string? _pendingWhatsappVerificationCode;
    private string? _pendingWhatsappNormalizedTarget;
    private string _whatsappVerificationCodeInput = string.Empty;
    private string? _whatsappAuthFeedback;
    private bool _whatsappAuthFeedbackOk;
    private string? _error;
    private string? _success;

    // Hospedagem Central
    private string _serverHostingMode = "PlatformShared";
    private string _centralCatalogServerUrlInput = string.Empty;
    private bool _publishingOneClick;
    private bool _publishWizardSuccess;
    private string? _publishWizardMessage;

    protected override async Task OnInitializedAsync()
    {
        Theme.OnThemeChanged += StateHasChanged;
        CloudSync.OnSyncStatusChanged += StateHasChanged;
        Gateway.PlanEntitlementActivated += OnPlanEntitlementActivated;
        Gateway.AuthStateChanged += OnGatewayAuthStateChanged;
        await Gateway.TrySyncCentralCatalogUrlFromAdminAsync();
        await LoadSettingsAsync();
    }

    private void OnGatewayAuthStateChanged()
    {
        if (Gateway.IsAuthenticated)
        {
            _ = InvokeAsync(() => LoadSettingsCoreAsync(refreshCloud: false));
        }
    }

    private void OnPlanEntitlementActivated(AdminStoreSettingsDto updated)
    {
        _ = InvokeAsync(() =>
        {
            ApplyPlanStateFromSettings(updated);
            StateHasChanged();
        });
    }

    private void ChangeTheme(string preference)
    {
        Theme.SetThemePreference(preference);
    }

    private Task LoadSettingsAsync() => LoadSettingsCoreAsync(refreshCloud: true);

    private async Task LoadSettingsCoreAsync(bool refreshCloud)
    {
        _error = null;
        try
        {
            if (refreshCloud && Gateway.IsAuthenticated)
            {
                await Gateway.RefreshPlanFromCentralCloudBestEffortAsync(forceRefresh: false);
            }

            var current = await Gateway.GetStoreSettingsAsync();
            _form = new UpdateStoreSettingsRequest
            {
                StoreName = current.StoreName,
                StoreSlug = current.StoreSlug,
                WhatsappNumber = current.WhatsappNumber,
                StoreDescription = current.StoreDescription,
                LogoPublicUrl = current.LogoPublicUrl,
                DefaultLowStockThreshold = current.DefaultLowStockThreshold,
                OnlineBaseUrl = string.IsNullOrWhiteSpace(current.OnlineBaseUrl)
                    ? Gateway.GetPublicPortalBaseUrl()
                    : current.OnlineBaseUrl,
                AutoSyncOnlineOnSave = current.AutoSyncOnlineOnSave,
                LastOnlineSyncAt = current.LastOnlineSyncAt,
                IsSiteActive = current.IsSiteActive,
                DeactivationReason = current.DeactivationReason,
                LastActivityAt = current.LastActivityAt,
                PublishedStoreName = current.PublishedStoreName,
                PlanTier = current.PlanTier,
                ManualSalesEnabled = current.ManualSalesEnabled
            };
            _basicPlanPrice = current.BasicPlanMonthlyPrice;
            _intermediaryPlanPrice = current.IntermediaryPlanMonthlyPrice;
            _premiumPlanPrice = current.PremiumPlanMonthlyPrice;
            ApplyPlanStateFromSettings(current);
            ApplyHostingAndGoogleFields(current);
            LoadVerifiedWhatsappState();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ApplyPlanStateFromSettings(AdminStoreSettingsDto updated)
    {
        _planTier = updated.PlanTier;
