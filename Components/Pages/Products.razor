@page "/produtos"
@inject MauiAdminGateway Gateway
@inject NavigationManager Navigation

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="font-size: 1.65rem; font-weight: 700; margin: 0;">Gerenciamento de Produtos</h1>
        <p style="color: var(--adm-muted); font-size: 0.92rem; margin: 0.25rem 0 0;">
            Cadastre produtos, edite informações, gerencie fotografias, variações de cor/tamanho/opção e controle a visibilidade no site público.
        </p>
    </div>

    @if (Gateway.CanManageProducts)
    {
        <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
            <button type="button" class="adm-btn adm-btn-outline" @onclick="ToggleNewCategoryModal">
                + Nova Categoria
            </button>
            <button type="button" class="adm-btn adm-btn-primary" @onclick="OpenNewProductModal">
                + Novo Produto
            </button>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert-banner alert-error">@_error</div>
}

@if (!string.IsNullOrWhiteSpace(_success))
{
    <div class="alert-banner alert-success">@_success</div>
}

<!-- Formulário Rápido de Nova Categoria -->
@if (_showNewCategoryModal && Gateway.CanManageProducts)
{
    <div class="adm-card" style="border-left: 4px solid var(--adm-primary);">
        <h3 style="margin-top: 0; font-size: 1.05rem;">Cadastrar Nova Categoria</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 1rem; align-items: end;">
            <div>
                <label class="adm-label">Nome da Categoria *</label>
                <input type="text" class="adm-input" @bind="_newCategory.Name" placeholder="Ex.: Eletrônicos, Casa, Cosméticos, Moda..." />
            </div>
            <div>
                <label class="adm-label">Descrição</label>
                <input type="text" class="adm-input" @bind="_newCategory.Description" placeholder="Descrição opcional" />
            </div>
            <div>
                <label class="adm-label">Ordem de Exibição</label>
                <input type="number" class="adm-input" @bind="_newCategory.DisplayOrder" />
            </div>
            <div style="display: flex; gap: 0.5rem;">
                <button type="button" class="adm-btn adm-btn-success" @onclick="CreateCategoryAsync">Salvar Categoria</button>
                <button type="button" class="adm-btn adm-btn-outline" @onclick="() => _showNewCategoryModal = false">Cancelar</button>
            </div>
        </div>
    </div>
}

<!-- Aviso automático para unir produtos duplicados com mesmo nome -->
@if (HasDuplicateNamedProducts && Gateway.CanManageProducts)
{
    <div class="adm-card" style="border-left: 4px solid var(--adm-accent); display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <div style="font-size: 0.88rem; color: var(--adm-text);">
            <strong>🔗 Produtos com o mesmo nome detectados:</strong> você possui itens repetidos na mesma categoria. Clique ao lado para juntar todas as cores, tamanhos, estoques e fotos em um único produto.
        </div>
        <button type="button" class="adm-btn adm-btn-accent" style="white-space: nowrap; font-weight: 700;" @onclick="MergeDuplicatesAsync">
            🔗 Unir Produtos Duplicados
        </button>
    </div>
}

<!-- Formulário de Edição Completa do Produto (com Variantes de Cor/Tamanho/Estoque dentro do Produto) -->
@if (_editingProductId.HasValue && Gateway.CanManageProducts)
{
    <div class="adm-card" style="border-left: 4px solid var(--adm-primary); background: var(--adm-input-bg);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem; flex-wrap: wrap; gap: 0.5rem;">
            <h3 style="margin: 0; font-size: 1.08rem;">✏️ Editar Produto &amp; Variantes: @_editProductForm.Name</h3>
            <a href="/produtos/@_editingProductId.Value" class="adm-btn adm-btn-outline" style="padding: 0.35rem 0.75rem; font-size: 0.82rem;">
                📷 Gerenciar Fotos do Produto &rarr;
            </a>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 1rem;">
            <div>
                <label class="adm-label">Nome do Produto *</label>
                <input type="text" class="adm-input" @bind="_editProductForm.Name" placeholder="Nome do produto" />
            </div>

            <div>
                <label class="adm-label">Categoria *</label>
                <select class="adm-select" @bind="_editProductCategorySelection">
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id.ToString()">@cat.Name</option>
                    }
                    <option value="__NEW__">+ Digitar nova categoria...</option>
                </select>
                @if (_editProductCategorySelection == "__NEW__" || _categories.Count == 0)
                {
                    <input type="text"
                           class="adm-input"
                           style="margin-top: 0.45rem;"
                           @bind="_editProductForm.CategoryName"
                           placeholder="Digite o nome da nova categoria..." />
                }
            </div>

            <div>
                <label class="adm-label">Preço de Venda (R$) *</label>
                <input type="number" step="0.01" class="adm-input" @bind="_editProductForm.BasePrice" />
            </div>

            <div style="grid-column: 1 / -1;">
                <label class="adm-label">Descrição do Produto</label>
                <textarea class="adm-textarea" rows="2" @bind="_editProductForm.Description" placeholder="Características, medidas, especificações e detalhes..."></textarea>
            </div>

            <div style="grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;">
                    <input type="checkbox" @bind="_editProductForm.IsVisibleOnSite" />
                    <span>Exibir no site público</span>
                </label>

                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <button type="button" class="adm-btn adm-btn-success" @onclick="SaveQuickEditProductAsync">
                        💾 Salvar Dados do Produto
                    </button>
                    <button type="button" class="adm-btn adm-btn-outline" @onclick="CancelQuickEditProduct">
                        Fechar
                    </button>
                </div>
            </div>
        </div>

        <!-- Variantes (Cor/Modelo + Tamanho/Opção + Quantidade) diretamente dentro do produto -->
        @if (_editingProductDetail is not null)
        {
            <div style="margin-top: 1.15rem; padding-top: 1rem; border-top: 1px solid var(--adm-border);">
                <div style="font-weight: 800; font-size: 0.95rem; margin-bottom: 0.65rem; color: var(--adm-text);">
                    🎨 Variantes deste Produto (Cor/Modelo, Tamanho/Opção e Quantidade por combinação)
                </div>

                <div style="background: var(--adm-surface); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.85rem; margin-bottom: 0.85rem;">
                    <div style="font-size: 0.82rem; font-weight: 700; margin-bottom: 0.55rem; color: var(--adm-muted);">
                        @(_inlineEditingVariantId.HasValue ? "✏️ Editando variante selecionada" : "+ Adicionar nova Cor / Modelo / Tamanho neste produto")
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 135px), 1fr)); gap: 0.6rem; align-items: end;">
                        <div>
                            <label class="adm-label">Cor / Modelo</label>
                            <input type="text"
                                   class="adm-input"
                                   @bind="_inlineVariantForm.Color"
                                   @bind:event="oninput"
                                   @bind:after="OnInlineVariantColorChanged"
                                   placeholder="Ex.: Preta, Branca..." />
                        </div>
                        <div>
                            <label class="adm-label">Cor (Visual)</label>
                            <input type="color" class="adm-input" style="height: 38px; padding: 0.2rem;" @bind="_inlineVariantForm.ColorHex" />
                        </div>
                        <div>
                            <label class="adm-label">Tamanho / Opção</label>
                            <input type="text" class="adm-input" @bind="_inlineVariantForm.Size" placeholder="Ex.: P, M, G, GG, 100ml..." />
                        </div>
                        <div>
                            <label class="adm-label">Quantidade (un.)</label>
                            <input type="number" min="0" class="adm-input" @bind="_inlineVariantForm.InitialStockQuantity" />
                        </div>
                        <div style="display: flex; gap: 0.4rem;">
                            <button type="button" class="adm-btn adm-btn-success" style="flex: 1;" @onclick="SaveInlineVariantAsync">
                                @(_inlineEditingVariantId.HasValue ? "✓ Atualizar" : "+ Adicionar")
                            </button>
                            @if (_inlineEditingVariantId.HasValue)
                            {
                                <button type="button" class="adm-btn adm-btn-outline" @onclick="CancelInlineVariantEdit">Cancelar</button>
                            }
                        </div>
                    </div>
                </div>

                @if (_editingProductDetail.Variants.Count == 0)
                {
                    <div style="font-size: 0.84rem; color: var(--adm-muted); padding: 0.5rem 0;">
                        Nenhuma variante cadastrada ainda. Adicione acima a cor/modelo, tamanho e quantidade.
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 0.45rem;">
                        @foreach (var v in _editingProductDetail.Variants)
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.6rem; flex-wrap: wrap; padding: 0.55rem 0.75rem; background: var(--adm-surface); border: 1px solid var(--adm-border); border-radius: 8px;">
                                <div style="display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap;">
                                    <span style="width: 14px; height: 14px; border-radius: 50%; background: @v.ColorHex; border: 1px solid rgba(0,0,0,0.25); display: inline-block;"></span>
                                    <strong>@v.Color</strong>
                                    <span style="color: var(--adm-muted);">/</span>
                                    <span class="pill-badge pill-slate">@v.Size</span>
                                    <span class="pill-badge @(v.StockQuantity > 0 ? "pill-green" : "pill-red")">@v.StockQuantity un.</span>
                                </div>
                                <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                                    @if (Gateway.CanManageStock)
                                    {
                                        <button type="button" class="adm-btn adm-btn-outline" style="padding: 0.2rem 0.5rem; font-size: 0.78rem;" disabled="@(v.StockQuantity <= 0)" @onclick='() => QuickMoveInlineVariantAsync(v, "OUT", 1)'>−1</button>
                                        <button type="button" class="adm-btn adm-btn-outline" style="padding: 0.2rem 0.5rem; font-size: 0.78rem;" @onclick='() => QuickMoveInlineVariantAsync(v, "IN", 1)'>+1</button>
                                    }
                                    <button type="button" class="adm-btn adm-btn-outline" style="padding: 0.2rem 0.55rem; font-size: 0.78rem;" @onclick="() => StartInlineVariantEdit(v)">✏️ Editar</button>
                                    <button type="button" class="adm-btn adm-btn-danger" style="padding: 0.2rem 0.55rem; font-size: 0.78rem;" @onclick="() => DeleteInlineVariantAsync(v)">🗑️</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<!-- Formulário de Novo Produto (com Grade de Variantes Cor/Tamanho/Quantidade integrada) -->
@if (_showNewProductModal && Gateway.CanManageProducts)
{
    var matchingExistingProduct = FindMatchingExistingProductForNewForm();
    <div class="adm-card" style="border-left: 4px solid var(--adm-success);">
        <h3 style="margin-top: 0; font-size: 1.05rem;">Cadastrar Novo Produto</h3>
        @if (matchingExistingProduct is not null)
        {
            <div style="margin-bottom: 0.85rem; padding: 0.65rem 0.85rem; border-radius: 8px; background: rgba(22, 163, 74, 0.1); border: 1px solid var(--adm-success); font-size: 0.84rem; color: var(--adm-text);">
                ✓ O produto <strong>@matchingExistingProduct.Name</strong> já existe nesta categoria: ao salvar, os modelos/tamanhos abaixo serão <strong>adicionados dentro dele</strong> (sem criar produto duplicado!).
            </div>
        }
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 1rem;">
            <div>
                <label class="adm-label">Nome do Produto *</label>
                <input type="text" class="adm-input" @bind="_newProduct.Name" @bind:event="oninput" placeholder="Ex.: Camisa social, Fone Bluetooth, Kit..." />
            </div>

            <div>
                <label class="adm-label">Categoria *</label>
                <select class="adm-select" @bind="_newProductCategorySelection">
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id.ToString()">@cat.Name</option>
                    }
                    <option value="__NEW__">+ Digitar nova categoria...</option>
                </select>
                @if (_newProductCategorySelection == "__NEW__" || _categories.Count == 0)
                {
                    <input type="text"
                           class="adm-input"
                           style="margin-top: 0.45rem;"
                           @bind="_newProduct.CategoryName"
                           placeholder="Digite o nome da nova categoria (ex.: Camisas, Acessórios...)..." />
                }
            </div>

            <div>
                <label class="adm-label">Preço de Venda (R$) *</label>
                <input type="number" step="0.01" class="adm-input" @bind="_newProduct.BasePrice" />
            </div>

            <!-- Grade de Variantes dentro do cadastro de produto -->
            <div style="grid-column: 1 / -1; background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.9rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.65rem;">
                    <div>
                        <strong style="font-size: 0.9rem; color: var(--adm-text);">🎨 Modelos / Cores, Tamanhos e Quantidade em Estoque</strong>
                        <div style="font-size: 0.78rem; color: var(--adm-muted);">Adicione quantas combinações de cor e tamanho quiser para este mesmo produto.</div>
                    </div>
                    <button type="button" class="adm-btn adm-btn-outline" style="font-size: 0.8rem; padding: 0.35rem 0.75rem;" @onclick="AddNewProductVariantRow">
                        + Adicionar outra Cor / Tamanho
                    </button>
                </div>

                <div style="display: flex; flex-direction: column; gap: 0.55rem;">
                    @for (var i = 0; i < _newProductVariants.Count; i++)
                    {
                        var row = _newProductVariants[i];
                        var rowIndex = i;
                        <div style="display: grid; grid-template-columns: minmax(110px, 1.4fr) 52px minmax(100px, 1.1fr) minmax(90px, 0.8fr) auto; gap: 0.5rem; align-items: end;">
                            <div>
                                @if (rowIndex == 0) { <label class="adm-label">Cor / Modelo</label> }
                                <input type="text"
                                       class="adm-input"
                                       @bind="row.Color"
                                       @bind:event="oninput"
                                       @bind:after="() => OnNewVariantRowColorChanged(row)"
                                       placeholder="Ex.: Preta, Branca" />
                            </div>
                            <div>
                                @if (rowIndex == 0) { <label class="adm-label">Cor</label> }
                                <input type="color" class="adm-input" style="height: 38px; padding: 0.15rem;" @bind="row.ColorHex" />
                            </div>
                            <div>
                                @if (rowIndex == 0) { <label class="adm-label">Tamanho / Opção</label> }
                                <input type="text" class="adm-input" @bind="row.Size" placeholder="Ex.: P, M, G, GG" />
                            </div>
                            <div>
                                @if (rowIndex == 0) { <label class="adm-label">Qtd. (un.)</label> }
                                <input type="number" min="0" class="adm-input" @bind="row.InitialStockQuantity" />
                            </div>
                            <div>
                                @if (_newProductVariants.Count > 1)
                                {
                                    <button type="button" class="adm-btn adm-btn-danger" style="padding: 0.45rem 0.65rem;" title="Remover linha" @onclick="() => RemoveNewProductVariantRow(rowIndex)">✕</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div style="grid-column: 1 / -1;">
                <label class="adm-label">Descrição do Produto</label>
                <textarea class="adm-textarea" rows="2" @bind="_newProduct.Description" placeholder="Características, medidas, especificações e detalhes..."></textarea>
            </div>

            <div style="grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;">
                    <input type="checkbox" @bind="_newProduct.IsVisibleOnSite" />
                    <span>Exibir imediatamente no site público</span>
                </label>

                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <button type="button" class="adm-btn adm-btn-success" disabled="@_isSavingProduct" @onclick="() => CreateProductAsync(openDetailsAfterCreate: false)">
                        @(_isSavingProduct ? "⏳ Salvando..." : "💾 Salvar Produto")
                    </button>
                    <button type="button" class="adm-btn adm-btn-primary" disabled="@_isSavingProduct" @onclick="() => CreateProductAsync(openDetailsAfterCreate: true)">
                        @(_isSavingProduct ? "⏳ Salvando..." : "Salvar e Adicionar Fotos →")
                    </button>
                    <button type="button" class="adm-btn adm-btn-outline" disabled="@_isSavingProduct" @onclick="() => _showNewProductModal = false">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Barra de Busca e Filtros -->
@if (_categories.Count == 0 && Gateway.CanManageProducts && !_showNewCategoryModal && !_showNewProductModal)
{
    <div class="adm-card" style="border-left: 4px solid var(--adm-accent); display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <div style="font-size: 0.88rem; color: var(--adm-text);">
            <strong>Suas Categorias:</strong> Nenhuma categoria cadastrada ainda. Crie suas próprias categorias de loja para organizar seus produtos.
        </div>
        <button type="button" class="adm-btn adm-btn-accent" style="padding: 0.4rem 0.85rem; font-size: 0.82rem;" @onclick="ToggleNewCategoryModal">
            + Criar Primeira Categoria
        </button>
    </div>
}
else if (_categories.Count > 0)
{
    <div style="display: flex; gap: 0.45rem; flex-wrap: wrap; align-items: center; margin-bottom: 0.75rem;">
        <span style="font-size: 0.78rem; font-weight: 700; color: var(--adm-muted);">Suas Categorias:</span>
        @foreach (var cat in _categories)
        {
            <button type="button"
                    class="pill-badge @(_selectedCategoryId == cat.Id.ToString() ? "pill-gold" : "pill-slate")"
                    style="border: none; cursor: pointer;"
                    @onclick="async () => { _selectedCategoryId = _selectedCategoryId == cat.Id.ToString() ? string.Empty : cat.Id.ToString(); await LoadProductsAsync(); }">
                @cat.Name (@cat.ProductCount)
            </button>
        }
    </div>
}

<div class="adm-card" style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
    <div style="flex: 1 1 200px; min-width: 0;">
        <input type="text"
               class="adm-input"
               placeholder="Pesquisar por nome do produto, descrição ou código SKU..."
               @bind="_search"
               @bind:event="oninput"
               @bind:after="LoadProductsAsync" />
    </div>

    <div style="flex: 1 1 180px; min-width: 0;">
        <select class="adm-select" @bind="_selectedCategoryId" @bind:after="LoadProductsAsync">
            <option value="">Todas as categorias</option>
            @foreach (var cat in _categories)
            {
                <option value="@cat.Id.ToString()">@cat.Name (@cat.ProductCount)</option>
            }
        </select>
    </div>

    <button type="button" class="adm-btn adm-btn-outline" style="flex: 0 0 auto;" @onclick="LoadProductsAsync">Filtrar</button>
</div>

<!-- Tabela de Produtos -->
<div class="adm-card" style="overflow-x: auto;">
    <table class="adm-table">
        <thead>
            <tr>
                <th>Foto</th>
                <th>Produto</th>
                <th>Categoria</th>
                <th>Preço</th>
                <th>Variantes</th>
                <th>Estoque Total</th>
                <th>Visível no Site</th>
                <th style="text-align: right;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (_products.Count == 0)
            {
                <tr>
                    <td colspan="8" style="text-align: center; padding: 2rem; color: var(--adm-muted);">
                        Nenhum produto cadastrado ainda. Clique em <strong>+ Novo Produto</strong> acima para adicionar o primeiro item.
                    </td>
                </tr>
            }
            @foreach (var prod in _products)
            {
                var coverUrl = prod.Images.FirstOrDefault()?.PublicUrl;
                <tr>
                    <td data-label="Foto">
                        @if (!string.IsNullOrWhiteSpace(coverUrl))
                        {
                            <img src="@WhatsAppLinkBuilder.SanitizeMediaUrl(coverUrl)" alt="@prod.Name" referrerpolicy="no-referrer" style="width: 56px; height: 56px; object-fit: contain; background: var(--adm-input-bg); border-radius: 8px; border: 1px solid var(--adm-border);" />
                        }
                        else
                        {
                            <div style="width: 56px; height: 56px; background: var(--adm-input-bg); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 600; color: var(--adm-muted);">
                                Sem foto
                            </div>
                        }
                    </td>
                    <td data-label="Produto">
                        <div>
                            <div style="font-weight: 800; font-size: 1rem;">@prod.Name</div>
                            <div style="font-size: 0.78rem; color: var(--adm-muted);">/@prod.Slug</div>
                        </div>
                    </td>
                    <td data-label="Categoria">
                        <span class="pill-badge pill-slate">@prod.CategoryName</span>
                    </td>
                    <td data-label="Preço" style="font-weight: 800; font-size: 1rem;">
                        @prod.BasePrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                    </td>
                    <td data-label="Variantes">
                        <span class="pill-badge pill-slate">@prod.Variants.Count var.</span>
                    </td>
                    <td data-label="Estoque Total">
                        <div style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
                            @if (prod.TotalStockQuantity > 0)
                            {
                                <span class="pill-badge pill-green">@prod.TotalStockQuantity un.</span>
                            }
                            else
                            {
                                <span class="pill-badge pill-red">0 un. (Esgotado)</span>
                            }
                            @if (Gateway.CanManageStock && prod.Variants.Count == 1)
                            {
                                var singleVar = prod.Variants[0];
                                <button type="button"
                                        class="adm-btn adm-btn-danger"
                                        style="padding: 0.2rem 0.5rem; font-size: 0.78rem; min-height: 28px;"
                                        disabled="@(singleVar.StockQuantity <= 0)"
                                        title="Baixar 1 unidade"
                                        @onclick='() => QuickMoveSingleVariantAsync(prod, singleVar, "OUT", 1)'>
                                    −1
                                </button>
                                <button type="button"
                                        class="adm-btn adm-btn-success"
                                        style="padding: 0.2rem 0.5rem; font-size: 0.78rem; min-height: 28px;"
                                        title="Somar 1 unidade"
                                        @onclick='() => QuickMoveSingleVariantAsync(prod, singleVar, "IN", 1)'>
                                    +1
                                </button>
                            }
                            else if (Gateway.CanManageStock && prod.Variants.Count > 1)
                            {
                                <a href="/estoque?productId=@prod.Id"
                                   class="pill-badge pill-blue"
                                   style="text-decoration: none; font-size: 0.74rem;">
                                    📦 Movimentar
                                </a>
                            }
                        </div>
                    </td>
                    <td data-label="No Site">
                        @if (Gateway.CanManageProducts)
                        {
                            <button type="button"
                                    class="adm-btn @(prod.IsVisibleOnSite ? "adm-btn-success" : "adm-btn-outline")"
                                    style="padding: 0.35rem 0.75rem; min-height: 36px; font-size: 0.78rem;"
                                    @onclick="() => ToggleVisibilityAsync(prod)">
                                @(prod.IsVisibleOnSite ? "Visível no Site" : "Oculto no Site")
                            </button>
                        }
                        else
                        {
                            <span>@(prod.IsVisibleOnSite ? "Sim" : "Não")</span>
                        }
                    </td>
                    <td data-label="Ações">
                        <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: flex-end; width: 100%;">
                            @if (Gateway.CanManageProducts)
                            {
                                <button type="button"
                                        class="adm-btn adm-btn-outline"
                                        style="padding: 0.45rem 0.75rem; min-height: 38px; font-size: 0.82rem; flex: 1;"
                                        @onclick="() => StartQuickEditProduct(prod)">
                                    ✏️ Editar Item
                                </button>
                            }
                            <a href="/produtos/@prod.Id"
                               class="adm-btn adm-btn-primary"
                               style="padding: 0.45rem 0.75rem; min-height: 38px; font-size: 0.82rem; flex: 1;">
                                📷 Fotos &amp; Variantes
                            </a>
                            @if (Gateway.CanManageProducts)
                            {
                                <button type="button"
                                        class="adm-btn adm-btn-danger"
                                        style="padding: 0.45rem 0.7rem; min-height: 38px; font-size: 0.82rem;"
                                        @onclick="() => DeleteProductAsync(prod)">
                                    🗑️ Excluir
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private IReadOnlyList<CategoryDto> _categories = [];
    private IReadOnlyList<ProductDetailDto> _products = [];
    private string? _search;
    private string? _selectedCategoryId;

    private bool _showNewCategoryModal;
    private bool _showNewProductModal;
    private bool _isSavingProduct;
    private SaveCategoryRequest _newCategory = new() { DisplayOrder = 1, IsActive = true };
    private SaveProductRequest _newProduct = new() { BasePrice = 149.90m, IsVisibleOnSite = true, InitialStockQuantity = 5 };
    private List<SaveProductVariantRequest> _newProductVariants = [new SaveProductVariantRequest { Color = "", ColorHex = "#18181B", Size = "", InitialStockQuantity = 5, LowStockThreshold = 3 }];
    private string _newProductCategorySelection = string.Empty;

    private Guid? _editingProductId;
    private ProductDetailDto? _editingProductDetail;
    private SaveProductRequest _editProductForm = new();
    private string _editProductCategorySelection = string.Empty;
    private Guid? _inlineEditingVariantId;
    private SaveProductVariantRequest _inlineVariantForm = new() { ColorHex = "#18181B", InitialStockQuantity = 5, LowStockThreshold = 3 };

    private bool HasDuplicateNamedProducts =>
        _products
            .GroupBy(p => $"{p.CategoryId:N}|{p.Name.Trim().ToLowerInvariant()}")
            .Any(g => g.Count() > 1);

    private string? _error;
    private string? _success;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAndProductsAsync();
    }

    private void ToggleNewCategoryModal()
    {
        _showNewCategoryModal = !_showNewCategoryModal;
        if (_showNewCategoryModal)
        {
            _newCategory = new SaveCategoryRequest
            {
                DisplayOrder = _categories.Count + 1,
                IsActive = true
            };
        }
    }

    private void OpenNewProductModal()
    {
        _showNewProductModal = !_showNewProductModal;
        if (_showNewProductModal)
        {
            _editingProductId = null;
            _editingProductDetail = null;
            _newProductVariants = [new SaveProductVariantRequest { Color = "", ColorHex = "#18181B", Size = "", InitialStockQuantity = 5, LowStockThreshold = 3 }];
            EnsureDefaultCategoryForNewProduct();
        }
    }

    private void AddNewProductVariantRow()
    {
        var last = _newProductVariants.LastOrDefault();
        _newProductVariants.Add(new SaveProductVariantRequest
        {
            Color = last?.Color ?? string.Empty,
            ColorHex = last?.ColorHex ?? "#18181B",
            Size = string.Empty,
            InitialStockQuantity = last?.InitialStockQuantity > 0 ? last.InitialStockQuantity : 5,
            LowStockThreshold = 3
        });
    }

    private void RemoveNewProductVariantRow(int index)
    {
        if (index >= 0 && index < _newProductVariants.Count && _newProductVariants.Count > 1)
        {
            _newProductVariants.RemoveAt(index);
        }
    }

    private static void OnNewVariantRowColorChanged(SaveProductVariantRequest row)
    {
        if (!string.IsNullOrWhiteSpace(row.Color))
        {
            row.ColorHex = ClothingStore.Domain.Entities.ProductVariant.ResolveDefaultColorHex(row.Color);
        }
    }

    private void OnInlineVariantColorChanged()
    {
        if (!string.IsNullOrWhiteSpace(_inlineVariantForm.Color))
        {
            _inlineVariantForm.ColorHex = ClothingStore.Domain.Entities.ProductVariant.ResolveDefaultColorHex(_inlineVariantForm.Color);
        }
    }

    private ProductDetailDto? FindMatchingExistingProductForNewForm()
    {
        var trimmed = (_newProduct.Name ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
            return null;

        Guid? selectedCatId = Guid.TryParse(_newProductCategorySelection, out var parsed) ? parsed : null;
        return _products.FirstOrDefault(p =>
            string.Equals(p.Name.Trim(), trimmed, StringComparison.OrdinalIgnoreCase) &&
            (!selectedCatId.HasValue || p.CategoryId == selectedCatId.Value));
    }

    private async Task MergeDuplicatesAsync()
    {
        _error = null;
        _success = null;
        try
        {
            var merged = await Gateway.MergeDuplicateProductsByNameAsync();
            await LoadCategoriesAndProductsAsync();
            _success = merged > 0
                ? $"✓ {merged} produto(s) duplicado(s) unificado(s) com sucesso! Todas as cores, tamanhos e estoques agora estão juntos."
                : "Nenhum produto duplicado encontrado.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void EnsureDefaultCategoryForNewProduct()
    {
        if (_categories.Count > 0)
        {
            if (string.IsNullOrWhiteSpace(_newProductCategorySelection) ||
                (_newProductCategorySelection != "__NEW__" && !_categories.Any(c => c.Id.ToString() == _newProductCategorySelection)))
            {
                _newProductCategorySelection = _categories[0].Id.ToString();
            }
            if (Guid.TryParse(_newProductCategorySelection, out var g))
            {
                _newProduct.CategoryId = g;
            }
        }
        else
        {
            _newProductCategorySelection = "__NEW__";
        }
    }

    private async Task LoadCategoriesAndProductsAsync()
    {
        _error = null;
        try
        {
            _categories = await Gateway.GetCategoriesAsync();
            EnsureDefaultCategoryForNewProduct();
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            Guid? catGuid = Guid.TryParse(_selectedCategoryId, out var parsed) ? parsed : null;
            _products = await Gateway.GetProductsAsync(_search, catGuid);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateCategoryAsync()
    {
        _error = null;
        _success = null;
        try
        {
            var created = await Gateway.CreateCategoryAsync(_newCategory);
            _showNewCategoryModal = false;
            _newCategory = new SaveCategoryRequest { DisplayOrder = _categories.Count + 2, IsActive = true };
            await LoadCategoriesAndProductsAsync();
            _newProductCategorySelection = created.Id.ToString();
            _newProduct.CategoryId = created.Id;
            _newProduct.CategoryName = null;
            _success = $"Categoria '{created.Name}' criada com sucesso!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateProductAsync(bool openDetailsAfterCreate)
    {
        if (_isSavingProduct)
            return;

        _isSavingProduct = true;
        _error = null;
        _success = null;
        try
        {
            if (_newProductCategorySelection == "__NEW__" || _categories.Count == 0)
            {
                _newProduct.CategoryId = Guid.Empty;
                if (string.IsNullOrWhiteSpace(_newProduct.CategoryName))
                {
                    _error = "Digite o nome da nova categoria ou selecione uma categoria existente.";
                    return;
                }
            }
            else if (Guid.TryParse(_newProductCategorySelection, out var selectedCatId))
            {
                _newProduct.CategoryId = selectedCatId;
                _newProduct.CategoryName = null;
            }
            else if (_categories.Count > 0)
            {
                _newProduct.CategoryId = _categories[0].Id;
                _newProduct.CategoryName = null;
            }

            var preparedVariants = _newProductVariants
                .Where(v => !string.IsNullOrWhiteSpace(v.Color) || !string.IsNullOrWhiteSpace(v.Size) || v.InitialStockQuantity > 0)
                .Select(v => new SaveProductVariantRequest
                {
                    Color = string.IsNullOrWhiteSpace(v.Color) ? "Padrão" : v.Color.Trim(),
                    ColorHex = string.IsNullOrWhiteSpace(v.ColorHex)
                        ? ClothingStore.Domain.Entities.ProductVariant.ResolveDefaultColorHex(v.Color)
                        : v.ColorHex,
                    Size = string.IsNullOrWhiteSpace(v.Size) ? "Único" : v.Size.Trim(),
                    InitialStockQuantity = Math.Max(0, v.InitialStockQuantity),
                    LowStockThreshold = 3,
                    IsActive = true
                })
                .ToList();

            if (preparedVariants.Count == 0)
            {
                preparedVariants.Add(new SaveProductVariantRequest
                {
                    Color = "Padrão",
                    ColorHex = "#18181B",
                    Size = "Único",
                    InitialStockQuantity = Math.Max(0, _newProduct.InitialStockQuantity),
                    LowStockThreshold = 3,
                    IsActive = true
                });
            }

            _newProduct.InitialVariants = preparedVariants;
            _newProduct.InitialColor = preparedVariants[0].Color;
            _newProduct.InitialSize = preparedVariants[0].Size;
            _newProduct.InitialStockQuantity = preparedVariants[0].InitialStockQuantity;

            var existedBefore = FindMatchingExistingProductForNewForm() is not null;
            var created = await Gateway.CreateProductAsync(_newProduct);
            _showNewProductModal = false;
            _newProduct = new SaveProductRequest
            {
                CategoryId = created.CategoryId,
                BasePrice = 149.90m,
                IsVisibleOnSite = true,
                InitialStockQuantity = 5
            };
            _newProductVariants = [new SaveProductVariantRequest { Color = "", ColorHex = "#18181B", Size = "", InitialStockQuantity = 5, LowStockThreshold = 3 }];
            _newProductCategorySelection = created.CategoryId.ToString();

            if (openDetailsAfterCreate)
            {
                Navigation.NavigateTo($"/produtos/{created.Id}");
                return;
            }

            await LoadCategoriesAndProductsAsync();
            _success = existedBefore
                ? $"✓ Novas variantes adicionadas dentro de '{created.Name}' (total: {created.Variants.Count} variante(s), {created.TotalStockQuantity} un.)!"
                : $"✓ Produto '{created.Name}' cadastrado com {created.Variants.Count} variante(s) ({created.TotalStockQuantity} un.)!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSavingProduct = false;
        }
    }

    private void StartQuickEditProduct(ProductDetailDto prod)
    {
        _error = null;
        _success = null;
        _showNewProductModal = false;
        _editingProductId = prod.Id;
        _editingProductDetail = prod;
        _inlineEditingVariantId = null;
        _inlineVariantForm = new SaveProductVariantRequest { ColorHex = "#18181B", InitialStockQuantity = 5, LowStockThreshold = 3 };
        _editProductCategorySelection = prod.CategoryId.ToString();
        _editProductForm = new SaveProductRequest
        {
            CategoryId = prod.CategoryId,
            Name = prod.Name,
            Description = prod.Description,
            BasePrice = prod.BasePrice,
            IsVisibleOnSite = prod.IsVisibleOnSite
        };
    }

    private void CancelQuickEditProduct()
    {
        _editingProductId = null;
        _editingProductDetail = null;
        _inlineEditingVariantId = null;
        _editProductForm = new SaveProductRequest();
    }

    private async Task RefreshEditingProductDetailAsync()
    {
        if (_editingProductId.HasValue)
        {
            _editingProductDetail = await Gateway.GetProductByIdAsync(_editingProductId.Value);
        }
        await LoadProductsAsync();
    }

    private void StartInlineVariantEdit(ProductVariantDto v)
    {
        _inlineEditingVariantId = v.Id;
        _inlineVariantForm = new SaveProductVariantRequest
        {
            Color = v.Color,
            ColorHex = v.ColorHex,
            Size = v.Size,
            CustomSku = v.Sku,
            InitialStockQuantity = v.StockQuantity,
            LowStockThreshold = v.LowStockThreshold,
            IsActive = v.IsActive
        };
    }

    private void CancelInlineVariantEdit()
    {
        _inlineEditingVariantId = null;
        _inlineVariantForm = new SaveProductVariantRequest { ColorHex = "#18181B", InitialStockQuantity = 5, LowStockThreshold = 3 };
    }

    private async Task SaveInlineVariantAsync()
    {
        if (!_editingProductId.HasValue)
            return;

        _error = null;
        _success = null;
        try
        {
            var req = new SaveProductVariantRequest
            {
                Color = string.IsNullOrWhiteSpace(_inlineVariantForm.Color) ? "Padrão" : _inlineVariantForm.Color.Trim(),
                ColorHex = string.IsNullOrWhiteSpace(_inlineVariantForm.ColorHex)
                    ? ClothingStore.Domain.Entities.ProductVariant.ResolveDefaultColorHex(_inlineVariantForm.Color)
                    : _inlineVariantForm.ColorHex,
                Size = string.IsNullOrWhiteSpace(_inlineVariantForm.Size) ? "Único" : _inlineVariantForm.Size.Trim(),
                CustomSku = _inlineVariantForm.CustomSku,
                InitialStockQuantity = Math.Max(0, _inlineVariantForm.InitialStockQuantity),
                UpdateStockQuantity = _inlineEditingVariantId.HasValue,
                LowStockThreshold = _inlineVariantForm.LowStockThreshold > 0 ? _inlineVariantForm.LowStockThreshold : 3,
                IsActive = true
            };

            if (_inlineEditingVariantId.HasValue)
            {
                await Gateway.UpdateVariantAsync(_inlineEditingVariantId.Value, req);
                _success = $"✓ Variante {req.Color} / {req.Size} atualizada ({req.InitialStockQuantity} un.)!";
            }
            else
            {
                await Gateway.AddVariantAsync(_editingProductId.Value, req);
                _success = $"✓ Variante {req.Color} / {req.Size} ({req.InitialStockQuantity} un.) adicionada ao produto!";
            }

            CancelInlineVariantEdit();
            await RefreshEditingProductDetailAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task QuickMoveInlineVariantAsync(ProductVariantDto variant, string movementType, int quantity)
    {
        _error = null;
        _success = null;
        try
        {
            var mov = await Gateway.RegisterStockMovementAsync(new CreateStockMovementRequest
            {
                ProductVariantId = variant.Id,
                MovementType = movementType,
                Quantity = quantity,
                Reason = movementType == "OUT" ? "Saída rápida no produto" : "Entrada rápida no produto"
            });
            await RefreshEditingProductDetailAsync();
            _success = $"✓ Estoque de {variant.Color} / {variant.Size}: {mov.PreviousQuantity} → {mov.NewQuantity} un.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteInlineVariantAsync(ProductVariantDto variant)
    {
        _error = null;
        _success = null;
        try
        {
            await Gateway.DeleteVariantAsync(variant.Id);
            if (_inlineEditingVariantId == variant.Id)
            {
                CancelInlineVariantEdit();
            }
            await RefreshEditingProductDetailAsync();
            _success = $"Variante {variant.Color} / {variant.Size} removida.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SaveQuickEditProductAsync()
    {
        if (!_editingProductId.HasValue)
            return;

        _error = null;
        _success = null;
        try
        {
            if (_editProductCategorySelection == "__NEW__" || _categories.Count == 0)
            {
                _editProductForm.CategoryId = Guid.Empty;
                if (string.IsNullOrWhiteSpace(_editProductForm.CategoryName))
                {
                    _error = "Digite o nome da nova categoria ou selecione uma categoria existente.";
                    return;
                }
            }
            else if (Guid.TryParse(_editProductCategorySelection, out var selectedCatId))
            {
                _editProductForm.CategoryId = selectedCatId;
                _editProductForm.CategoryName = null;
            }

            var updated = await Gateway.UpdateProductAsync(_editingProductId.Value, _editProductForm);
            _editingProductDetail = updated;
            await LoadCategoriesAndProductsAsync();
            _success = $"✓ Dados de '{updated.Name}' atualizados com sucesso!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task QuickMoveSingleVariantAsync(ProductDetailDto prod, ProductVariantDto variant, string movementType, int quantity)
    {
        _error = null;
        _success = null;
        try
        {
            var mov = await Gateway.RegisterStockMovementAsync(new CreateStockMovementRequest
            {
                ProductVariantId = variant.Id,
                MovementType = movementType,
                Quantity = quantity,
                Reason = movementType == "OUT" ? "Saída rápida na lista" : "Entrada rápida na lista"
            });
            await LoadProductsAsync();
            _success = $"✓ Estoque de '{prod.Name}' ({variant.Color}/{variant.Size}) atualizado: {mov.PreviousQuantity} → {mov.NewQuantity} un.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ToggleVisibilityAsync(ProductDetailDto prod)
    {
        _error = null;
        _success = null;
        try
        {
            await Gateway.ToggleProductVisibilityAsync(prod.Id, !prod.IsVisibleOnSite);
            await LoadProductsAsync();
            _success = $"Visibilidade de '{prod.Name}' atualizada no catálogo público.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteProductAsync(ProductDetailDto prod)
    {
        _error = null;
        _success = null;
        try
        {
            await Gateway.DeleteOrArchiveProductAsync(prod.Id);
            if (_editingProductId == prod.Id)
            {
                _editingProductId = null;
            }
            await LoadCategoriesAndProductsAsync();
            _success = $"Produto '{prod.Name}' arquivado/removido com sucesso.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
