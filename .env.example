# =============================================================================
# Variáveis de Ambiente — YouLink (API / Vitrine Blazor / Banco / Pagamentos)
# Copie este arquivo para .env apenas em ambiente local e nunca versione segredos reais
# =============================================================================

# Portal Central multi-loja na rota / (opcional: true para portal + /downloads + vitrines /loja/{slug})
YOULINK_PORTAL_HOME=true

# Banco PostgreSQL gerenciado (recomendado: Neon.tech para persistência entre redeploys no Render)
YOULINK_DATABASE_URL=postgres://usuario:senha@ep-seu-banco.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Segredo administrativo para publicação e sincronização (CloudPublishWizard / Render)
YOULINK_SYNC_SECRET=gere-uma-chave-forte-aqui

# Chave fixa (base64/texto) para criptografia dos tokens OAuth de lojistas entre redeploys
YOULINK_TOKEN_ENCRYPTION_KEY=

# Assinatura JWT (local/dev fallback)
JWT_SECRET_KEY=SubstituaPorUmaChaveSecretaForteEmProducao_2026!

# Mercado Pago (OAuth 1-clique das lojas + Checkout de planos + Webhook)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_PLATFORM_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Opcional: Storage de mídias no Supabase (quando não usar armazenamento local/PostgreSQL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=clothing-images

# URLs locais para desenvolvimento (API + Site Vitrine)
API_BASE_URL=http://localhost:5180
PUBLIC_API_BASE_URL=http://localhost:5180

# Porta HTTP da API (ex.: 5180 local ou 10000 no Render Free)
PORT=5180

