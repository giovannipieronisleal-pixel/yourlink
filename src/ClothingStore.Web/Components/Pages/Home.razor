@page "/"
@page "/loja/{StoreSlug}"
@inject CatalogDataGateway CatalogDataGateway
@inject PlatformPortalService PortalService
@inject NavigationManager Navigation

<PageTitle>@(_isPortalHome ? "YouLink — Crie sua Loja Online, Baixe o App e Venda pelo WhatsApp e Pix" : $"{(_store?.StoreName ?? "Loja Online")} — Catálogo de Produtos")</PageTitle>

@if (!_loading && _isPortalHome)
{
    <HeadContent>
        <meta name="description" content="Crie sua loja online em minutos, controle estoque e receba pedidos pelo WhatsApp e Pix com o aplicativo gratuito YouLink para Windows e Android." />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="YouLink" />
        <meta property="og:title" content="YouLink — Crie sua Loja Online e Venda pelo WhatsApp e Pix" />
        <meta property="og:description" content="Baixe grátis no Windows ou Android, cadastre produtos com fotos e variações e publique sua vitrine 24h em 1 clique." />
        <meta property="og:url" content="@CanonicalPageUrl" />
        <meta property="og:image" content="@($"{PublicBaseUrl}/icons/icon-512.png")" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="canonical" href="@CanonicalPageUrl" />
    </HeadContent>
}
else if (!_loading && !_storeNotFound && _store is { IsSiteActive: true })
{
    <HeadContent>
        <meta name="description" content="@StoreMetaDescription" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="@_store.StoreName" />
        <meta property="og:title" content="@($"{_store.StoreName} — Catálogo Online")" />
        <meta property="og:description" content="@StoreMetaDescription" />
        <meta property="og:url" content="@CanonicalPageUrl" />
        <meta property="og:image" content="@StoreOgImageUrl" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="canonical" href="@CanonicalPageUrl" />
    </HeadContent>
}

@if (_loading)
{
    <div class="lux-empty-card">
        <p class="lux-hero-eyebrow">@(_isPortalHome ? "YouLink" : "Carregando Loja")</p>
        <h2>Preparando as novidades para você...</h2>
    </div>
}
else if (_isPortalHome)
{
    <PlatformPortalView />
}
else if (_storeNotFound)
{
    <section class="lux-empty-card">
        <span class="lux-hero-eyebrow">Endereço Não Encontrado</span>
        <h1 class="lux-hero-title">Loja não encontrada</h1>
        <p class="lux-hero-subtitle" style="margin-left: auto; margin-right: auto;">
            Nenhuma vitrine publicada foi encontrada para <strong>/loja/@StoreSlug</strong>. Confira o link recebido ou peça o endereço atualizado ao lojista.
        </p>
    </section>
}
else if (_store is { IsSiteActive: false })
{
    <section class="lux-empty-card">
        <span class="lux-hero-eyebrow">Loja em Atualização</span>
        <h1 class="lux-hero-title">@_store.StoreName</h1>
        <p class="lux-hero-subtitle" style="margin-left: auto; margin-right: auto;">
            @(_store.DeactivationReason ?? "Estamos atualizando nossa vitrine com novos produtos. Você já pode falar direto com nossa equipe pelo WhatsApp!")
        </p>

        @if (CatalogFeatureFlags.PhoneFeaturesEnabled && !string.IsNullOrWhiteSpace(_store.WhatsappNumber))
        {
            <a href="@WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName)"
               target="_blank"
               rel="noopener noreferrer"
               class="lux-btn lux-btn-whatsapp">
                💬 Falar com a Loja no WhatsApp
            </a>
        }
    </section>
}
else
{
    <section class="lux-hero @HeroVariantClass">
        <div class="lux-hero-copy">
            @if (_design.ShowLookbookBadge && !string.IsNullOrWhiteSpace(_design.HeroEyebrow))
            {
                <span class="lux-hero-eyebrow">@HeroEyebrowText</span>
            }

            <h1 class="lux-hero-title">@HeroHeadlineText</h1>

            @if (!string.IsNullOrWhiteSpace(_store?.StoreDescription))
            {
                <p class="lux-hero-subtitle">@_store.StoreDescription</p>
            }
        </div>

        <div class="lux-hero-side">
            <form class="lux-quick-search" @onsubmit="GoSearch" @onsubmit:preventDefault="true">
                <input type="text"
                       class="lux-input"
                       placeholder="Buscar produto..."
                       aria-label="Buscar produto"
                       @bind="_quickSearch" />
                <button type="submit" class="lux-btn lux-btn-primary">
                    Buscar
                </button>
            </form>

            <div class="lux-hero-actions">
                <a href="@CatalogHref()" class="lux-btn lux-btn-outline lux-btn-sm">Ver Catálogo</a>

                @if (CatalogFeatureFlags.PhoneFeaturesEnabled && _store is not null && !string.IsNullOrWhiteSpace(_store.WhatsappNumber))
                {
                    <a href="@WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName)"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="lux-btn lux-btn-whatsapp lux-btn-sm">
                        💬 WhatsApp
                    </a>
                }
            </div>
        </div>
    </section>

    @if (_categories.Count > 0)
    {
        <div class="lux-category-rail lux-home-cat-rail" aria-label="Categorias da loja">
            <a href="@CatalogHref()" class="lux-category-pill active">
                <span>Todos</span>
            </a>
            @foreach (var cat in _categories)
            {
                <a href="@CatalogHref(cat.Slug)" class="lux-category-pill">
                    <span>@cat.Name</span>
                    <span class="lux-category-count">@cat.ProductCount</span>
                </a>
            }
        </div>
    }

    <section class="lux-section lux-section-tight">
        <div class="lux-section-head">
            <h2 class="lux-section-title">Produtos</h2>
            <a href="@CatalogHref()" class="lux-link-arrow">Ver tudo &rarr;</a>
        </div>

        @if (_featuredProducts.Count == 0)
        {
            <div class="lux-empty-card">
                <h3>Em breve novos produtos!</h3>
                <p class="lux-hero-subtitle" style="margin-left: auto; margin-right: auto;">
                    Novos produtos estão sendo preparados. Fale com nossa equipe no WhatsApp para saber o que acaba de chegar.
                </p>
            </div>
        }
        else
        {
            <div class="lux-product-grid">
                @for (var i = 0; i < _featuredProducts.Count; i++)
                {
                    <ProductCard Product="@_featuredProducts[i]" StoreSlug="@EffectiveStoreSlug" IsAboveFold="@(i < 3)" />
                }
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public string? StoreSlug { get; set; }

    private PublicStoreSettingsDto? _store;
    private StoreDesignDto _design = StoreDesignDto.CreateMinimalistaLuxo();
    private IReadOnlyList<CategoryDto> _categories = [];
    private IReadOnlyList<CatalogProductCardDto> _featuredProducts = [];
    private bool _loading = true;
    private bool _isPortalHome;
    private bool _storeNotFound;
    private string? _quickSearch;

    private string? EffectiveStoreSlug =>
        !string.IsNullOrWhiteSpace(StoreSlug) ? StoreSlug : _store?.StoreSlug;

    private string HeroVariantClass => _design.HeroLayout switch
    {
        "centered" => "lux-hero-centered",
        "banner" => "lux-hero-banner",
        _ => "lux-hero-split"
    };

    private string HeroEyebrowText =>
        !string.IsNullOrWhiteSpace(_design.HeroEyebrow)
            ? _design.HeroEyebrow
            : "Novidades Disponíveis";

    private string HeroHeadlineText =>
        !string.IsNullOrWhiteSpace(_design.HeroHeadline)
            ? _design.HeroHeadline
            : (_store?.StoreName ?? "Catálogo Online");

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _isPortalHome = false;
        _storeNotFound = false;
        try
        {
            if (await PortalService.IsPortalHomeAsync(StoreSlug))
            {
                _isPortalHome = true;
                return;
            }

            _store = await CatalogDataGateway.GetStoreInfoOrNullAsync(StoreSlug);
            if (!string.IsNullOrWhiteSpace(StoreSlug) && _store is null)
            {
                _storeNotFound = true;
                return;
            }

            _store ??= await CatalogDataGateway.GetStoreInfoAsync(StoreSlug);
            _design = StoreDesignCssHelper.Sanitize(_store?.Design);

            if (_store?.IsSiteActive != false)
            {
                _categories = await CatalogDataGateway.GetCategoriesAsync(StoreSlug);
                var products = await CatalogDataGateway.GetProductsAsync(new CatalogQueryFilter(), StoreSlug);
                _featuredProducts = products.Take(12).ToList();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoSearch()
    {
        var basePath = CatalogHref();
        if (string.IsNullOrWhiteSpace(_quickSearch))
        {
            Navigation.NavigateTo(basePath);
            return;
        }
        Navigation.NavigateTo($"{basePath}?busca={Uri.EscapeDataString(_quickSearch.Trim())}");
    }

    private string CatalogHref(string? categorySlug = null)
    {
        var basePath = string.IsNullOrWhiteSpace(EffectiveStoreSlug)
            ? "/catalogo"
            : $"/loja/{EffectiveStoreSlug}/catalogo";

        return string.IsNullOrWhiteSpace(categorySlug)
            ? basePath
            : $"{basePath}?categoria={Uri.EscapeDataString(categorySlug)}";
    }

    private string PublicBaseUrl => Navigation.BaseUri.TrimEnd('/');

    private string CanonicalPageUrl =>
        Navigation.Uri.Split(['?', '#'], 2)[0];

    private string StoreMetaDescription
    {
        get
        {
            var raw = !string.IsNullOrWhiteSpace(_store?.StoreDescription)
                ? _store!.StoreDescription
                : $"Confira os produtos da {_store?.StoreName ?? "Loja Online"} e peça direto pelo WhatsApp ou Pix.";
            var clean = string.Join(' ', raw.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
            return clean.Length > 155 ? clean[..152].TrimEnd() + "..." : clean;
        }
    }

    private string StoreOgImageUrl
    {
        get
        {
            var logo = WhatsAppLinkBuilder.SanitizeMediaUrl(_store?.LogoPublicUrl);
            if (logo.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
                logo.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
            {
                return logo;
            }
            if (logo.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase))
            {
                return $"{PublicBaseUrl}{logo}";
            }

            var firstWithImg = _featuredProducts.FirstOrDefault(p => WhatsAppLinkBuilder.IsSafeMediaUrl(p.PrimaryImageUrl));
            if (firstWithImg is not null)
            {
                var prodImg = WhatsAppLinkBuilder.SanitizeMediaUrl(firstWithImg.PrimaryImageUrl);
                if (prodImg.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
                    prodImg.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
                {
                    return prodImg;
                }
                if (prodImg.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase))
                {
                    return $"{PublicBaseUrl}{prodImg}";
                }

                var prefix = string.IsNullOrWhiteSpace(EffectiveStoreSlug)
                    ? string.Empty
                    : $"/loja/{Uri.EscapeDataString(EffectiveStoreSlug)}";
                return $"{PublicBaseUrl}{prefix}/media/product/{firstWithImg.Id:D}";
            }

            return $"{PublicBaseUrl}/icons/icon-512.png";
        }
    }
}
