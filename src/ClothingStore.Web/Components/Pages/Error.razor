@page "/Error"
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Erro inesperado — YouLink</PageTitle>

<section class="lux-empty-card" style="max-width: 620px; margin: 2rem auto;">
    <span class="lux-hero-eyebrow">Ops! Algo não saiu como esperado</span>
    <h1 class="lux-hero-title">Não foi possível concluir esta página agora</h1>
    <p class="lux-hero-subtitle" style="margin-left: auto; margin-right: auto;">
        Ocorreu uma instabilidade temporária ao carregar esta solicitação. Tente atualizar a página ou voltar ao início.
    </p>
    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="lux-btn lux-btn-primary">← Voltar ao Início</a>
        <a href="/como-instalar" class="lux-btn lux-btn-outline">📲 Ajuda / Como Instalar</a>
    </div>
</section>
