@page "/catalogo"
@page "/loja/{StoreSlug}/catalogo"
@inject CatalogDataGateway CatalogDataGateway
@inject NavigationManager Navigation

<PageTitle>Catálogo — @(_store?.StoreName ?? "YouLink Loja")</PageTitle>

@if (!_storeNotFound && _store is { IsSiteActive: true })
{
    <HeadContent>
        <meta name="description" content="@CatalogMetaDescription" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="@_store.StoreName" />
        <meta property="og:title" content="@($"Catálogo — {_store.StoreName}")" />
        <meta property="og:description" content="@CatalogMetaDescription" />
        <meta property="og:url" content="@CanonicalPageUrl" />
        <link rel="canonical" href="@CanonicalPageUrl" />
    </HeadContent>
}

@if (_storeNotFound)
{
    <section class="lux-empty-card">
        <span class="lux-hero-eyebrow">Endereço Não Encontrado</span>
        <h1 class="lux-hero-title">Loja não encontrada</h1>
        <p class="lux-hero-subtitle" style="margin-left: auto; margin-right: auto;">
            Nenhuma vitrine ativa encontrada em <strong>/loja/@StoreSlug</strong>.
        </p>
    </section>
}
else if (_store is { IsSiteActive: false })
{
    <section class="lux-empty-card">
        <span class="lux-hero-eyebrow">Loja em Atualização</span>
        <h1 class="lux-hero-title">@_store.StoreName</h1>
        <p class="lux-hero-subtitle" style="margin-left: auto; margin-right: auto;">
            @(_store.DeactivationReason ?? "Este catálogo está sendo atualizado com novidades.")
        </p>
        @if (CatalogFeatureFlags.PhoneFeaturesEnabled && !string.IsNullOrWhiteSpace(_store.WhatsappNumber))
        {
            <a href="@WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName)"
               target="_blank"
               rel="noopener noreferrer"
               class="lux-btn lux-btn-whatsapp">
                💬 Falar com a Loja no WhatsApp
            </a>
        }
    </section>
}
else
{
    <div class="lux-section-head">
        <h1 class="lux-section-title">@(_store?.StoreName ?? "Catálogo")</h1>
        <span class="lux-product-sizes" style="font-size: 0.9rem; font-weight: 600;">@_products.Count produto(s)</span>
    </div>

    <!-- Barra Única e Limpa: Busca + Botão Filtros (sem barra lateral pesada no PC) -->
    <div class="lux-catalog-toolbar">
        <input id="cat-search"
               class="lux-input lux-toolbar-search"
               placeholder="Buscar produto..."
               aria-label="Buscar produto"
               @bind="_search"
               @bind:event="oninput"
               @bind:after="ApplyFiltersAsync" />

        <button type="button"
                class="lux-btn lux-btn-outline lux-btn-sm"
                aria-expanded="@_showAdvancedFilters"
                @onclick="() => _showAdvancedFilters = !_showAdvancedFilters">
            ⚙️ Filtros@(ActiveExtraFilterCount > 0 ? $" ({ActiveExtraFilterCount})" : string.Empty)
        </button>

        @if (HasAnyActiveFilter)
        {
            <button type="button" class="lux-btn lux-btn-outline lux-btn-sm" @onclick="ClearFiltersAsync">
                Limpar
            </button>
        }
    </div>

    @if (_showAdvancedFilters)
    {
        <div class="lux-filter-drawer" aria-label="Filtros adicionais">
            @if (_filters.Colors.Count > 0)
            {
                <div>
                    <label class="lux-filter-label" for="cat-color">Cor / Modelo</label>
                    <select id="cat-color" class="lux-select" @bind="_selectedColor" @bind:after="ApplyFiltersAsync">
                        <option value="">Todas</option>
                        @foreach (var col in _filters.Colors)
                        {
                            <option value="@col.Color">@col.Color</option>
                        }
                    </select>
                </div>
            }

            @if (_filters.Sizes.Count > 0)
            {
                <div>
                    <label class="lux-filter-label" for="cat-size">Tamanho / Opção</label>
                    <select id="cat-size" class="lux-select" @bind="_selectedSize" @bind:after="ApplyFiltersAsync">
                        <option value="">Todas as opções</option>
                        @foreach (var sz in _filters.Sizes)
                        {
                            <option value="@sz">@sz</option>
                        }
                    </select>
                </div>
            }

            <label class="lux-check-row" style="align-self: end; min-height: 44px;">
                <input type="checkbox" @bind="_onlyInStock" @bind:after="ApplyFiltersAsync" />
                <span>Somente em estoque</span>
            </label>
        </div>
    }

    @if (_filters.Categories.Count > 0)
    {
        <div class="lux-category-rail" style="margin-bottom: 1.5rem;" aria-label="Categorias">
            <button type="button"
                    class="lux-category-pill @(string.IsNullOrWhiteSpace(_selectedCategorySlug) ? "active" : "")"
                    @onclick="() => SelectCategoryAsync(null)">
                Todos
            </button>
            @foreach (var cat in _filters.Categories)
            {
                var isSelected = string.Equals(_selectedCategorySlug, cat.Slug, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="lux-category-pill @(isSelected ? "active" : "")"
                        @onclick="() => SelectCategoryAsync(cat.Slug)">
                    <span>@cat.Name</span>
                    <span class="lux-category-count">@cat.ProductCount</span>
                </button>
            }
        </div>
    }

    <div>
        @if (_loading)
        {
            <div class="lux-empty-card">
                <p>Atualizando produtos...</p>
            </div>
        }
        else if (_products.Count == 0)
        {
            <div class="lux-empty-card">
                <h3>Nenhum produto encontrado</h3>
                <p class="lux-hero-subtitle" style="margin-left: auto; margin-right: auto;">Limpe a busca ou troque de categoria para ver os itens disponíveis.</p>
                <button type="button" class="lux-btn lux-btn-outline" @onclick="ClearFiltersAsync">
                    Ver Todos os Produtos
                </button>
            </div>
        }
        else
        {
            <div class="lux-product-grid">
                @for (var i = 0; i < _products.Count; i++)
                {
                    <ProductCard Product="@_products[i]" StoreSlug="@EffectiveStoreSlug" IsAboveFold="@(i < 4)" />
                }
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public string? StoreSlug { get; set; }

    [SupplyParameterFromQuery(Name = "categoria")]
    public string? QueryCategorySlug { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? QueryCategoryAlt { get; set; }

    [SupplyParameterFromQuery(Name = "busca")]
    public string? QuerySearch { get; set; }

    private PublicStoreSettingsDto? _store;
    private CatalogFiltersDto _filters = new([], [], []);
    private IReadOnlyList<CatalogProductCardDto> _products = [];
    private bool _loading = true;
    private bool _storeNotFound;

    private string? _search;
    private string? _selectedCategorySlug;
    private string? _selectedColor;
    private string? _selectedSize;
    private bool _onlyInStock;
    private bool _showAdvancedFilters;

    private int ActiveExtraFilterCount =>
        (!string.IsNullOrWhiteSpace(_selectedColor) ? 1 : 0) +
        (!string.IsNullOrWhiteSpace(_selectedSize) ? 1 : 0) +
        (_onlyInStock ? 1 : 0);

    private bool HasAnyActiveFilter =>
        !string.IsNullOrWhiteSpace(_search) ||
        !string.IsNullOrWhiteSpace(_selectedCategorySlug) ||
        ActiveExtraFilterCount > 0;

    private string? EffectiveStoreSlug =>
        !string.IsNullOrWhiteSpace(StoreSlug) ? StoreSlug : _store?.StoreSlug;

    protected override async Task OnParametersSetAsync()
    {
        _storeNotFound = false;
        _selectedCategorySlug ??= !string.IsNullOrWhiteSpace(QueryCategorySlug)
            ? QueryCategorySlug
            : QueryCategoryAlt;
        _search ??= QuerySearch;

        _store = await CatalogDataGateway.GetStoreInfoOrNullAsync(StoreSlug);
        if (!string.IsNullOrWhiteSpace(StoreSlug) && _store is null)
        {
            _storeNotFound = true;
            _loading = false;
            return;
        }

        _store ??= await CatalogDataGateway.GetStoreInfoAsync(StoreSlug);
        if (_store?.IsSiteActive == false)
        {
            _loading = false;
            return;
        }

        _filters = await CatalogDataGateway.GetFiltersAsync(StoreSlug);
        await LoadProductsAsync();
    }

    private Task ApplyFiltersAsync() => LoadProductsAsync();

    private Task SelectCategoryAsync(string? categorySlug)
    {
        _selectedCategorySlug = categorySlug;
        return LoadProductsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _search = null;
        _selectedCategorySlug = null;
        _selectedColor = null;
        _selectedSize = null;
        _onlyInStock = false;
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _loading = true;
        try
        {
            var filter = new CatalogQueryFilter(
                Search: string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                CategorySlug: string.IsNullOrWhiteSpace(_selectedCategorySlug) ? null : _selectedCategorySlug.Trim(),
                Color: string.IsNullOrWhiteSpace(_selectedColor) ? null : _selectedColor.Trim(),
                Size: string.IsNullOrWhiteSpace(_selectedSize) ? null : _selectedSize.Trim(),
                OnlyInStock: _onlyInStock);

            _products = await CatalogDataGateway.GetProductsAsync(filter, StoreSlug);
        }
        finally
        {
            _loading = false;
        }
    }

    private string CanonicalPageUrl =>
        Navigation.Uri.Split(['?', '#'], 2)[0];

    private string CatalogMetaDescription
    {
        get
        {
            var raw = !string.IsNullOrWhiteSpace(_store?.StoreDescription)
                ? _store!.StoreDescription
                : $"Explore todos os produtos disponíveis em {_store?.StoreName ?? "YouLink Loja"} e faça seu pedido pelo WhatsApp.";
            var clean = string.Join(' ', raw.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
            return clean.Length > 155 ? clean[..152].TrimEnd() + "..." : clean;
        }
    }
}
